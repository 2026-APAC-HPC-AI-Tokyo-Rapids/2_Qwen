#!/usr/bin/env bash
#PJM -L rscgrp=b-batch
#PJM -L elapse=00:30:00
#PJM -L jobenv=singularity

set -euo pipefail
source "${HOME}/.local/.setenv"
: "${NODE_COUNT:?node count is required}"
: "${RUNTIME_DIR:?runtime directory is required}"
[[ "${NODE_COUNT}" -eq 2 || "${NODE_COUNT}" -eq 4 ]]
module purge
module load intel/2025.1.3 impi
export QWEN_PLATFORM=genkai
export GPUS_PER_NODE=4
exec "${RUNTIME_DIR}/scripts/submit.sbatch"
