#!/usr/bin/env bash
#PJM -L rscgrp=b-batch
#PJM -L elapse=00:20:00
#PJM -L jobenv=singularity

set -euo pipefail
source "${HOME}/.local/.setenv"

: "${NODE_COUNT:?node count is required}"
[[ "${NODE_COUNT}" =~ ^[1-9][0-9]*$ ]]

module purge
module load intel/2025.1.3 impi
mpirun_path="$(command -v mpirun)"
"${mpirun_path}" -np "${NODE_COUNT}" -ppn 1 -genv PATH "${PATH}" "${RUNTIME_DIR}/scripts/run-qwen-check-env.sh"
for ((rank = 0; rank < NODE_COUNT; rank++)); do test -e "${RUNTIME_DIR}/logs/run-success-rank-${rank}"; done
touch "${RUNTIME_DIR}/run-success"
