Bootstrap: docker
From: lmsysorg/sglang@sha256:c190b06bae3c717da83fd0820a704a4875cbf0e7b297f0d1f48b622d080442a6

%files
    patches/sglang /tmp/sglang-patches

%labels
    org.opencontainers.image.title "Source-built SGLang runtime"
    org.opencontainers.image.description "SGLang main with repository patches, built with uv"
    org.opencontainers.image.uv-version "0.11.28"

%post -c /bin/bash
    set -euxo pipefail
    export PATH=/usr/local/bin:${PATH}
    # Start from the runtime image, which excludes the upstream build cache.
    # Install only the tools needed to apply and build our source checkout.
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git patch pkg-config protobuf-compiler
    rm -rf /var/lib/apt/lists/*
    python3 -m pip install --no-cache-dir --force-reinstall "uv==0.11.28"
    uv --version
    export RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
    curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain 1.88.0
    export PATH=/opt/cargo/bin:${PATH}
    rustc --version

    mkdir -p /opt/sglang
    git clone --depth=1 --branch main https://github.com/sgl-project/sglang.git /opt/sglang/source
    shopt -s nullglob
    for patch_file in /tmp/sglang-patches/*.patch
    do
        patch -d /opt/sglang/source -p1 < "${patch_file}"
    done
    git -C /opt/sglang/source rev-parse HEAD > /opt/sglang/sglang-commit.txt

    cd /opt/sglang/source/python
    mkdir -p /opt/sglang/uv-cache
    export UV_CACHE_DIR=/opt/sglang/uv-cache
    uv lock
    uv venv --system-site-packages /opt/sglang/venv
    # Reuse compatible packages exposed by --system-site-packages and let uv
    # add dependencies introduced since the pinned runtime image was built.
    uv pip install --python /opt/sglang/venv/bin/python -e .
    # The base image's system copy otherwise satisfies the unpinned cubin
    # dependency even when flashinfer-python has advanced on master.
    uv pip install --python /opt/sglang/venv/bin/python --upgrade flashinfer-cubin==0.6.14
    /opt/sglang/venv/bin/python -c 'import sglang; print(sglang.__file__)'
    /opt/sglang/venv/bin/python -m compileall -q /opt/sglang/source/python/sglang

    rm -rf /opt/sglang/source/.git /tmp/sglang-patches /opt/sglang/uv-cache \
        /opt/cargo /opt/rustup

%environment
    export PATH=/opt/sglang/venv/bin:/usr/local/bin:${PATH}
    export PIP_DISABLE_PIP_VERSION_CHECK=1

%test
    /opt/sglang/venv/bin/python -c 'import sglang; print(sglang.__file__)'
    uv --version
