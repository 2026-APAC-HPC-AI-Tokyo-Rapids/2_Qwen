Bootstrap: docker
From: lmsysorg/sglang:latest-cu130

%files
    patches/sglang /tmp/sglang-patches

%labels
    org.opencontainers.image.title "Source-built SGLang runtime"
    org.opencontainers.image.description "SGLang main with repository patches, built with uv"
    org.opencontainers.image.uv-version "0.11.28"

%post -c /bin/bash
    set -euxo pipefail
    # The upstream SGLang image already provides the CUDA/PyTorch runtime,
    # build tools, git, patch, and uv.  Remove its transient build cache rather
    # than carrying it into the derived SIF.
    rm -rf /tmp/uv-cache
    test "$(uv --version)" = "uv 0.11.28 (x86_64-unknown-linux-gnu)"

    mkdir -p /opt/sglang
    git clone --depth=1 --branch main https://github.com/sgl-project/sglang.git /opt/sglang/source
    shopt -s nullglob
    for patch_file in /tmp/sglang-patches/*.patch
    do
        patch -d /opt/sglang/source -p1 < "${patch_file}"
    done
    git -C /opt/sglang/source rev-parse HEAD > /opt/sglang/sglang-commit.txt

    cd /opt/sglang/source/python
    mkdir -p /opt/sglang/uv-cache
    export UV_CACHE_DIR=/opt/sglang/uv-cache
    uv lock
    uv venv --system-site-packages /opt/sglang/venv
    # Dependencies are already in the pinned base image.  Installing them a
    # second time would duplicate the CUDA stack and make SquashFS creation
    # exceed the runner's memory limit.
    uv pip install --python /opt/sglang/venv/bin/python --no-deps -e .
    /opt/sglang/venv/bin/python -c 'import sglang; print(sglang.__file__)'
    /opt/sglang/venv/bin/python -m compileall -q /opt/sglang/source/python/sglang

    rm -rf /opt/sglang/source/.git /tmp/sglang-patches /opt/sglang/uv-cache

%environment
    export PATH=/opt/sglang/venv/bin:/usr/local/bin:${PATH}
    export PIP_DISABLE_PIP_VERSION_CHECK=1

%test
    /opt/sglang/venv/bin/python -c 'import sglang; print(sglang.__file__)'
    uv --version
