Bootstrap: docker
From: nvidia/cuda@sha256:5a2d3b02eb7412847d051d0f2b0f0a5031057a0172d9ca78743cc41cfc5d037f

%files
    patches/sglang /opt/sglang-patches
    sglang-source /opt/sglang/source
    containers/apac-manifest.json /opt/apac/manifest.json

%labels
    org.opencontainers.image.title "Source-built SGLang runtime"
    org.opencontainers.image.description "SGLang main built with uv on the upstream CUDA runtime layout"
    org.opencontainers.image.source "https://github.com/2026-APAC-HPC-AI-Tokyo-Rapids/5_SGLang_Src"
    ai.sglang.nccl-tests-source "https://github.com/NVIDIA/nccl-tests"
    ai.sglang.nccl-tests-ref "717b68318278e93f371d8ffb46b076069d7c7851"
    ai.sglang.deepep-commit "9af0e0d0e74f3577af1979c9b9e1ac2cad0104ee"
    ai.sglang.mooncake-version "0.3.11.post1"
    ai.sglang.mscclpp-version "sglang-v0.9.1"

%post -c /bin/bash
    set -euxo pipefail
    export DEBIAN_FRONTEND=noninteractive
    export CUDA_HOME=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:/usr/local/bin:${PATH}
    export TMPDIR=/var/tmp/sglang-build
    mkdir -p "${TMPDIR}"
    mkdir -p /opt/sglang

    # Keep symbols, communication stacks, and the build surface used by GPU JIT.
    # Profilers, debuggers, kernel drivers, and hardware diagnostics stay on the host.
    apt-get update
    apt-get install -y --no-install-recommends --allow-change-held-packages build-essential ca-certificates cmake curl ffmpeg git git-lfs ibverbs-providers libc6-dbg libboost-all-dev libcurl4-openssl-dev libczmq-dev libfabric-dev libgoogle-glog-dev libgrpc++-dev libhiredis-dev libhwloc-dev libibumad3 libibverbs-dev libnccl-dev libnccl2 libnl-3-dev libnl-route-3-dev libnuma-dev libopenmpi-dev libpmix-dev libprotobuf-dev librdmacm-dev libssl-dev libucx-dev libunwind-dev linux-libc-dev ninja-build numactl openmpi-bin patch patchelf perl pkg-config protobuf-compiler protobuf-compiler-grpc pybind11-dev python3.12-dev python3.12-full rdma-core ucx-utils unzip wget
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 2
    update-alternatives --set python3 /usr/bin/python3.12
    ln -sf /usr/bin/python3.12 /usr/bin/python
    curl -LsSf https://astral.sh/uv/install.sh | sh
    install -m 0755 /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/

    export RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
    curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.88.0
    export PATH=/opt/cargo/bin:${PATH}

    export MAX_JOBS=40

    # Build the reviewed MPI-enabled NCCL communication benchmarks.
    git clone https://github.com/NVIDIA/nccl-tests.git "${TMPDIR}/nccl-tests"
    git -C "${TMPDIR}/nccl-tests" checkout --detach 717b68318278e93f371d8ffb46b076069d7c7851
    git -C "${TMPDIR}/nccl-tests" rev-parse HEAD | tee /opt/sglang/nccl-tests-commit.txt
    make -C "${TMPDIR}/nccl-tests" \
        -j "${MAX_JOBS}" \
        CC=/usr/bin/gcc \
        CXX=/usr/bin/g++ \
        MPI=1 \
        MPI_HOME=/usr/lib/x86_64-linux-gnu/openmpi \
        NVCC_GENCODE='-gencode=arch=compute_90,code=sm_90'
    install -d -m 0755 /opt/nccl-tests/bin
    find "${TMPDIR}/nccl-tests/build" -maxdepth 1 -type f -name '*_perf' -exec install -m 0755 '{}' /opt/nccl-tests/bin/ \;
    install -m 0644 "${TMPDIR}/nccl-tests/LICENSE.txt" /opt/nccl-tests/LICENSE.txt
    test "$(find /opt/nccl-tests/bin -maxdepth 1 -type f -name '*_perf' | wc -l)" -eq 11
    rm -rf "${TMPDIR}/nccl-tests"

    while IFS= read -r patch_file
    do
        patch -d /opt/sglang/source -p1 < "${patch_file}"
    done < <(find /opt/sglang-patches -type f -name '*.patch' -print | sort)
    git -C /opt/sglang/source hash-object \
      python/sglang/benchmark/offline_throughput.py \
      | tee /opt/sglang/offline-throughput-source-blob-oid.txt
    printf '2\n' > /opt/sglang/qwen-experiment-metrics-hook-version.txt
    git -C /opt/sglang/source rev-parse HEAD | tee /opt/sglang/sglang-commit.txt

    cd /opt/sglang/source/python
    export UV_CACHE_DIR=/opt/sglang/uv-cache
    export UV_PROJECT_ENVIRONMENT=/opt/sglang/venv
    # Preserve symbols in the SGLang Rust extension for gdb and offline symbolization.
    export CARGO_PROFILE_RELEASE_DEBUG=2
    export CARGO_PROFILE_RELEASE_STRIP=none
    uv sync --project /opt/sglang/source/python --locked --no-install-project
    uv pip install --python /opt/sglang/venv/bin/python setuptools wheel
    uv pip install --python /opt/sglang/venv/bin/python --no-deps -e .
    # SGLang pins flashinfer-python in pyproject.toml.  Keep its companion
    # artifacts at the identical release so FlashInfer's runtime check passes.
    flashinfer_version="$(/opt/sglang/venv/bin/python -c 'from importlib.metadata import version; print(version("flashinfer-python"))')"
    uv pip install --python /opt/sglang/venv/bin/python --upgrade --index-url https://flashinfer.ai/whl "flashinfer-cubin==${flashinfer_version}"
    uv pip install --python /opt/sglang/venv/bin/python --upgrade --index-url https://flashinfer.ai/whl/cu130 "flashinfer-jit-cache==${flashinfer_version}"

    # Build the Hopper DeepEP backend used by expert parallelism.
    deepep_commit=9af0e0d0e74f3577af1979c9b9e1ac2cad0104ee
    curl -fsSL -o "${TMPDIR}/deepep.zip" "https://github.com/deepseek-ai/DeepEP/archive/${deepep_commit}.zip"
    unzip -q "${TMPDIR}/deepep.zip" -d "${TMPDIR}"
    mv "${TMPDIR}/DeepEP-${deepep_commit}" /opt/DeepEP
    sed -i "/^    include_dirs = \['csrc\/'\]/a\\    include_dirs.append('${CUDA_HOME}/include/cccl')" /opt/DeepEP/setup.py
    TORCH_CUDA_ARCH_LIST=9.0 uv pip install --python /opt/sglang/venv/bin/python --no-build-isolation /opt/DeepEP
    rm "${TMPDIR}/deepep.zip"

    # Install optional communication backends used by EP and disaggregated serving.
    uv pip install --python /opt/sglang/venv/bin/python "mooncake-transfer-engine-cuda13==0.3.11.post1"
    uv pip install --python /opt/sglang/venv/bin/python --no-deps nixl nixl-cu13
    git clone --depth=1 --branch sglang-v0.9.1 https://github.com/microsoft/mscclpp.git "${TMPDIR}/mscclpp"
    export CMAKE_ARGS="-DMSCCLPP_BYPASS_GPU_CHECK=ON -DMSCCLPP_USE_CUDA=ON -DMSCCLPP_GPU_ARCHS=90"
    uv pip install --python /opt/sglang/venv/bin/python "${TMPDIR}/mscclpp[cuda13]"
    unset CMAKE_ARGS
    rm -rf "${TMPDIR}/mscclpp"

    # Make kernel artifacts available when the runtime is forced offline.
    cd /opt/sglang/source
    /opt/sglang/venv/bin/kernels lock python
    /opt/sglang/venv/bin/kernels download python

    # The nixl shim currently declares nixl-cu12 even when paired with the
    # official CUDA 13 binary, so pip check would report that known mismatch.
    uv pip freeze --python /opt/sglang/venv/bin/python > /opt/sglang/requirements-frozen.txt
    /opt/sglang/venv/bin/python -m compileall -q /opt/sglang/source/python/sglang

    rm -rf /var/lib/apt/lists/* /root/.cache /opt/sglang/source/.git /opt/sglang-patches /opt/sglang/uv-cache /opt/cargo /opt/rustup /opt/DeepEP/.git "${TMPDIR}"
    install -d -m 0755 /root/.cache

%environment
    export CUDA_HOME=/usr/local/cuda
    export PATH=/opt/sglang/venv/bin:/opt/nccl-tests/bin:/usr/local/cuda/bin:/usr/local/bin:${PATH}
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}
    export PIP_DISABLE_PIP_VERSION_CHECK=1

%test
    set -eu
    export XDG_CACHE_HOME=/var/tmp/sglang-recipe-test-cache
    export UV_CACHE_DIR=${XDG_CACHE_HOME}/uv
    export CUPY_CACHE_DIR=${XDG_CACHE_HOME}/cupy
    /opt/sglang/venv/bin/python -c 'import sglang; print(sglang.__file__)'
    /opt/sglang/venv/bin/python -c 'from sglang.benchmark.offline_throughput import _send_metrics_event; assert callable(_send_metrics_event)'
    /opt/sglang/venv/bin/python -c 'import torch; print(torch.__version__)'
    /opt/sglang/venv/bin/python -c 'from importlib.metadata import version; packages = ("flashinfer-python", "flashinfer-cubin", "flashinfer-jit-cache"); versions = {package: version(package).split("+", 1)[0] for package in packages}; assert len(set(versions.values())) == 1, versions; print(versions)'
    /opt/sglang/venv/bin/python -c 'from importlib.metadata import version; print({p: version(p) for p in ("deep-ep", "mooncake-transfer-engine-cuda13", "mscclpp", "nixl", "nixl-cu13")})'
    mpirun --version
    test "$(find /opt/nccl-tests/bin -maxdepth 1 -type f -name '*_perf' | wc -l)" -eq 11
    for binary in all_reduce_perf all_gather_perf reduce_scatter_perf; do
        /opt/nccl-tests/bin/${binary} -h 2>&1 | grep -q -- '-J'
    done
    test "$(cat /opt/sglang/nccl-tests-commit.txt)" = 717b68318278e93f371d8ffb46b076069d7c7851
    test "$(cat /opt/sglang/qwen-experiment-metrics-hook-version.txt)" = 2
    test -s /opt/sglang/offline-throughput-source-blob-oid.txt
    test -s /opt/apac/manifest.json
    ! ldd /opt/nccl-tests/bin/all_reduce_perf | grep -q 'not found'
    ucx_info -v
    uv --version
    rm -rf "${XDG_CACHE_HOME}"
