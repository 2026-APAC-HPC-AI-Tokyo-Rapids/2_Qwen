{
  "schema_version": "qwen3-pd-run/v1",
  "mode": "exploratory",
  "concurrency": 16,
  "topology": {
    "nodes": 2,
    "gpus_per_node": 8,
    "prefill_workers": 4,
    "prefill_tensor_parallel_size": 2,
    "decode_workers": 2,
    "decode_tensor_parallel_size": 4,
    "decode_expert_parallel_size": 4,
    "decode_max_running_requests": 256,
    "transfer_backend": "nixl"
  },
  "exploratory_timing": {
    "warmup_duration_seconds": 10,
    "benchmark_duration_seconds": 15,
    "benchmark_grace_period_seconds": 15
  }
}
