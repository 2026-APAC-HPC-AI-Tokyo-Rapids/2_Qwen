    "scope": "Streaming /v1/chat/completions without logprob merging",
    "release_condition": "First complete content/reasoning/tool-call/finish SSE, or successful full Prefill completion; headers, comments and role-only SSE do not independently release while Prefill is pending.",
    "prefill_accounting": "Reservation lives in the Prefill future until full response consumption, failure or cancellation.",
    "terminal_condition": "Hold Decode [DONE] until Prefill succeeds. A late error terminates the body with an error.",
    "cancellation": "Response-body closure cancels pending upstream work even while Decode is idle.",
    "unchanged": "Model computation, generated bytes/order, PD topology, numerical kernels, sampling, official AIPerf command, nonstream behavior and logprob merging."
