#!/usr/bin/env bash
#PJM -L rscgrp=b-batch
#PJM -L elapse=02:00:00
#PJM -L gpu=1
#PJM -j
#PJM -S
set -euo pipefail

model=/fast/pj26000080/Qwen/Qwen3.5-35B-A3B-FP8
image=docker://lmsysorg/sglang:Qwen3.5-35B-A3B
run_id="${PJM_JOBID:-manual}-$(date -u +%Y%m%dT%H%M%SZ)"
result_dir="/fast/pj26000080/Qwen/results/${run_id}"
mkdir -p "$result_dir"

module purge
module load cuda/12.8.1 singularity-ce/4.1.3

# Reuse OCI layers prepared on the login node. OCI mode avoids building a large SIF.
export SINGULARITY_CACHEDIR=/fast/pj26000080/.singularity-cache
export SINGULARITY_TMPDIR=/dev/shm
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1

{
  hostname
  nvidia-smi
  singularity --version
} >"${result_dir}/environment.log" 2>&1

singularity exec --oci --nv --cleanenv \
  --env HF_HUB_OFFLINE=1,TRANSFORMERS_OFFLINE=1,HF_DATASETS_OFFLINE=1 \
  --bind "${model}:${model},${result_dir}:${result_dir}" \
  "$image" \
  python -m sglang.benchmark.offline_throughput \
    --model-path "$model" \
    --load-format auto \
    --tp-size 1 \
    --dataset-name random \
    --random-input-len 1024 \
    --random-output-len 256 \
    --num-prompts 32 \
    --seed 42 \
    --mem-fraction-static 0.85 \
    --result-filename "${result_dir}/results.jsonl" \
  2>&1 | tee "${result_dir}/benchmark.log"
