// One-GPU diagnostic: actual Prefill FC1 math loops, two TMA producer warps,
// the serving stage layout and register budgets. No routing, NVLink, FC2,
// SwiGLU or serving workload. Its timing is NOT an end-to-end MegaMoE result.
#include <deep_gemm/impls/sm90_fp8_mega_moe.cuh>
#include <cuda_runtime.h>
#include <cuda_fp8.h>
#include <algorithm>
#include <cmath>
#include <cstdio>
#include <cstring>
#include <vector>

#define CUDA_OK(expr) do { auto e=(expr); if(e!=cudaSuccess) { std::fprintf(stderr,"%s: %s at %d\n",#expr,cudaGetErrorString(e),__LINE__); std::exit(1); } } while(0)
#define CU_OK(expr) do { auto e=(expr); if(e!=CUDA_SUCCESS) { std::fprintf(stderr,"%s: driver error %d at %d\n",#expr,int(e),__LINE__); std::exit(1); } } while(0)
constexpr unsigned H=4096, M=128, N=256, EXPERTS=32, SMEM=225472;
namespace deep_gemm {
// EXTRACTED_KERNEL
CUTLASS_GLOBAL __launch_bounds__(384,1)
void @NAME@(const __grid_constant__ CUtensorMap tensor_a,
           const __grid_constant__ CUtensorMap tensor_b,
           const __grid_constant__ CUtensorMap tensor_sf,
           const float* l1_weights_sf, float* output) {
    constexpr bool kPrefill2WG=true, kFastMath=true;
    constexpr uint32_t BLOCK_K=128, kAccumPerThread=128, kNumStages=3;
    constexpr uint32_t SMEM_A_SIZE_PER_STAGE=16384, SMEM_B_SIZE_PER_STAGE=32768;
    constexpr uint32_t kL1SFKBlocks=32, kL1SFGateBlks=12, kL1SFPerExpert=768;
    constexpr uint32_t n_block_idx=0, sf_n_block_idx=0;
    const uint32_t local_expert_idx=blockIdx.x%EXPERTS;
    const uint32_t warp_idx=threadIdx.x/32, lane_idx=threadIdx.x%32;
    using a_dtype_t=cutlass::float_e4m3_t;
    using b_dtype_t=cutlass::float_e4m3_t;
    using WGMMA=typename mma::sm90::FP8MMASelector<256>::type;
    using Barrier=cutlass::arch::ClusterTransactionBarrier;
    extern __shared__ __align__(1024) uint8_t storage[];
    auto smem_a=utils::PatternVisitor([&](uint32_t i) { return reinterpret_cast<a_dtype_t*>(storage+74752+i*16384); });
    auto smem_b=utils::PatternVisitor([&](uint32_t i) { return reinterpret_cast<b_dtype_t*>(storage+123904+i*32768); });
    auto smem_sfa=utils::PatternVisitor([&](uint32_t i) { return reinterpret_cast<float*>(storage+222208+i*1024); });
    auto full_barriers=utils::PatternVisitor([&](uint32_t i) { return reinterpret_cast<Barrier*>(storage+225280)+2+i; });
    auto empty_barriers=utils::PatternVisitor([&](uint32_t i) { return reinterpret_cast<Barrier*>(storage+225280)+5+i; });
    if(threadIdx.x==0) {
        for(unsigned i=0;i<3;++i) { full_barriers[i]->init(2); empty_barriers[i]->init(8); }
        cutlass::arch::fence_barrier_init();
    }
    __syncthreads();
    uint32_t stage_idx=0, phase=0;
    auto advance_pipeline=[&](uint32_t& k) { ++k; if(++stage_idx==3) stage_idx=0,phase^=1; };
    if(warp_idx<2) {
        cutlass::arch::warpgroup_reg_dealloc<48>();
    } else if(warp_idx<4) {
        cutlass::arch::warpgroup_reg_dealloc<40>();
        for(uint32_t k=0;k<32;advance_pipeline(k)) {
            empty_barriers[stage_idx]->wait(phase^1);
            if(cute::elect_one_sync()) {
                if(warp_idx==2) {
                    tma::copy<128,128,128,a_dtype_t>(&tensor_a,full_barriers[stage_idx],smem_a[stage_idx],k*128,blockIdx.x*128,1);
                    tma::copy<128,1,0,float>(&tensor_sf,full_barriers[stage_idx],smem_sfa[stage_idx],blockIdx.x*128,k,1);
                    full_barriers[stage_idx]->arrive_and_expect_tx(16384+128*sizeof(float));
                } else {
                    tma::copy<128,256,128,b_dtype_t>(&tensor_b,full_barriers[stage_idx],smem_b[stage_idx],k*128,local_expert_idx*256,1);
                    full_barriers[stage_idx]->arrive_and_expect_tx(32768);
                }
            }
            __syncwarp();
        }
    } else {
        cutlass::arch::warpgroup_reg_alloc<168>();
        const uint32_t wg=(warp_idx-4)/4, warp_in_wg=(warp_idx-4)%4;
        const uint32_t row_offset_r0=wg*64+warp_in_wg*16+lane_idx/4;
        const uint32_t row_offset_r1=row_offset_r0+8;
        const auto da=mma::sm90::make_smem_desc(smem_a[0]+wg*64*128,1);
        const auto db=mma::sm90::make_smem_desc(smem_b[0],1);
        const uint32_t desc_a_lo=da.reg32_[0], desc_b_lo=db.reg32_[0];
        const uint64_t desc_a_hi=uint64_t(da.reg32_[1])<<32, desc_b_hi=uint64_t(db.reg32_[1])<<32;
        constexpr uint32_t num_k_blocks=32;
        float final_accum[128]={};
        auto publish_l1_rows=[]() {}; // No preceding tile/FC2 in this diagnostic.
        @POSTSCALE@
        @ISSUE@
        @LOOP@
        #pragma unroll
        for(unsigned i=0;i<32;++i) {
            const unsigned col=i*8+(lane_idx%4)*2;
            output[(blockIdx.x*128+row_offset_r0)*256+col]=final_accum[i*4];
            output[(blockIdx.x*128+row_offset_r0)*256+col+1]=final_accum[i*4+1];
            output[(blockIdx.x*128+row_offset_r1)*256+col]=final_accum[i*4+2];
            output[(blockIdx.x*128+row_offset_r1)*256+col+1]=final_accum[i*4+3];
        }
    }
}
// EXTRACTED_KERNEL
}

CUtensorMap descriptor(void* ptr, CUtensorMapDataType dtype, uint64_t x, uint64_t y, uint32_t bx, uint32_t by, unsigned bytes, CUtensorMapSwizzle swizzle) {
    CUtensorMap desc{};
    uint64_t dims[2]={x,y}, strides[1]={x*bytes};
    uint32_t box[2]={bx,by}, elem[2]={1,1};
    CU_OK(cuTensorMapEncodeTiled(&desc,dtype,2,ptr,dims,strides,box,elem,CU_TENSOR_MAP_INTERLEAVE_NONE,swizzle,CU_TENSOR_MAP_L2_PROMOTION_NONE,CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE));
    return desc;
}
template<class T> T* device_copy(const std::vector<T>& data) {
    T* ptr; CUDA_OK(cudaMalloc(&ptr,data.size()*sizeof(T)));
    CUDA_OK(cudaMemcpy(ptr,data.data(),data.size()*sizeof(T),cudaMemcpyHostToDevice)); return ptr;
}
float fp8(uint8_t bits) { __nv_fp8_e4m3 q; q.__x=bits; return float(q); }
int main() {
    CU_OK(cuInit(0));
    int count=0; CUDA_OK(cudaGetDeviceCount(&count));
    if(count!=1) { std::fprintf(stderr,"Expected exactly one scheduler-visible GPU; got %d\n",count); return 1; }
    CUDA_OK(cudaSetDevice(0));
    cudaDeviceProp prop{}; CUDA_OK(cudaGetDeviceProperties(&prop,0));
    if(prop.major!=9 || prop.minor!=0) { std::fprintf(stderr,"Hopper sm_90a required\n"); return 1; }
    unsigned blocks=prop.multiProcessorCount;
    for(auto kernel: {deep_gemm::baseline,deep_gemm::candidate}) {
        CUDA_OK(cudaFuncSetAttribute(kernel,cudaFuncAttributeMaxDynamicSharedMemorySize,SMEM));
        int resident=0; CUDA_OK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&resident,kernel,384,SMEM));
        cudaFuncAttributes attr{}; CUDA_OK(cudaFuncGetAttributes(&attr,kernel));
        if(resident<1) { std::fprintf(stderr,"No resident CTA fits\n"); return 1; }
        std::printf("resources registers=%d local_bytes=%zu resident_ctas_per_sm=%d dynamic_smem=%u\n",attr.numRegs,attr.localSizeBytes,resident,SMEM);
    }
    std::printf("device=%s sm_count=%u blocks=%u threads=384\n",prop.name,blocks,blocks);
    const size_t rows=blocks*M, outputs=rows*N;
    std::vector<uint8_t> a(rows*H), b(EXPERTS*N*H);
    std::vector<float> sf(rows*32), weights(EXPERTS*768), ref(outputs), got(outputs), previous;
    for(size_t i=0;i<a.size();++i) a[i]=uint8_t(0x20+(i*17+i/113)%32)|((i/7%2)?128:0);
    for(size_t i=0;i<b.size();++i) b[i]=uint8_t(0x20+(i*13+i/97)%32)|((i/11%2)?128:0);
    for(size_t i=0;i<sf.size();++i) sf[i]=0.03f+0.007f*(i%11);
    for(size_t i=0;i<weights.size();++i) weights[i]=0.013f+0.001f*(i%29);
    auto ad=device_copy(a), bd=device_copy(b);
    auto sd=device_copy(sf), wd=device_copy(weights);
    float *out0,*out1; CUDA_OK(cudaMalloc(&out0,outputs*sizeof(float))); CUDA_OK(cudaMalloc(&out1,outputs*sizeof(float)));
    const auto ta=descriptor(ad,CU_TENSOR_MAP_DATA_TYPE_UINT8,H,rows,128,128,1,CU_TENSOR_MAP_SWIZZLE_128B);
    const auto tb=descriptor(bd,CU_TENSOR_MAP_DATA_TYPE_UINT8,H,EXPERTS*N,128,256,1,CU_TENSOR_MAP_SWIZZLE_128B);
    const auto ts=descriptor(sd,CU_TENSOR_MAP_DATA_TYPE_FLOAT32,rows,32,128,1,4,CU_TENSOR_MAP_SWIZZLE_NONE);
    cudaStream_t stream; CUDA_OK(cudaStreamCreate(&stream));
    auto launch=[&](bool candidate) {
        if(candidate) deep_gemm::candidate<<<blocks,384,SMEM,stream>>>(ta,tb,ts,wd,out1);
        else deep_gemm::baseline<<<blocks,384,SMEM,stream>>>(ta,tb,ts,wd,out0);
        CUDA_OK(cudaGetLastError());
    };
    cudaGraph_t graph; cudaGraphExec_t graph_exec;
    CUDA_OK(cudaStreamBeginCapture(stream,cudaStreamCaptureModeGlobal)); launch(false); launch(true);
    CUDA_OK(cudaStreamEndCapture(stream,&graph)); CUDA_OK(cudaGraphInstantiate(&graph_exec,graph,0));
    for(unsigned replay=0;replay<3;++replay) {
        if(replay) {
            for(auto& v:a) v^=128;
            CUDA_OK(cudaMemcpy(ad,a.data(),a.size(),cudaMemcpyHostToDevice));
        }
        CUDA_OK(cudaMemset(out0,0xff,outputs*sizeof(float))); CUDA_OK(cudaMemset(out1,0xff,outputs*sizeof(float)));
        CUDA_OK(cudaGraphLaunch(graph_exec,stream)); CUDA_OK(cudaStreamSynchronize(stream));
        CUDA_OK(cudaMemcpy(ref.data(),out0,outputs*sizeof(float),cudaMemcpyDeviceToHost));
        CUDA_OK(cudaMemcpy(got.data(),out1,outputs*sizeof(float),cudaMemcpyDeviceToHost));
        size_t mismatches=0;
        for(size_t i=0;i<outputs;++i) if(!std::isfinite(ref[i]) || !std::isfinite(got[i]) || std::memcmp(&ref[i],&got[i],sizeof(float))) ++mismatches;
        std::printf("replay=%u values=%zu bit_mismatches=%zu\n",replay,outputs,mismatches);
        if(mismatches || (replay && previous==got)) return 1;
        previous=got;
        // Independent double-precision reference catches shared TMA/layout mistakes.
        double worst=0;
        for(unsigned block: {0u,blocks/2,blocks-1}) for(unsigned row: {0u,63u,127u}) for(unsigned col: {0u,7u,8u,127u,128u,255u}) {
            double expected=0;
            for(unsigned k=0;k<H;++k) {
                float scale_a=sf[(k/128)*rows+block*128+row];
                float scale_b=weights[(block%EXPERTS)*768+((col/8)%2?12:0)*32+k/128];
                expected+=double(fp8(a[(block*128+row)*H+k]))*fp8(b[((block%EXPERTS)*256+col)*H+k])*scale_a*scale_b;
            }
            double error=std::abs(ref[(block*128+row)*256+col]-expected)/(1+std::abs(expected));
            worst=std::max(worst,error);
        }
        std::printf("replay=%u reference_max_normalized_error=%.9g\n",replay,worst);
        if(worst>0.002) return 1;
    }
    for(unsigned i=0;i<5;++i) { launch(false); launch(true); }
    CUDA_OK(cudaStreamSynchronize(stream));
    cudaEvent_t begin,end; CUDA_OK(cudaEventCreate(&begin)); CUDA_OK(cudaEventCreate(&end));
    std::vector<float> times[2];
    for(unsigned repeat=0;repeat<30;++repeat) for(unsigned order=0;order<2;++order) {
        unsigned which=order^(repeat%2);
        CUDA_OK(cudaEventRecord(begin,stream)); launch(which); CUDA_OK(cudaEventRecord(end,stream)); CUDA_OK(cudaEventSynchronize(end));
        float ms; CUDA_OK(cudaEventElapsedTime(&ms,begin,end)); times[which].push_back(ms*1000);
    }
    for(auto& t:times) std::sort(t.begin(),t.end());
    std::printf("PASS baseline_median_us=%.3f candidate_median_us=%.3f ratio=%.5f samples=30\n",times[0][15],times[1][15],times[1][15]/times[0][15]);
    CUDA_OK(cudaGraphExecDestroy(graph_exec)); CUDA_OK(cudaGraphDestroy(graph));
    CUDA_OK(cudaEventDestroy(begin)); CUDA_OK(cudaEventDestroy(end)); CUDA_OK(cudaStreamDestroy(stream));
    for(void* p: {static_cast<void*>(ad),static_cast<void*>(bd),static_cast<void*>(sd),static_cast<void*>(wd),static_cast<void*>(out0),static_cast<void*>(out1)}) CUDA_OK(cudaFree(p));
    return 0;
}
