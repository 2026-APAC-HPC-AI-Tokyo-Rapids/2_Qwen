+                APAC_STAMP(6);
                 if constexpr (Split && Varlen) {
                     if (!work_tile_info.is_valid(params.scheduler)) {  // Last tile
                         cutlass::arch::launch_dependent_grids();
@@ -542,6 +546,7 @@ public:
