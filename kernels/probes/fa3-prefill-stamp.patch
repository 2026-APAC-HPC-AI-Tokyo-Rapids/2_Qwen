diff --git a/hopper/apac_stamp.cuh b/hopper/apac_stamp.cuh
new file mode 100644
index 0000000..d26310d
--- /dev/null
+++ b/hopper/apac_stamp.cuh
@@ -0,0 +1,11 @@
+#pragma once
+// Probe-only per-tile consumer timestamps, one thread per consumer warpgroup.
+#include <cstdint>
+__device__ unsigned long long apac_stamp_buf[1 << 18];
+__device__ unsigned int apac_stamp_count;
+__device__ __forceinline__ unsigned long long apac_clock() { unsigned long long t; asm volatile("mov.u64 %0, %%clock64;" : "=l"(t) :: "memory"); return t; }
+// Static shared memory would shift the 1024-byte aligned dynamic shared memory, so the slot lives in global memory.
+__device__ unsigned int apac_stamp_slot[4096];
+__device__ __forceinline__ unsigned int& apac_slot() { return apac_stamp_slot[blockIdx.x * 4 + threadIdx.x / 128]; }
+#define APAC_STAMP_BEGIN(coord) do { if (threadIdx.x % 128 == 0) { unsigned long long t0 = apac_clock(); unsigned int s = atomicAdd(&apac_stamp_count, 1u); apac_slot() = s; unsigned int sm; asm volatile("mov.u32 %0, %%smid;" : "=r"(sm)); if (s < (1u << 14)) { apac_stamp_buf[s * 16 + 0] = (uint64_t(sm) << 48) | (uint64_t(threadIdx.x / 128) << 44) | (uint64_t(cute::get<2>(coord)) << 40) | (uint64_t(cute::get<1>(coord)) << 32) | uint64_t(cute::get<0>(coord)); apac_stamp_buf[s * 16 + 1] = t0; } } } while (0)
+#define APAC_STAMP(i) do { if (threadIdx.x % 128 == 0) { unsigned int s = apac_slot(); if (s < (1u << 14)) { apac_stamp_buf[s * 16 + 1 + (i)] = apac_clock(); } } } while (0)
