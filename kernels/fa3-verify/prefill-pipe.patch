+                if (nxt.n_block_max - 1 == nxt.n_block_min) { query_empty(nxt); }
+                make_mask(nxt).template apply<true /*Seqlenk_mask*/, Is_causal, Is_local>(tSrS, nxt.m_block, nxt.n_block_max - 1);
