+        flash::gemm<true, -1>(tiled_mma_qk, q_fragment(cur.qbuf), tSrK(_, _, _, smem_pipe_read.index()), tSrS0);
+        warpgroup_wait<0>();
+        pipeline_k.consumer_release(smem_pipe_read);
