+    // store_fp8_direct for the pipelined tiles: the caller passes the sequence offset and length it
+    // already holds, and only the stores are predicated, so the code is straight-line. Same values.
+    template <typename SharedStorage, typename FrgTensorO, typename TiledMma>
+    CUTLASS_DEVICE void
+    store_fp8_rows(Params const& params, FrgTensorO const& tOrO, SharedStorage& shared_storage,
+                   TiledMma tiled_mma, int thread_idx, int m_block, int bidh, int offset, int seqlen) {
+        static_assert(SupportsFP8Output && FP8PermuteCol && SkipLSE && !Use_TMA_O);
+        #pragma unroll
+        for (uint32_t cta_id = 0; cta_id < size(ClusterShape{}); ++cta_id) {
+            shared_storage.pipelines.barrier_O.arrive(cta_id);
+        }
+        Tensor values = make_tensor_like<float>(group_modes<1, 3>(tOrO));
+        #pragma unroll
+        for (int i = 0; i < size(values); ++i) {
+            uint32_t bits;
+            asm("cvt.rn.bf16x2.f32 %0, %1, %2;\n" : "=r"(bits) : "f"(group_modes<1, 3>(tOrO)(i)), "f"(0.f));
+            values(i) = __uint_as_float(bits);
+        }
+        Tensor coords = group_modes<1, 3>(tiled_mma.get_thread_slice(thread_idx).partition_C(cute::make_identity_tensor(select<0, 1>(TileShape_MNK_PV{}))));
+        static_assert(decltype(size<0, 0>(values))::value == 2 && decltype(size<0, 1>(values))::value == 2 && decltype(size<0, 2>(values))::value == 16 && decltype(size<1>(values))::value == 1);
+        int const col = 2 * get<1>(coords(_0{}, _0{}));
+        cutlass::NumericArrayConverter<cutlass::float_e4m3_t, float, 4> convert;
+        #pragma unroll
+        for (int r = 0; r < 2; ++r) {
+            float amax = 0.f;
+            #pragma unroll
+            for (int n = 0; n < 16; ++n) {
+                #pragma unroll
+                for (int c = 0; c < 2; ++c) { amax = fmaxf(amax, fabsf(values(make_coord(c, r, n), _0{}))); }
+            }
+            amax = fmaxf(amax, __shfl_xor_sync(0xffffffff, amax, 1));
+            amax = fmaxf(amax, __shfl_xor_sync(0xffffffff, amax, 2));
+            amax = fmaxf(amax, 1e-10f);
+            // The deployed quantizer also compiles this division with --use_fast_math.
+            float const quant_scale = 448.f / amax;
+            int const row = m_block * kBlockM + get<0>(coords(make_coord(_0{}, r, _0{}), _0{}));
+            int const token = offset + row / 16;
+            int const head = bidh * 16 + row % 16;
+            uint32_t packed[8];
+            #pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                cutlass::Array<float, 4> x;
+                x[0] = values(make_coord(0, r, 2 * i), _0{}) * quant_scale;
+                x[1] = values(make_coord(1, r, 2 * i), _0{}) * quant_scale;
+                x[2] = values(make_coord(0, r, 2 * i + 1), _0{}) * quant_scale;
+                x[3] = values(make_coord(1, r, 2 * i + 1), _0{}) * quant_scale;
+                cutlass::Array<cutlass::float_e4m3_t, 4> q = convert(x);
+                packed[i] = reinterpret_cast<uint32_t const&>(q);
+            }
+            float const scale = amax * (1.f / 448.f);
+            if (row < seqlen * 16) {
+                uint8_t* dst = params.ptr_O_fp8 + (int64_t(token) * 64 + head) * 128 + col;
+                #pragma unroll
+                for (int i = 0; i < 8; ++i) { *reinterpret_cast<uint32_t*>(dst + 16 * i) = packed[i]; }
+                if (col == 0) { params.ptr_O_scale[int64_t(head) * params.scale_group_stride + token] = scale; }
+            }
+        }
+    }
