+"""Gather existing FP8 bytes and FP32 scale bits without requantization.
+
+Caller guarantees EP1 prepare_moe_input map entries are valid source rows.
+This is not a padded-map API: negative or unwritten entries are invalid, as in
+native shuffle_rows. One program per destination row matches the native copy.
+"""
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _shuffle_fp8_scale_bits(Q, S, Map, OQ, OS, K: tl.constexpr, G: tl.constexpr):
+    dst = tl.program_id(0).to(tl.int64)
+    src = tl.load(Map + dst).to(tl.int64)
+    columns = tl.arange(0, K)
+    values = tl.load(Q + src * K + columns)
+    tl.store(OQ + dst * K + columns, values)
+    groups = tl.arange(0, G)
+    scales = tl.load(S + src * G + groups)
+    tl.store(OS + dst * G + groups, scales)
+
+
+def shuffle_fp8_rows_with_scales(q, scales, dst2src):
+    """Fixed K4096/G32 bit-copy API; buffers keep native row-major layout."""
+    assert q.ndim == 2 and q.shape[1] == 4096 and q.dtype == torch.float8_e4m3fn
+    assert scales.shape == (q.shape[0], 32) and scales.dtype == torch.float32
+    assert dst2src.ndim == 1 and dst2src.dtype == torch.int32
+    assert q.is_contiguous() and scales.is_contiguous() and dst2src.is_contiguous()
+    assert q.device == scales.device == dst2src.device and q.is_cuda
+    rows = dst2src.numel()
+    out_q = torch.empty((rows, 4096), dtype=q.dtype, device=q.device)
+    out_scales = torch.empty((rows, 32), dtype=scales.dtype, device=scales.device)
+    if rows:
+        # Integer views avoid FP8 casts and preserve all NaN payload/signed-zero bits.
+        _shuffle_fp8_scale_bits[(rows,)](q.view(torch.uint8), scales.view(torch.int32), dst2src, out_q.view(torch.uint8), out_scales.view(torch.int32), K=4096, G=32, num_warps=8)
+    return out_q, out_scales
