+@cache_once
+def _jit_rope_fp8_q_module() -> Module:
+    args = make_cpp_args(True, 128, is_arch_support_pdl(), torch.bfloat16)
+    return load_jit(
+        "rope_fp8_q",
+        *args,
+        cuda_files=["elementwise/rope.cuh"],
+        cuda_wrappers=[("run", f"FusedRopeKernel<{args}>::run_fp8")],
+    )
+
+
+@register_custom_op(mutates_args=["k", "q_fp8"])
+def apply_rope_fp8_q(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    cos_sin_cache: torch.Tensor,
+    positions: torch.Tensor,
+    q_fp8: torch.Tensor,
+) -> None:
+    """NeoX H128 BF16 RoPE, with Q cast to FP8 and K rotated in place."""
+    _jit_rope_fp8_q_module().run(q, k, cos_sin_cache, positions, q_fp8)
+
