+def get_staging_kv_buffers(target_pool, draft_pool=None):
+    """Keep target and EAGLE KV in the same layer order on both endpoints."""
+    k_buffers, v_buffers = [], []
+    page_size = None
+    geometry = None
+    for pool in (target_pool, draft_pool):
+        if pool is None:
+            continue
+        pool = getattr(pool, "full_kv_pool", pool)
+        if not hasattr(pool, "k_buffer") or not hasattr(pool, "v_buffer"):
+            raise ValueError("Staged MHA transfer requires K and V tensors")
+        if page_size is None:
+            page_size = pool.page_size
+        if pool.page_size != page_size or len(pool.k_buffer) != len(pool.v_buffer):
+            raise ValueError("Target/draft staging page size or K/V count mismatch")
+        for tensor in (*pool.k_buffer, *pool.v_buffer):
+            current = (tensor.shape[1:], tensor.stride(), tensor.dtype, tensor.device)
+            if geometry is None:
+                geometry = current
+            if current != geometry or not tensor.is_contiguous():
+                raise ValueError("Staged target/draft KV must have identical geometry and dtype")
+        k_buffers.extend(pool.k_buffer)
+        v_buffers.extend(pool.v_buffer)
+    if not k_buffers:
+        raise ValueError("Staged MHA transfer has no KV tensors")
+    return k_buffers, v_buffers, page_size
+
