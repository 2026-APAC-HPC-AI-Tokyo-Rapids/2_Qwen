+    #[tokio::test]
+    async fn test_upstream_failure_cancels_peer_and_releases_prefill() {
+        use tokio::time::{sleep, timeout, Duration};
+        for decode_error in [true, false] {
+            let (p_url, p_seen, p_response, p_server) = controlled_server().await;
+            let (d_url, d_seen, d_response, d_server) = controlled_server().await;
+            let p: Arc<dyn Worker> = Arc::from(create_test_worker(
+                p_url,
+                WorkerType::Prefill {
+                    bootstrap_port: None,
+                },
+                true,
+            ));
+            let d: Arc<dyn Worker> = Arc::from(create_test_worker(d_url, WorkerType::Decode, true));
+            let router = create_test_pd_router();
+            let (p_task, d_task) = (p.clone(), d.clone());
+            let task = tokio::spawn(async move {
+                router
+                    .execute_dual_dispatch_internal(
+                        None,
+                        json!({"stream": true}),
+                        PDRequestContext {
+                            route: "/generate",
+                            batch_size: None,
+                            is_stream: true,
+                            return_logprob: false,
+                            request_text: None,
+                            model_id: None,
+                            headers: None,
+                        },
+                        p_task,
+                        d_task,
+                        Instant::now(),
+                    )
+                    .await
+            });
+            timeout(Duration::from_secs(2), p_seen)
+                .await
+                .unwrap()
+                .unwrap();
+            timeout(Duration::from_secs(2), d_seen)
+                .await
+                .unwrap()
+                .unwrap();
+            let (body_tx, body_rx) =
+                tokio::sync::mpsc::unbounded_channel::<Result<bytes::Bytes, std::io::Error>>();
+            p_response
+                .send(Response::new(Body::from_stream(
+                    UnboundedReceiverStream::new(body_rx),
+                )))
+                .unwrap();
+            body_tx
+                .send(Ok(bytes::Bytes::from_static(b"data: partial\n\n")))
+                .unwrap();
+            sleep(Duration::from_millis(10)).await;
+            assert_eq!(p.load(), 1);
+            if decode_error {
+                // Prefill cannot finish KV transfer after Decode rejects the request.
+                d_response
+                    .send((StatusCode::SERVICE_UNAVAILABLE, "unavailable").into_response())
+                    .unwrap();
+            } else {
+                // Decode headers have not arrived; a truncated Prefill body is fatal.
+                body_tx
+                    .send(Err(std::io::Error::other("truncated Prefill")))
+                    .unwrap();
+            }
+            let response = timeout(Duration::from_secs(2), task)
+                .await
+                .unwrap()
+                .unwrap();
+            assert_eq!(
+                response.status(),
+                if decode_error {
+                    StatusCode::SERVICE_UNAVAILABLE
+                } else {
+                    StatusCode::BAD_GATEWAY
+                }
+            );
+            assert_eq!(p.load(), 0);
+            drop(response);
+            assert_eq!(d.load(), 0);
+            p_server.abort();
+            d_server.abort();
+        }
+    }
