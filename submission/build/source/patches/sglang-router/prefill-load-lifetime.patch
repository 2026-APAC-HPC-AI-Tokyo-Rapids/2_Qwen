+    // Controlled HTTP responses exercise the real dispatch/body lifetime without GPUs.
+    async fn controlled_server() -> (
+        String,
+        tokio::sync::oneshot::Receiver<()>,
+        tokio::sync::oneshot::Sender<Response>,
+        tokio::task::JoinHandle<()>,
+    ) {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!("http://{}", listener.local_addr().unwrap());
+        let (seen_tx, seen_rx) = tokio::sync::oneshot::channel();
+        let (response_tx, response_rx) = tokio::sync::oneshot::channel();
+        let state = Arc::new(tokio::sync::Mutex::new(Some((seen_tx, response_rx))));
+        let app = axum::Router::new().fallback(move || {
+            let state = state.clone();
+            async move {
+                let (seen, response) = state.lock().await.take().unwrap();
+                let _ = seen.send(());
+                response.await.unwrap()
+            }
+        });
+        let task = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+        (url, seen_rx, response_tx, task)
+    }
