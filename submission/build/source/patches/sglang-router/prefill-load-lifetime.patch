+    #[tokio::test]
+    async fn test_prefill_load_follows_full_body_not_decode_or_headers() {
+        use tokio::time::{sleep, timeout, Duration};
+
+        // Success, Prefill failure and cancellation must all release the reservation.
+        for (is_stream, cancel, status) in [
+            (true, false, StatusCode::OK),
+            (false, false, StatusCode::OK),
+            (true, false, StatusCode::SERVICE_UNAVAILABLE),
+            (true, true, StatusCode::OK),
+        ] {
+            let (p_url, p_seen, p_response, p_server) = controlled_server().await;
+            let (d_url, d_seen, d_response, d_server) = controlled_server().await;
+            let p: Arc<dyn Worker> = Arc::from(create_test_worker(
+                p_url,
+                WorkerType::Prefill {
+                    bootstrap_port: None,
+                },
+                true,
+            ));
+            let d: Arc<dyn Worker> = Arc::from(create_test_worker(d_url, WorkerType::Decode, true));
+            let router = create_test_pd_router();
+            let (p_task, d_task) = (p.clone(), d.clone());
+            let task = tokio::spawn(async move {
+                router
+                    .execute_dual_dispatch_internal(
+                        None,
+                        json!({"stream": is_stream}),
+                        PDRequestContext {
+                            route: "/generate",
+                            batch_size: None,
+                            is_stream,
+                            return_logprob: false,
+                            request_text: None,
+                            model_id: None,
+                            headers: None,
+                        },
+                        p_task,
+                        d_task,
+                        Instant::now(),
+                    )
+                    .await
+            });
+            timeout(Duration::from_secs(2), p_seen)
+                .await
+                .unwrap()
+                .unwrap();
+            timeout(Duration::from_secs(2), d_seen)
+                .await
+                .unwrap()
+                .unwrap();
+            assert_eq!(p.load(), 1); // Both upstream requests have been sent.
+            let (body_tx, body_rx) =
+                tokio::sync::mpsc::unbounded_channel::<Result<bytes::Bytes, std::io::Error>>();
+            p_response
+                .send(
+                    (
+                        status,
+                        Body::from_stream(UnboundedReceiverStream::new(body_rx)),
+                    )
+                        .into_response(),
+                )
+                .unwrap();
+            body_tx.send(Ok(bytes::Bytes::from_static(b"{}"))).unwrap();
+            sleep(Duration::from_millis(10)).await;
+            assert_eq!(p.load(), 1); // Headers and a partial body cannot release it.
+            if cancel {
+                task.abort();
+                assert!(task.await.unwrap_err().is_cancelled());
+                assert_eq!(p.load(), 0);
+            } else {
+                drop(body_tx);
+                timeout(Duration::from_secs(2), async {
+                    while p.load() != 0 {
+                        sleep(Duration::from_millis(1)).await;
+                    }
+                })
+                .await
+                .unwrap();
+                if !status.is_success() {
+                    let response = timeout(Duration::from_secs(2), task)
+                        .await
+                        .unwrap()
+                        .unwrap();
+                    assert_eq!(response.status(), status);
+                    assert_eq!(d.load(), 0);
+                    p_server.abort();
+                    d_server.abort();
+                    continue;
+                }
+                assert!(!task.is_finished()); // Decode headers are still withheld.
+                let (decode_tx, decode_rx) =
+                    tokio::sync::mpsc::unbounded_channel::<Result<bytes::Bytes, std::io::Error>>();
+                let body = if is_stream {
+                    Body::from_stream(UnboundedReceiverStream::new(decode_rx))
+                } else {
+                    Body::from("{}")
+                };
+                d_response.send(Response::new(body)).unwrap();
+                let response = timeout(Duration::from_secs(2), task)
+                    .await
+                    .unwrap()
+                    .unwrap();
+                assert_eq!(response.status(), status);
+                assert_eq!(p.load(), 0);
+                assert_eq!(d.load(), usize::from(is_stream && status.is_success()));
+                drop(response);
+                drop(decode_tx);
+                assert_eq!(d.load(), 0);
+            }
+            p_server.abort();
+            d_server.abort();
+        }
+    }
