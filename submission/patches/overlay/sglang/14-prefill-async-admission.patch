+    def prefetch_disagg_prefill_outputs(
+        self: Scheduler, batch: ScheduleBatch, result: GenerationBatchResult
+    ) -> None:
+        """Issue the D2H copies that result processing needs, on the copy stream
+        (already ordered after this forward) and before copy_done is recorded.
+        Result processing then reads host memory only, so it never waits on the
+        WAR-fenced schedule stream, which by then is behind the next forward."""
+        from sglang.srt.managers.utils import _async_d2h
+
+        draft = result.next_draft_input
+        if (
+            self.spec_algorithm.is_eagle()
+            and draft is not None
+            and draft.hidden_states is not None
+            and draft.dsa_topk_indices is None
+        ):
+            result.draft_output_cpu = (
+                _async_d2h(draft.hidden_states),
+                _async_d2h(draft.topk_p),
+                _async_d2h(draft.topk_index),
+            )
+        # Page table rows [0, end) of every request; rows are written on the
+        # schedule stream before this forward, and send_kv_chunk only reads
+        # page-aligned windows that end at or before `end`.
+        # Kept on the result, not the req: the next run_batch can launch before
+        # this result is processed, and only this result's copy_done covers it.
+        page_size = self.token_to_kv_pool_allocator.page_size
+        req_to_token = self.req_to_token_pool.req_to_token
+        result.page_indices_cpu = [
+            _async_d2h(
+                req_to_token[
+                    req.req_pool_idx,
+                    0 : min(req.extend_range.end, len(req.origin_input_ids)) : page_size,
+                ]
+                // page_size
+            )
+            for req in batch.reqs
+        ]
