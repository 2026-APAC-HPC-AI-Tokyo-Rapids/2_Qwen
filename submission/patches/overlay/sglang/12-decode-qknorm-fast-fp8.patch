--- /dev/null
+++ b/python/sglang/kernels/jit/csrc/elementwise/decode_fp8_check.cuh
@@ -0,0 +1,23 @@
+// Test-only JIT module: compare the installed helper with CUDA's old NOSAT path.
+// Kept separate from the serving module so the software reference is not emitted there.
+#include "rope.cuh"
+
+namespace {
+__global__ void decode_fp8_check_kernel(const bf16x2_t* input, uint16_t* reference, uint16_t* actual) {
+  const unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
+  const auto value = input[i];
+  reference[i] = __nv_cvt_float2_to_fp8x2(device::cast<fp32x2_t>(value), __NV_NOSAT, __NV_E4M3);
+  actual[i] = to_fp8x2(value);
+}
+
+struct DecodeFP8Check {
+  static void run(tvm::ffi::TensorView input, tvm::ffi::TensorView reference, tvm::ffi::TensorView actual) {
+    using namespace host;
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+    TensorMatcher({65536, 2}).with_dtype<bf16_t>().with_device(device).verify(input);
+    TensorMatcher({65536}).with_dtype<uint16_t>().with_device(device).verify(reference).verify(actual);
+    LaunchKernel(256, 256, device.unwrap())(decode_fp8_check_kernel, static_cast<const bf16x2_t*>(input.data_ptr()), static_cast<uint16_t*>(reference.data_ptr()), static_cast<uint16_t*>(actual.data_ptr()));
+  }
+};
+}  // namespace
