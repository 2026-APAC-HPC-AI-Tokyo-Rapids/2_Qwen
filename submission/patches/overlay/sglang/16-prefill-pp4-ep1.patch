+++ b/python/sglang/srt/speculative/qwen_pp4.py
@@ -0,0 +1,37 @@
+"""Opt-in Qwen PP4/EP1 prefill with the existing EP4 EAGLE3 decode peer."""
+import os
+
+
+def enabled():
+    return os.environ.get("SGLANG_QWEN_PP4_EP1", "0") == "1"
+
+
+def prefill(args):
+    return enabled() and args.disaggregation_mode == "prefill" and args.pp_size == 4
+
+
+def supported(args):
+    return (
+        prefill(args) and args.tp_size == args.dp_size == args.ep_size == 1
+        and args.speculative_algorithm == "EAGLE3"
+        and args.speculative_eagle_topk == 1 and args.speculative_num_draft_tokens == 4
+        and args.speculative_num_steps == 3 and args.disable_overlap_schedule
+        and args.moe_a2a_backend == "megamoe" and args.ep_num_redundant_experts == 0
+        and not args.enable_eplb and not args.enable_two_batch_overlap
+        and not args.enable_lora and not args.speculative_use_rejection_sampling
+        and not args.speculative_adaptive
+        and args.disaggregation_transfer_backend == "nixl"
+    )
+
+
+def kv_region_ids(pool, total_layers, draft_pool=None):
+    # MHATokenToKVPool registers all K layers followed by all V layers.
+    # Draft layer numbers start after the complete target, not after a PP shard.
+    layers = list(range(pool.start_layer, pool.end_layer))
+    ids = layers + layers
+    assert len(pool.get_contiguous_buf_infos()[0]) == len(ids)
+    if draft_pool is not None:
+        draft_layers = list(range(total_layers, total_layers + draft_pool.layer_num))
+        assert len(draft_pool.get_contiguous_buf_infos()[0]) == 2 * len(draft_layers)
+        ids += draft_layers + draft_layers
+    return ids
