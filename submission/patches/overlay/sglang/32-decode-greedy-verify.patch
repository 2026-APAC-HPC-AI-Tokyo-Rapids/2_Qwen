diff --git a/python/sglang/srt/speculative/greedy_verify.py b/python/sglang/srt/speculative/greedy_verify.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/srt/speculative/greedy_verify.py
@@ -0,0 +1,111 @@
+"""Opt-in Qwen EAGLE3 greedy postprocessing; only exact FP32 operations."""
+import logging
+import os
+import torch
+from sglang.srt.environ import envs
+
+logger = logging.getLogger(__name__)
+_fallback_logged = False
+_used_logged = False
+
+
+def enabled():
+    return os.environ.get("SGLANG_DECODE_GREEDY_VERIFY", "0") == "1"
+
+
+def sparse_minimum(info):
+    """Snapshot length: overlap may advance the live penalizer before verify."""
+    if not enabled() or not info.is_all_greedy or info.penalizer_orchestrator is None:
+        return None
+    from sglang.srt.sampling.penaltylib.min_new_tokens import BatchedMinNewTokensPenalizer
+    prepared=[p for p in info.penalizer_orchestrator.penalizers.values() if p._is_prepared]
+    if len(prepared)!=1 or type(prepared[0]) is not BatchedMinNewTokensPenalizer:
+        return None
+    p=prepared[0]
+    return p.greedy_stop_ids, p.min_new_tokens, p.len_output_tokens.clone()
+
+
+def materialize_minimum(info):
+    state=info.greedy_minimum
+    if state is None:
+        return
+    stops, minimum, lengths=state
+    # Unsupported sampling retains the exact ordinary dense operation.
+    penalty=torch.zeros((stops.shape[0],info.vocab_size+1),dtype=torch.float32,device=stops.device)
+    penalty.scatter_add_(1,stops,torch.full_like(stops,float("-inf"),dtype=torch.float32))
+    info.acc_additive_penalties=torch.zeros_like(penalty[:,:info.vocab_size])
+    info.acc_additive_penalties.add_(torch.where(lengths<minimum,penalty[:,:info.vocab_size],0.0))
+    info.greedy_minimum=None
+
+
+def fallback(reason):
+    global _fallback_logged
+    if not _fallback_logged:
+        logger.warning("Decode greedy verify fallback: %s", reason)
+        _fallback_logged = True
+    return False
+
+
+def logits_eligible(logits, vocab, softcap=None):
+    if not enabled():
+        return False
+    checks = (
+        (logits.is_cuda, "logits are not CUDA"),
+        (logits.dtype == torch.bfloat16, "logits dtype is not BF16"),
+        (logits.ndim == 2 and 0 < vocab <= 2147479552 and logits.shape[1] == vocab, f"logits shape {tuple(logits.shape)} does not match supported model vocab {vocab}"),
+        (logits.ndim == 2 and logits.stride(1) == 1 and vocab <= logits.stride(0) <= 2147483647, "unsupported logits stride"),
+        (not softcap, "final logit softcapping is enabled"),
+    )
+    for valid, reason in checks:
+        if not valid:
+            return fallback(reason)
+    return True
+
+
+def eligible(logits, info, verify, batch, grammar_mask):
+    if not logits_eligible(logits, info.vocab_size):
+        return False
+    checks = (
+        (1 <= len(batch.seq_lens) <= 48 and logits.shape[0] == 4 * len(batch.seq_lens), "requires B1..48 and Q4 logits rows"),
+        (batch.spec_algorithm.is_eagle3() and batch.forward_mode.is_target_verify(), "requires EAGLE3 target verify"),
+        (verify.draft_token_num == 4, "requires four draft tokens"),
+        (info.is_all_greedy, "sampling is not all greedy"),
+        (info.acc_additive_penalties is None and info.acc_scaling_penalties is None, "unsupported dense penalties"),
+        (info.logit_bias is None, "logit bias is enabled"),
+        (grammar_mask is None, "grammar mask is enabled"),
+        (not batch.return_logprob, "logprobs are requested"),
+        (not envs.SGLANG_ENABLE_ASYNC_ASSERT.get(), "async assert is enabled"),
+    )
+    for valid, reason in checks:
+        if not valid:
+            return fallback(reason)
+    return True
+
+
+class GreedyWorkspace:
+    """Owned by caller/graph closure; no per-replay allocation or stale host state."""
+    def __init__(self, logits, state):
+        from sglang.srt.layers.attention.decode_fa3_verify import load
+        load()
+        rows,vocab=logits.shape
+        self.partial=torch.empty(rows*((vocab+4095)//4096)*8,dtype=torch.uint8,device=logits.device)
+        self.output=torch.empty(rows,dtype=torch.int64,device=logits.device)
+        self.penalty=state is not None
+        if state is None:
+            b=rows//4
+            state=(torch.empty((b,0),dtype=torch.int64,device=logits.device),torch.zeros((b,1),dtype=torch.int32,device=logits.device),torch.zeros((b,1),dtype=torch.int32,device=logits.device))
+        self.state=state
+        self.sanitize=envs.SGLANG_SANITIZE_NAN_LOGITS.get()
+
+    def run(self, logits):
+        global _used_logged
+        torch.ops.apac_fa3_verify.greedy_argmax(logits,*self.state,self.partial,self.output,self.penalty,self.sanitize)
+        if not _used_logged:
+            logger.info("Decode greedy verify using fused kernels greedy_tiles/greedy_finish: rows=%d vocab=%d stride=%d", logits.shape[0], logits.shape[1], logits.stride(0))
+            _used_logged = True
+        return self.output
+
+
+def target_argmax(logits, info):
+    workspace=GreedyWorkspace(logits,info.greedy_minimum)
+    return workspace.run(logits)
