+"""Pinned-image TARGET_VERIFY experiments, never selected by serving.
+
+Planning/indices are per-step work, excluded from the per-layer timer. Q casts
+and decode assembly ARE timed. Rebuild cases after changing lengths/page IDs.
+"""
+import torch
+from sgl_kernel.flash_attn import flash_attn_with_kvcache, get_scheduler_metadata
+
+BATCHES = (32, 33, 34, 35, 36)
+
+
+def prepare_metadata(common):
+    return get_scheduler_metadata(batch_size=common["cache_seqlens"].numel(), max_seqlen_q=4, max_seqlen_k=common["page_table"].shape[1] * 64, num_heads=64, num_heads_k=4, headdim=128, cache_seqlens=common["cache_seqlens"], qkv_dtype=common["q"].dtype, cu_seqlens_q=common["cu_seqlens_q"], page_size=64, causal=True, num_splits=1, pack_gqa=True)
+
+
+def step_cases(common):
+    """Include one prepare plus 94 native resets vs 94 per-layer prepares."""
+    cases = {}
+    for shared in (False, True):
+        out = torch.empty_like(common["q"], dtype=torch.bfloat16)
+
+        def call(shared=shared, out=out):
+            extra = {"scheduler_metadata": prepare_metadata(common), "num_splits": 1, "pack_gqa": True} if shared else {}
+            for _ in range(94):
+                flash_attn_with_kvcache(**common, out=out, **extra)
+            return out
+
+        cases[f"fa3-verify-step94-{'shared' if shared else 'default'}"] = call
+    return cases
+
+
+def paged_indices(table, lengths):
+    counts = [(n + 63) // 64 for n in lengths]
+    indptr = [0]
+    for count in counts:
+        indptr.append(indptr[-1] + count)
+    indices = torch.cat([table[i, :count] for i, count in enumerate(counts)])
+    last = [(n - 1) % 64 + 1 for n in lengths]
+    return torch.tensor(indptr, dtype=torch.int32), indices, torch.tensor(last, dtype=torch.int32)
+
+
+def fa3_cases(common):
+    batch = common["cache_seqlens"].numel()
+    cases = {}
+    knobs = {"default": {}, "pack-gqa-on": {"pack_gqa": True}, "pack-gqa-off": {"pack_gqa": False}}
+    knobs.update({f"splits-{n}": {"num_splits": n} for n in (1, 2, 3, 4, 6, 8)})
+    for maxq in (8, 16):
+        for n in (1, 3):
+            knobs[f"maxq-{maxq}-splits-{n}"] = {"max_seqlen_q": maxq, "num_splits": n, "pack_gqa": True}
+    metadata = prepare_metadata(common)
+    knobs["sched-meta"] = {"scheduler_metadata": metadata, "num_splits": 1, "pack_gqa": True}
+    for name, extra in knobs.items():
+        args = {**common, **extra, "out": torch.empty_like(common["q"], dtype=torch.bfloat16)}
+
+        def call(args=args):
+            return flash_attn_with_kvcache(**args)
+
+        cases[f"fa3-verify-{name}"] = call
+    # Both calls write disjoint slices of the final output: no concat/copy.
+    for cut in (batch // 2, 32):
+        out = torch.empty_like(common["q"], dtype=torch.bfloat16)
+        parts = []
+        for lo, hi in ((0, cut), (cut, batch)):
+            if lo == hi:
+                continue
+            args = {**common, "q": common["q"][lo * 4:hi * 4], "out": out[lo * 4:hi * 4], "page_table": common["page_table"][lo:hi], "cache_seqlens": common["cache_seqlens"][lo:hi], "cu_seqlens_q": common["cu_seqlens_q"][:hi - lo + 1], "cu_seqlens_k_new": common["cu_seqlens_k_new"][lo:hi + 1] - common["cu_seqlens_k_new"][lo], "num_splits": 1}
+            parts.append(args)
+
+        def split_call(parts=parts, out=out):
+            for args in parts:
+                flash_attn_with_kvcache(**args)
+            return out
+
+        cases[f"fa3-verify-batch-cut-{cut}"] = split_call
+    return cases
+
+
+def alternative_cases(common):
+    from flashinfer import (
+        BatchDecodeWithPagedKVCacheWrapper,
+        BatchPrefillWithPagedKVCacheWrapper,
+    )
+    from sglang.kernels.ops.attention.extend_attention import (
+        extend_attention_fwd_unified,
+    )
+
+    q, kc, vc = (common[k] for k in ("q", "k_cache", "v_cache"))
+    assert q.dtype == kc.dtype == vc.dtype == torch.float8_e4m3fn
+    lengths = common["cache_seqlens"].cpu().tolist()
+    table, device = common["page_table"], q.device
+    workspace = torch.empty(128 * 1024 * 1024, dtype=torch.uint8, device=device)
+    indptr, indices, last = paged_indices(table, lengths)
+    cases = {}
+    for backend, dtype, split_pages in (("fa2", torch.bfloat16, None), ("fa2", torch.bfloat16, 16), ("fa2", torch.bfloat16, 32), ("fa3", q.dtype, None)):
+        wrapper = BatchPrefillWithPagedKVCacheWrapper(workspace, kv_layout="NHD", backend=backend)
+        wrapper.plan(common["cu_seqlens_q"].cpu(), indptr, indices, last, 64, 4, 128, 64, causal=True, sm_scale=128**-0.5, q_data_type=dtype, kv_data_type=kc.dtype, o_data_type=torch.bfloat16, fixed_split_size=split_pages)
+        out = torch.empty_like(q, dtype=torch.bfloat16)
+
+        def prefill(wrapper=wrapper, dtype=dtype, out=out):
+            return wrapper.run(q.to(dtype), (kc, vc), out=out)
+
+        suffix = "" if split_pages is None else f"-pages{split_pages}"
+        cases[f"flashinfer-prefill-{backend}{suffix}"] = prefill
+    # q_len=4 decode is not a causal mask. Four q_len=1 calls at L-3..L
+    # preserve all four verify rows, at the cost of four KV reads.
+    decoders = []
+    for token in range(4):
+        ptr, ids, tail = paged_indices(table, [n - 3 + token for n in lengths])
+        wrapper = BatchDecodeWithPagedKVCacheWrapper(workspace, kv_layout="NHD", use_tensor_cores=False)
+        wrapper.plan(ptr, ids, tail, 64, 4, 128, 64, q_data_type=torch.bfloat16, kv_data_type=kc.dtype, o_data_type=torch.bfloat16, sm_scale=128**-0.5)
+        decoders.append(wrapper)
+
+    def decode_four():
+        bfq = q.bfloat16().view(-1, 4, 64, 128)
+        outputs = [wrapper.run(bfq[:, i].contiguous(), (kc, vc)) for i, wrapper in enumerate(decoders)]
+        return torch.stack(outputs, dim=1).view_as(q)
+
+    cases["flashinfer-decode-four-causal"] = decode_four
+    slots = torch.cat([(table[i, torch.arange(n, device=device) // 64].long() * 64 + torch.arange(n, device=device) % 64).to(torch.int32) for i, n in enumerate(lengths)])
+    prefix = common["cache_seqlens"] - 4
+    out = torch.empty_like(q, dtype=torch.bfloat16)
+
+    def triton_call():
+        extend_attention_fwd_unified(q.bfloat16(), out, kc, vc, 1.0, 1.0, common["cu_seqlens_q"], common["cu_seqlens_k_new"], slots, prefix, 4, sm_scale=128**-0.5, is_causal=True, page_size=64)
+        return out
+
+    cases["triton-unified-verify"] = triton_call
+    return cases
+
+
+def make_inputs(batch, boundary=False):
+    gen = torch.Generator(device="cuda").manual_seed(batch)
+    lengths = torch.randint(3900, 4200, (batch,), device="cuda", dtype=torch.int32, generator=gen)
+    if boundary:
+        lengths[:8] = torch.tensor([4, 63, 64, 65, 95, 96, 97, 128], device="cuda", dtype=torch.int32)
+    pages_per_req = (int(lengths.max()) + 63) // 64
+    pages = batch * pages_per_req + 1
+    table = (torch.randperm(pages - 1, device="cuda", generator=gen) + 1).view(batch, pages_per_req).int()
+    kc = (torch.randn(pages, 64, 4, 128, device="cuda", generator=gen) * 2).to(torch.float8_e4m3fn)
+    vc = (torch.randn(pages, 64, 4, 128, device="cuda", generator=gen) * 2).to(torch.float8_e4m3fn)
+    q = (torch.randn(batch * 4, 64, 128, device="cuda", generator=gen) * 2).to(torch.float8_e4m3fn)
+    cu_q = torch.arange(0, batch * 4 + 1, 4, device="cuda", dtype=torch.int32)
+    cu_k = torch.nn.functional.pad(lengths.cumsum(0, dtype=torch.int32), (1, 0))
+    return {"q": q, "k_cache": kc, "v_cache": vc, "page_table": table, "cache_seqlens": lengths, "cu_seqlens_q": cu_q, "cu_seqlens_k_new": cu_k, "max_seqlen_q": 4, "softmax_scale": 128**-0.5, "causal": True}
