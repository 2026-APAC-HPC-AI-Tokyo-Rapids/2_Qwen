+    def _get_verify_scheduler_metadata(
+        self, q, key_cache, layer, forward_batch, causal, window_size,
+        use_cascade_attn, use_local_attn,
+    ):
+        """One prepare per verify forward, including one node per graph replay.
+
+        Deliberately narrow: the bounded DP4 Qwen verify geometry has static
+        split capacity 1. Other decode/DP/CP paths retain their existing guard.
+        """
+        metadata = self.forward_metadata
+        batch = metadata.cache_seqlens_int32.numel()
+        if not (
+            self.fa_impl_ver == 3 and self._get_scheduler_metadata is not None
+            and not self.use_mla and self.attn_cp_size == 1
+            and forward_batch.forward_mode.is_target_verify() and self.topk <= 1
+            and getattr(forward_batch.spec_info, "ragged_verify_layout", None) is None
+            and 32 <= batch <= 36 and metadata.max_seq_len_q == 4
+            and self.page_size == 64
+            and (layer.tp_q_head_num, layer.tp_k_head_num, layer.tp_v_head_num) == (64, 4, 4)
+            and (layer.head_dim, layer.v_head_dim) == (128, 128)
+            and q.numel() == batch * 4 * 64 * 128
+            and q.dtype == key_cache.dtype == torch.float8_e4m3fn
+            and causal and window_size == (-1, -1) and layer.logit_cap == 0
+            and not layer.is_cross_attention and not use_cascade_attn and not use_local_attn
+        ):
+            return None
+        if metadata.verify_scheduler_metadata is None:
+            metadata.verify_scheduler_metadata = self._get_scheduler_metadata(
+                batch_size=batch, max_seqlen_q=4,
+                max_seqlen_k=metadata.page_table.shape[1] * self.page_size,
+                num_heads=layer.tp_q_head_num, num_heads_k=layer.tp_k_head_num,
+                headdim=layer.head_dim, cache_seqlens=metadata.cache_seqlens_int32,
+                qkv_dtype=q.dtype, cu_seqlens_q=metadata.cu_seqlens_q,
+                page_size=self.page_size, causal=True, has_softcap=False,
+                num_splits=1, pack_gqa=True,
+            )
+        return metadata.verify_scheduler_metadata
+
