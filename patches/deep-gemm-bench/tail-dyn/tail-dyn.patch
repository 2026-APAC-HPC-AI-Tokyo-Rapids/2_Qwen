+// Qwen Prefill (single expert wave): FC1 blocks keep the static round-robin
+// assignment, FC2 blocks are claimed dynamically. With the static split the
+// CTAs of a rank finish the last FC2 wave tens of microseconds apart (uneven
+// FC1 block counts, staggered first dispatch arrivals) and the combine waits
+// for the slowest; claiming FC2 blocks in order evens that out without
+// changing what any block computes.
+// `get_l2_block()` returns the next FC2 block of this CTA already decoded:
+// x = local expert << 24 | n block << 16 | m block, y = expert pool block
+// offset << 16 | expert token count, or x = ~0 when the wave is exhausted.
+// One role claims and decodes (`sm90_fp8_mega_moe_decode_l2_block`), the
+// others receive the same words, so the consumers keep no scheduler state live
+// across FC2 blocks.
+template <uint32_t kNumSMs, uint32_t kNumL1BlockNs, uint32_t kNumL1BlockKs, uint32_t kNumL2BlockKs,
+          typename Scheduler, typename GetL2Block, typename L1Func, typename L2Func>
+CUTLASS_DEVICE void sm90_fp8_mega_moe_for_each_block_dynamic_l2(
+    Scheduler& scheduler, GetL2Block&& get_l2_block, L1Func&& l1_func, L2Func&& l2_func) {
+    scheduler.fetch_expert_recv_count();
+    scheduler.set_expert_idx(0);
+
+    while (scheduler.fetch_next_l1_block()) {
+        const uint32_t n_block_idx = scheduler.block_idx - scheduler.m_block_idx * kNumL1BlockNs;
+        scheduler.block_idx += kNumSMs;
+        l1_func(scheduler.current_local_expert_idx, kNumL1BlockKs, scheduler.m_block_idx, n_block_idx);
+    }
+
+    scheduler.set_expert_idx(0);
+    scheduler.block_idx = 0;
+    while (true) {
+        const uint2 info = get_l2_block();
+        if (info.x == 0xffffffffu)
+            break;
+        scheduler.current_local_expert_idx = info.x >> 24;
+        scheduler.m_block_idx = info.x & 0xffffu;
+        scheduler.current_pool_block_offset = info.y >> 16;
+        scheduler.current_num_tokens = info.y & 0xffffu;
+        l2_func(info.x >> 24, kNumL2BlockKs, info.x & 0xffffu, (info.x >> 16) & 0xffu);
+    }
+}
+
+// Decode a claimed FC2 block index (strictly increasing per CTA) with the
+// scheduler's expert walk; `scheduler.block_idx` holds the index relative to
+// the current expert and `prev_l2_block_idx` the previous claim.
+template <uint32_t kNumL2BlockNs, typename Scheduler>
+CUTLASS_DEVICE uint2 sm90_fp8_mega_moe_decode_l2_block(
+    Scheduler& scheduler, const uint32_t& l2_block_idx, uint32_t& prev_l2_block_idx) {
+    scheduler.block_idx += l2_block_idx - prev_l2_block_idx;
+    prev_l2_block_idx = l2_block_idx;
+    while (scheduler.block_idx >= scheduler.get_current_num_m_blocks() * kNumL2BlockNs) {
+        scheduler.block_idx -= scheduler.get_current_num_m_blocks() * kNumL2BlockNs;
+        scheduler.advance_expert_idx();
+    }
+    const uint32_t m_block_idx = scheduler.block_idx / kNumL2BlockNs;
+    const uint32_t n_block_idx = scheduler.block_idx - m_block_idx * kNumL2BlockNs;
+    return make_uint2((scheduler.current_local_expert_idx << 24) | (n_block_idx << 16) | m_block_idx,
+                      (scheduler.current_pool_block_offset << 16) | scheduler.current_num_tokens);
+}
