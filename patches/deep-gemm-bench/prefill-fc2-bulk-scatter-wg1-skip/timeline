+#pragma once
+
+// Bench-only v4 records: same launch/workspace/SMEM allocation, per-WG FC2 transport counters.
+// uint64 header[16], events[CTA][50][ns,clock64], counters[CTA][44].
+// A WG leader owns 11 counters; 176 bytes fit below the ring at offset 768 for E<=140.
+// No cross-WG clock assumptions: CTA clocks are calibrated against globaltimer.
+#include <cstdint>
+#include <cutlass/cutlass.h>
+
+namespace deep_gemm::sm90_timeline {
+constexpr uint64_t kMagic = 0x314c544d4f45474dull;
+constexpr uint32_t kHeaderWords = 16, kEventsPerWG = 9, kCountersPerWG = 11;
+constexpr uint32_t kWGStart = 14, kNumEvents = kWGStart + 4 * kEventsPerWG;
+constexpr uint32_t kNumCounters = 4 * kCountersPerWG;
+enum Event : uint32_t {
+    kEntry, kDispCount, kDispSendCount, kDispGridSync, kDispRecvCount,
+    kDispPrePullBarrier, kDispEpilogueSync, kDispFirstPull, kDispLastPull,
+    kDispLoopExit, kDispCombineSync, kDispClean, kReserved, kDispExit,
+};
+enum WGEvent : uint32_t {
+    kStart, kFirstFC1, kLastFC1, kFirstFC2, kLastFC2, kLoopExit, kDrainEnd, kBarrierEnd, kCombineEnd,
+};
+enum Counter : uint32_t {
+    kFC1Blocks, kFC2Blocks, kFC1Wait, kFC2Wait, kFC1Loop, kFC2Loop, kFC1Epilogue, kFC2Epilogue, kML2Scatter, kML2RowWait, kML2Drain,
+};
+CUTLASS_DEVICE uint64_t global_ns() {
+    uint64_t t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t) :: "memory");
+    return t;
+}
+CUTLASS_DEVICE uint64_t cycles64() {
+    uint64_t c;
+    asm volatile("mov.u64 %0, %%clock64;" : "=l"(c) :: "memory");
+    return c;
+}
+CUTLASS_DEVICE uint32_t cycles() {
+    uint32_t c;
+    asm volatile("mov.u32 %0, %%clock;" : "=r"(c) :: "memory");
+    return c;
+}
+struct Timeline {
+    uint64_t* base;
+    CUTLASS_DEVICE explicit Timeline(const void* end) {
+        base = reinterpret_cast<uint64_t*>((reinterpret_cast<uint64_t>(end) + 4095) / 4096 * 4096);
+    }
+    CUTLASS_DEVICE uint64_t* event_ptr(uint32_t event) const {
+        return base + kHeaderWords + (static_cast<uint64_t>(blockIdx.x) * kNumEvents + event) * 2;
+    }
+    CUTLASS_DEVICE void record(uint32_t event) const {
+        const auto ns = global_ns();
+        const auto clk = cycles64();
+        auto p = event_ptr(event);
+        p[0] = ns;
+        p[1] = clk;
+    }
+    CUTLASS_DEVICE void record_first(uint32_t event) const {
+        if (event_ptr(event)[0] == 0)
+            record(event);
+    }
+    CUTLASS_DEVICE void record_max(uint32_t event) const {
+        const auto ns = global_ns();
+        const auto clk = cycles64();
+        auto p = reinterpret_cast<unsigned long long*>(event_ptr(event));
+        atomicMax(p, static_cast<unsigned long long>(ns));
+        atomicMax(p + 1, static_cast<unsigned long long>(clk));
+    }
+    CUTLASS_DEVICE void counter(uint32_t index, uint64_t value) const {
+        base[kHeaderWords + static_cast<uint64_t>(gridDim.x) * kNumEvents * 2 + static_cast<uint64_t>(blockIdx.x) * kNumCounters + index] = value;
+    }
+    CUTLASS_DEVICE void header(uint32_t tokens, uint32_t rank, uint32_t m, uint32_t n, uint32_t math_threads,
