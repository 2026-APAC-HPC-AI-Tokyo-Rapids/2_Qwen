+                        tokio::time::timeout(EARLY_STREAM_WAIT, stream.next())
+                            .await
+                            .unwrap(),
+                        Some(Err(_))
+                    ));
+                } else {
+                    let response = tokio::time::timeout(EARLY_STREAM_WAIT, &mut h.dispatch)
+                        .await
+                        .unwrap()
+                        .unwrap();
+                    assert_eq!(response.status(), StatusCode::BAD_GATEWAY);
+                    drop(response);
+                }
+                drop(stream);
+            }
+            tokio::time::timeout(EARLY_STREAM_WAIT, p_tx.closed())
+                .await
+                .expect("Decode failure must cancel the pending Prefill HTTP body");
+            early_stream_wait_load(&h.prefill, 0).await;
+            early_stream_wait_load(&h.decode, 0).await;
