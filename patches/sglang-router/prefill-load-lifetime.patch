+    async fn test_early_chat_content_before_prefill_headers_and_full_body_load() {
+        use futures_util::StreamExt;
+        let mut h = early_stream_start(true, false).await;
+        let d_tx = early_stream_body(h.d_response.take().unwrap());
+        d_tx.send(Ok(bytes::Bytes::from_static(EARLY_STREAM_CONTENT)))
+            .unwrap();
+
+        // Prefill's HTTP response sender is still held: even its headers are gated.
+        // This is the principal red/green regression against the stock barrier.
+        let response = tokio::time::timeout(EARLY_STREAM_WAIT, &mut h.dispatch)
+            .await
+            .expect("valid Decode content must release the response before Prefill headers")
+            .unwrap();
+        assert_eq!(response.status(), StatusCode::OK);
+        assert_eq!(h.prefill.load(), 1);
+        assert_eq!(h.decode.load(), 1);
+        let mut stream = response.into_body().into_data_stream();
+        let mut actual = early_stream_prefix(&mut stream, EARLY_STREAM_CONTENT).await;
+
+        let p_tx = early_stream_body(h.p_response.take().unwrap());
+        p_tx.send(Ok(bytes::Bytes::from_static(b"partial Prefill body")))
+            .unwrap();
+        let second = b"data: {\"choices\":[{\"delta\":{\"content\":\" world\"}}]}\n\n";
+        d_tx.send(Ok(bytes::Bytes::from_static(second))).unwrap();
+        actual.extend(early_stream_prefix(&mut stream, second).await);
+        assert_eq!(
+            h.prefill.load(),
+            1,
+            "partial Prefill body cannot release its load"
+        );
+        drop(p_tx);
+        early_stream_wait_load(&h.prefill, 0).await;
+        assert_eq!(h.decode.load(), 1, "Decode body is still open");
+
+        d_tx.send(Ok(bytes::Bytes::from_static(EARLY_STREAM_DONE)))
+            .unwrap();
+        actual.extend(early_stream_prefix(&mut stream, EARLY_STREAM_DONE).await);
+        assert!(tokio::time::timeout(EARLY_STREAM_WAIT, stream.next())
+            .await
+            .unwrap()
+            .is_none());
+        assert_eq!(
+            actual,
+            [EARLY_STREAM_CONTENT, second, EARLY_STREAM_DONE].concat()
+        );
+        drop(stream);
+        early_stream_wait_load(&h.decode, 0).await;
+    }
