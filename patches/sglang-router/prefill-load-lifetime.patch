+    async fn early_stream_start(is_stream: bool, return_logprob: bool) -> EarlyStreamHarness {
+        let (p_url, p_seen, p_response, p_server) = controlled_server().await;
+        let (d_url, d_seen, d_response, d_server) = controlled_server().await;
+        let prefill: Arc<dyn Worker> = Arc::from(create_test_worker(
+            p_url,
+            WorkerType::Prefill {
+                bootstrap_port: None,
+            },
+            true,
+        ));
+        let decode: Arc<dyn Worker> =
+            Arc::from(create_test_worker(d_url, WorkerType::Decode, true));
+        let (p, d) = (prefill.clone(), decode.clone());
+        let router = create_test_pd_router();
+        let dispatch = tokio::spawn(async move {
+            router
+                .execute_dual_dispatch_internal(
+                    None,
+                    json!({"stream": is_stream, "logprobs": return_logprob}),
+                    PDRequestContext {
+                        route: "/v1/chat/completions",
+                        batch_size: None,
+                        is_stream,
+                        return_logprob,
+                        request_text: None,
+                        model_id: None,
+                        headers: None,
+                    },
+                    p,
+                    d,
+                    Instant::now(),
+                )
+                .await
+        });
+        let harness = EarlyStreamHarness {
+            prefill,
+            decode,
+            p_response: Some(p_response),
+            d_response: Some(d_response),
+            dispatch,
+            p_server,
+            d_server,
+        };
+        tokio::time::timeout(EARLY_STREAM_WAIT, async {
+            p_seen.await.unwrap();
+            d_seen.await.unwrap();
+        })
+        .await
+        .expect("both local upstream requests must start");
+        assert_eq!(harness.prefill.load(), 1);
+        harness
+    }
+
+    fn early_stream_body(response: tokio::sync::oneshot::Sender<Response>) -> EarlyStreamSender {
+        let (tx, rx) = tokio::sync::mpsc::unbounded_channel();
+        response
+            .send(Response::new(Body::from_stream(
+                UnboundedReceiverStream::new(rx),
+            )))
+            .unwrap();
+        tx
+    }
+
+    async fn early_stream_wait_load(worker: &Arc<dyn Worker>, expected: usize) {
+        tokio::time::timeout(EARLY_STREAM_WAIT, async {
+            while worker.load() != expected {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("worker reservation did not reach the expected load");
+    }
+
+    async fn early_stream_prefix<S, E>(stream: &mut S, expected: &[u8]) -> Vec<u8>
+    where
+        S: futures_util::Stream<Item = Result<bytes::Bytes, E>> + Unpin,
+        E: std::fmt::Debug,
+    {
+        use futures_util::StreamExt;
+        let mut actual = Vec::new();
+        tokio::time::timeout(EARLY_STREAM_WAIT, async {
+            while actual.len() < expected.len() {
+                actual.extend_from_slice(&stream.next().await.expect("body ended early").unwrap());
+            }
+        })
+        .await
+        .expect("model output was not readable while Prefill was pending");
+        assert_eq!(
+            actual, expected,
+            "forwarding must preserve every original byte"
+        );
+        actual
+    }
