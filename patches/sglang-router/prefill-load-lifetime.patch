+    // Preserve byte framing (including split UTF-8 and CRLF) while looking for
+    // complete SSE events. A TCP chunk is not necessarily one event.
+    fn take_sse_frame(buffer: &mut bytes::BytesMut) -> Option<bytes::Bytes> {
+        let mut line_start = 0;
+        for (i, &byte) in buffer.iter().enumerate() {
+            if byte == b'\n' {
+                if i == line_start || (i == line_start + 1 && buffer[line_start] == b'\r') {
+                    return Some(buffer.split_to(i + 1).freeze());
+                }
+                line_start = i + 1;
+            }
+        }
+        None
+    }
