+    #[test]
+    fn test_prefill_min_load_checks_all_groups_and_tracks_release() {
+        use crate::config::ManualAssignmentMode;
+        use crate::policies::{ManualConfig, ManualPolicy};
+
+        let policy = ManualPolicy::with_config(ManualConfig {
+            assignment_mode: ManualAssignmentMode::MinLoad,
+            eviction_interval_secs: 0,
+            ..Default::default()
+        });
+        let workers: Vec<Arc<dyn Worker>> = (0..3)
+            .map(|i| {
+                Arc::from(create_test_worker(
+                    format!("http://p{i}"),
+                    WorkerType::Prefill {
+                        bootstrap_port: None,
+                    },
+                    true,
+                ))
+            })
+            .collect();
+        let pick = || {
+            PDRouter::pick_worker_by_policy_arc(&workers, &policy, None, None, None, "prefill")
+                .unwrap()
+        };
+        let mut guards: Vec<Vec<WorkerLoadGuard>> = [12, 3, 5]
+            .iter()
+            .enumerate()
+            .map(|(i, count)| {
+                (0..*count)
+                    .map(|_| WorkerLoadGuard::new(workers[i].clone(), None))
+                    .collect()
+            })
+            .collect();
+        // The official client sends no sticky-routing header. Inspect all three
+        // groups, including when a two-choice policy could miss the minimum.
+        for _ in 0..128 {
+            assert_eq!(pick().url(), workers[1].url());
+        }
+        guards[0].clear();
+        assert_eq!(pick().url(), workers[0].url());
+        workers[0].set_healthy(false);
+        assert_eq!(pick().url(), workers[1].url());
+        workers[0].set_healthy(true);
+        guards.clear();
+        let mut burst = Vec::new();
+        for _ in 0..192 {
+            burst.push(WorkerLoadGuard::new(pick(), None));
+            let loads: Vec<usize> = workers.iter().map(|w| w.load()).collect();
+            assert!(loads.iter().max().unwrap() - loads.iter().min().unwrap() <= 1);
+        }
+        drop(burst);
+        assert!(workers.iter().all(|w| w.load() == 0));
+    }
