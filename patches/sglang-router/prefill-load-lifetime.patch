+    // Append inside pd_router.rs's existing `mod tests`. CPU/local HTTP only.
+    // Every regression enters the existing dual-dispatch API; no new parser or pump
+    // helper is called, so the fragment also compiles against the stock baseline.
+    const EARLY_STREAM_WAIT: std::time::Duration = std::time::Duration::from_secs(2);
+    const EARLY_STREAM_PENDING: std::time::Duration = std::time::Duration::from_millis(35);
+    const EARLY_STREAM_CONTENT: &[u8] =
+        b"data: {\"choices\":[{\"delta\":{\"content\":\"hello\"},\"finish_reason\":null}]}\n\n";
+    const EARLY_STREAM_ROLE: &[u8] =
+    b": keepalive\r\n\r\ndata: {\"choices\":[{\"delta\":{\"role\":\"assistant\"},\"finish_reason\":null}]}\r\n\r\n";
+    const EARLY_STREAM_DONE: &[u8] = b"data: [DONE]\n\n";
+
+    type EarlyStreamSender =
+        tokio::sync::mpsc::UnboundedSender<Result<bytes::Bytes, std::io::Error>>;
+
+    struct EarlyStreamHarness {
+        prefill: Arc<dyn Worker>,
+        decode: Arc<dyn Worker>,
+        p_response: Option<tokio::sync::oneshot::Sender<Response>>,
+        d_response: Option<tokio::sync::oneshot::Sender<Response>>,
+        dispatch: tokio::task::JoinHandle<Response>,
+        p_server: tokio::task::JoinHandle<()>,
+        d_server: tokio::task::JoinHandle<()>,
+    }
+
+    impl Drop for EarlyStreamHarness {
+        fn drop(&mut self) {
+            self.dispatch.abort();
+            // Complete any intentionally withheld fake response before stopping
+            // its listener; the handler should not panic on a cancelled fixture.
+            for sender in [self.p_response.take(), self.d_response.take()]
+                .into_iter()
+                .flatten()
+            {
+                let _ = sender.send(Response::new(Body::empty()));
+            }
+            self.p_server.abort();
+            self.d_server.abort();
+        }
+    }
