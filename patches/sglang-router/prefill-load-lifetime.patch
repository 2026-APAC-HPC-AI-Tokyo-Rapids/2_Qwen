+            .is_err());
+        d_tx.send(Ok(bytes::Bytes::from_static(b"\n"))).unwrap();
+        let response = tokio::time::timeout(EARLY_STREAM_WAIT, &mut h.dispatch)
+            .await
+            .unwrap()
+            .unwrap();
+        let mut stream = response.into_body().into_data_stream();
+        let mut actual =
+            early_stream_prefix(&mut stream, &[EARLY_STREAM_ROLE, content].concat()).await;
+        assert_eq!(h.prefill.load(), 1);
+        for fragment in [
+            b"data: [DO".as_slice(),
+            b"NE]\r\n\r".as_slice(),
+            b"\n".as_slice(),
+        ] {
+            d_tx.send(Ok(bytes::Bytes::copy_from_slice(fragment)))
+                .unwrap();
+            assert!(
+                tokio::time::timeout(EARLY_STREAM_PENDING, stream.next())
+                    .await
+                    .is_err(),
+                "neither a partial terminal frame nor a complete terminal before Prefill may leak"
+            );
+        }
+        h.p_response
+            .take()
+            .unwrap()
+            .send(Response::new(Body::from("{}")))
+            .unwrap();
+        let done = b"data: [DONE]\r\n\r\n";
+        actual.extend(early_stream_prefix(&mut stream, done).await);
+        assert!(tokio::time::timeout(EARLY_STREAM_WAIT, stream.next())
+            .await
+            .unwrap()
+            .is_none());
+        assert_eq!(actual, [EARLY_STREAM_ROLE, content, done].concat());
+        drop(stream);
+        early_stream_wait_load(&h.prefill, 0).await;
+        early_stream_wait_load(&h.decode, 0).await;
+    }
+
+    #[tokio::test]
+    async fn test_early_chat_recognizes_reasoning_tool_calls_and_empty_finish() {
+        for choice in [
+            json!({"delta":{"reasoning_content":"thinking"}}),
+            json!({"delta":{"reasoning":"thinking"}}),
+            json!({"delta":{"tool_calls":[{"index":0,"id":"call_1","type":"function","function":{"name":"lookup","arguments":""}}]}}),
+            json!({"delta":{},"finish_reason":"stop"}),
+        ] {
+            let mut h = early_stream_start(true, false).await;
+            let d_tx = early_stream_body(h.d_response.take().unwrap());
+            let output = format!("data: {}\n\n", json!({"choices":[choice]})).into_bytes();
+            d_tx.send(Ok(bytes::Bytes::copy_from_slice(&output)))
+                .unwrap();
+            let response = tokio::time::timeout(EARLY_STREAM_WAIT, &mut h.dispatch)
+                .await
+                .expect("valid chat progress must release the response")
+                .unwrap();
+            let mut stream = response.into_body().into_data_stream();
+            early_stream_prefix(&mut stream, &output).await;
+            assert_eq!(h.prefill.load(), 1, "Prefill headers remain gated");
+            drop(stream);
+            early_stream_wait_load(&h.prefill, 0).await;
+            early_stream_wait_load(&h.decode, 0).await;
+            tokio::time::timeout(EARLY_STREAM_WAIT, d_tx.closed())
+                .await
+                .unwrap();
+        }
+    }
+
+    #[tokio::test]
+    async fn test_early_chat_nonstream_and_logprobs_keep_prefill_body_barrier() {
+        use futures_util::StreamExt;
+        for streaming_logprobs in [false, true] {
+            let mut h = early_stream_start(streaming_logprobs, streaming_logprobs).await;
+            let p_tx = early_stream_body(h.p_response.take().unwrap());
+            let d_tx = early_stream_body(h.d_response.take().unwrap());
+            p_tx.send(Ok(bytes::Bytes::from_static(
+                b"{\"meta_info\":{\"input_token_logprobs\":[[-0.5,7,\"prefix\"]]}}",
+            )))
+            .unwrap();
+            let decode_json = json!({
+                "choices":[{"delta":{"content":"hello"}}],
+                "meta_info":{"input_token_logprobs":[[-0.25,8,"decode"]]},
+            });
+            let expected_json = serde_json::to_vec(&decode_json).unwrap();
+            let decode_bytes = if streaming_logprobs {
+                format!("data: {decode_json}\n\n").into_bytes()
+            } else {
+                expected_json.clone()
+            };
+            d_tx.send(Ok(bytes::Bytes::from(decode_bytes))).unwrap();
+            assert!(
+                tokio::time::timeout(EARLY_STREAM_PENDING, &mut h.dispatch)
+                    .await
+                    .is_err(),
+                "nonstream and logprob requests must still wait for all Prefill body bytes"
+            );
+            assert_eq!(h.prefill.load(), 1);
+            drop(p_tx);
+            if !streaming_logprobs {
+                // Nonstream also needs Decode EOF before its response can finish.
+                drop(d_tx);
+                let response = tokio::time::timeout(EARLY_STREAM_WAIT, &mut h.dispatch)
+                    .await
+                    .unwrap()
+                    .unwrap();
+                assert_eq!(response.status(), StatusCode::OK);
+                let actual = tokio::time::timeout(
+                    EARLY_STREAM_WAIT,
+                    axum::body::to_bytes(response.into_body(), usize::MAX),
+                )
+                .await
+                .unwrap()
+                .unwrap();
+                assert_eq!(actual.as_ref(), expected_json);
+            } else {
+                let response = tokio::time::timeout(EARLY_STREAM_WAIT, &mut h.dispatch)
+                    .await
+                    .unwrap()
+                    .unwrap();
+                let mut stream = response.into_body().into_data_stream();
+                let first = tokio::time::timeout(EARLY_STREAM_WAIT, stream.next())
+                    .await
+                    .unwrap()
+                    .unwrap()
+                    .unwrap();
+                let frame = std::str::from_utf8(&first).unwrap();
+                let actual: Value =
+                    serde_json::from_str(frame.strip_prefix("data: ").unwrap().trim()).unwrap();
+                let mut expected = decode_json;
+                expected["meta_info"]["input_token_logprobs"] =
+                    json!([[-0.5, 7, "prefix"], [-0.25, 8, "decode"]]);
+                assert_eq!(
+                    actual, expected,
+                    "the existing Prefill/Decode logprob merge must survive"
+                );
+                d_tx.send(Ok(bytes::Bytes::from_static(EARLY_STREAM_DONE)))
+                    .unwrap();
+                early_stream_prefix(&mut stream, EARLY_STREAM_DONE).await;
+                assert!(tokio::time::timeout(EARLY_STREAM_WAIT, stream.next())
+                    .await
+                    .unwrap()
+                    .is_none());
+                drop(stream);
+            }
+            early_stream_wait_load(&h.prefill, 0).await;
+            early_stream_wait_load(&h.decode, 0).await;
+        }
+    }
