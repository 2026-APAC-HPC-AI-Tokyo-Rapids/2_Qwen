+    #[tokio::test]
+    async fn test_early_chat_decode_errors_cancel_prefill() {
+        use futures_util::StreamExt;
+        for failure in ["status", "event", "eof", "late_event", "late_eof"] {
+            let mut h = early_stream_start(true, false).await;
+            let p_tx = early_stream_body(h.p_response.take().unwrap());
+            p_tx.send(Ok(bytes::Bytes::from_static(b"pending Prefill")))
+                .unwrap();
+            if failure == "status" {
+                h.d_response
+                    .take()
+                    .unwrap()
+                    .send(
+                        (StatusCode::SERVICE_UNAVAILABLE, "Decode rejected request")
+                            .into_response(),
+                    )
+                    .unwrap();
+                let response = tokio::time::timeout(EARLY_STREAM_WAIT, &mut h.dispatch)
+                    .await
+                    .unwrap()
+                    .unwrap();
+                assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);
+                drop(response);
+            } else {
+                let d_tx = early_stream_body(h.d_response.take().unwrap());
+                let late = failure.starts_with("late_");
+                let mut stream = if late {
+                    d_tx.send(Ok(bytes::Bytes::from_static(EARLY_STREAM_CONTENT)))
+                        .unwrap();
+                    let response = tokio::time::timeout(EARLY_STREAM_WAIT, &mut h.dispatch)
+                        .await
+                        .unwrap()
+                        .unwrap();
+                    let mut stream = response.into_body().into_data_stream();
+                    early_stream_prefix(&mut stream, EARLY_STREAM_CONTENT).await;
+                    Some(stream)
+                } else {
+                    None
+                };
+                if failure.ends_with("event") {
+                    d_tx.send(Ok(bytes::Bytes::from_static(
+                        b"data: {\"error\":{\"message\":\"Decode aborted\"}}\n\n",
