+    // (has model output, is terminal). Role-only/keepalive events do not prove
+    // success. Empty but valid completions can establish it via finish_reason.
+    fn chat_sse_progress(frame: &[u8]) -> Result<(bool, bool), &'static str> {
+        let mut data = Vec::new();
+        for line in frame.split(|&b| b == b'\n') {
+            let line = line.strip_suffix(b"\r").unwrap_or(line);
+            if let Some(value) = line.strip_prefix(b"data:") {
+                if !data.is_empty() {
+                    data.push(b'\n');
+                }
+                data.extend_from_slice(value.strip_prefix(b" ").unwrap_or(value));
+            }
+        }
+        if data.is_empty() {
+            return Ok((false, false));
+        }
+        if data == b"[DONE]" {
+            return Ok((false, true));
+        }
+        let value: Value = serde_json::from_slice(&data).map_err(|_| "Invalid Decode SSE JSON")?;
+        if value.get("error").is_some_and(|error| !error.is_null()) {
+            return Err("Decode returned an error event");
+        }
+        let has_output = value
+            .get("choices")
+            .and_then(Value::as_array)
+            .is_some_and(|choices| {
+                choices.iter().any(|choice| {
+                    let delta = &choice["delta"];
+                    ["content", "reasoning_content", "reasoning"]
+                        .iter()
+                        .any(|key| delta[*key].as_str().is_some_and(|text| !text.is_empty()))
+                        || delta["tool_calls"]
+                            .as_array()
+                            .is_some_and(|calls| !calls.is_empty())
+                        || choice
+                            .get("finish_reason")
+                            .is_some_and(|reason| !reason.is_null())
+                })
+            });
+        Ok((has_output, false))
+    }
