diff --git a/deep_gemm/include/deep_gemm/impls/sm90_fp8_mega_moe.cuh b/deep_gemm/include/deep_gemm/impls/sm90_fp8_mega_moe.cuh
--- a/deep_gemm/include/deep_gemm/impls/sm90_fp8_mega_moe.cuh
+++ b/deep_gemm/include/deep_gemm/impls/sm90_fp8_mega_moe.cuh
@@ -1263,6 +1263,196 @@
             const bool valid_r0 = row_offset_r0 < valid_m;
             const bool valid_r1 = row_offset_r1 < valid_m;
 
+            // Included at the math tile entrance, before the ordinary accumulator is live.
+#if defined(DG_SM90_PREFILL_SWAP_TAIL) && DG_SM90_PREFILL_SWAP_TAIL
+            {
+                DG_STATIC_ASSERT(kPrefillSplitAccum and kPrefillLean and kPrefill2WG and kL2ActsSF128,
+                                 "Swap tail requires the four-stage lean split EP1 path");
+                if (valid_m <= 32 and epilogue_wg_idx == 0) {
+                    auto swap_tail = [&](auto n_c) CUTLASS_LAMBDA_FUNC_INLINE {
+                        constexpr uint32_t N = decltype(n_c)::value, C = N / 2;
+                        using TailMMA = typename mma::sm90::FP8MMASelector<N>::type;
+                        DG_STATIC_ASSERT(TailMMA::kNumAccum == C, "Swap accumulator layout");
+                        const bool l1 = block_phase == sched::BlockPhase::Linear1;
+                        const uint32_t ks = l1 ? kHidden / 128 : kIntermediateHidden / 128;
+                        const uint32_t ws0 = l1 ? local_expert_idx * 24 * 32 + n_block_idx * 32
+                                                : local_expert_idx * 32 * 12 + n_block_idx * 2 * 12;
+                        const float* ws = l1 ? l1_weights_sf : l2_weights_sf;
+                        const auto weight_desc = mma::sm90::make_smem_desc(smem_b[0], 1);
+                        const auto token_desc = mma::sm90::make_smem_desc(smem_a[0], 1);
+                        const uint64_t whi = uint64_t(weight_desc.reg32_[1]) << 32;
+                        const uint64_t thi = uint64_t(token_desc.reg32_[1]) << 32;
+                        float acc[4][C] = {};
+                        float prev_x[N / 4], prev_w[2] = {1.0f, 1.0f};
+                        #pragma unroll
+                        for (uint32_t j = 0; j < N / 4; ++j) prev_x[j] = 1.0f;
+                        auto rcp = [](float x) { return kFastMath ? math::fast_rcp(x) : 1.0f / x; };
+                        // One stage per K128, four K32 instructions per fragment, ascending K.
+                        // No ordinary K loop contains a tail predicate. No partial-sum promotion.
+                        for (uint32_t kb = 0; kb < num_k_blocks; advance_pipeline(kb)) {
+                            full_barriers[stage_idx]->wait(phase);
+                            float x[N / 4], w[2];
+                            #pragma unroll
+                            for (uint32_t i = 0; i < N / 8; ++i) {
+                                const uint32_t token = i * 8 + col_idx * 2;
+                                x[i * 2] = ptx::ld_shared(smem_sfa[stage_idx] + token);
+                                x[i * 2 + 1] = ptx::ld_shared(smem_sfa[stage_idx] + token + 1);
+                            }
+                            w[0] = __ldg(ws + ws0 + kb);
+                            w[1] = __ldg(ws + ws0 + (l1 ? 12 * 32 : 12) + kb);
+                            #pragma unroll
+                            for (uint32_t f = 0; f < 4; ++f) {
+                                #pragma unroll
+                                for (uint32_t i = 0; i < N / 8; ++i) {
+                                    #pragma unroll
+                                    for (uint32_t a = 0; a < 4; ++a) {
+                                        const uint32_t wi = l1 ? a / 2 : f / 2;
+                                        const uint32_t xi = i * 2 + a % 2;
+                                        const float ratio = (prev_x[xi] * prev_w[wi]) * rcp(x[xi] * w[wi]);
+                                        // The control rescales its zero initial accumulators by one.
+                                        acc[f][i * 4 + a] *= kb == 0 ? 1.0f : ratio;
+                                    }
+                                }
+                                #pragma unroll
+                                for (uint32_t a = 0; a < C; ++a) ptx::warpgroup_fence_operand(acc[f][a]);
+                                ptx::warpgroup_arrive();
+                                #pragma unroll
+                                for (uint32_t k = 0; k < 4; ++k) {
+                                    const uint32_t wd = weight_desc.reg32_[0] + stage_idx * (SMEM_B_SIZE_PER_STAGE / 16) + f * 64 * 128 / 16 + k * 2;
+                                    const uint32_t td = token_desc.reg32_[0] + stage_idx * (SMEM_A_SIZE_PER_STAGE / 16) + k * 2;
+                                    TailMMA::wgmma(whi | wd, thi | td, acc[f], true);
+                                }
+                                ptx::warpgroup_commit_batch();
+                                ptx::warpgroup_wait<0>();
+                                #pragma unroll
+                                for (uint32_t a = 0; a < C; ++a) ptx::warpgroup_fence_operand(acc[f][a]);
+                            }
+                            if (l1 and kb == 2) publish_l1_rows();
+                            #pragma unroll
+                            for (uint32_t j = 0; j < N / 4; ++j) prev_x[j] = x[j];
+                            prev_w[0] = w[0]; prev_w[1] = w[1];
+                            if (lane_idx == 0) empty_barriers[stage_idx]->arrive();
+                        }
+                        #pragma unroll
+                        for (uint32_t f = 0; f < 4; ++f) {
+                            #pragma unroll
+                            for (uint32_t i = 0; i < N / 8; ++i) {
+                                #pragma unroll
+                                for (uint32_t a = 0; a < 4; ++a) {
+                                    const float scale = prev_x[i * 2 + a % 2] * prev_w[l1 ? a / 2 : f / 2];
+                                    acc[f][i * 4 + a] *= scale;
+                                }
+                            }
+                        }
+                        // Use only WG0's original 9 KiB CD slice. WG1 may still be finishing
+                        // the preceding ordinary tile in its own slice. The entrance barrier
+                        // also waits for all WG0 warps' preceding ordinary staging reads.
+                        constexpr uint32_t barrier = kEpilogueWGBarrierStartIdx;
+                        auto sync = [&]() { ptx::sync_aligned(128, barrier); };
+                        sync();
+                        auto* stage = reinterpret_cast<uint8_t*>(smem_cd_l1);
+                        if (l1) {
+                            float values[4][N / 4];
+                            float maxima[N / 4] = {};
+                            #pragma unroll
+                            for (uint32_t f = 0; f < 4; ++f) {
+                                #pragma unroll
+                                for (uint32_t i = 0; i < N / 8; ++i) {
+                                    #pragma unroll
+                                    for (uint32_t t = 0; t < 2; ++t) {
+                                        float g = acc[f][i * 4 + t], u = acc[f][i * 4 + t + 2];
+                                        g = sm90_fp8_mega_moe_clamp_gate<kActivationClamp>(g);
+                                        u = sm90_fp8_mega_moe_clamp_up<kActivationClamp>(u);
+                                        float sig;
+                                        if constexpr (kFastMath) {
+                                            float e;
+                                            asm("ex2.approx.ftz.f32 %0, %1;" : "=f"(e) : "f"(g * -1.44269502162933349609375f));
+                                            asm("rcp.approx.ftz.f32 %0, %1;" : "=f"(sig) : "f"(1.0f + e));
+                                        } else sig = 1.0f / (1.0f + expf(-g));
+                                        values[f][i * 2 + t] = (g * sig) * u;
+                                        maxima[i * 2 + t] = fmaxf(maxima[i * 2 + t], fabsf(values[f][i * 2 + t]));
+                                    }
+                                }
+                            }
+                            // Each warp owns 8 feature positions for each token, over all
+                            // four fragments: 32 columns. Exchange four warp maxima, giving
+                            // the original per-token 128-column group, never per-64.
+                            auto* exchange = reinterpret_cast<float*>(stage + 4608);
+                            #pragma unroll
+                            for (uint32_t j = 0; j < N / 4; ++j) {
+                                #pragma unroll
+                                for (uint32_t mask = 4; mask <= 16; mask *= 2)
+                                    maxima[j] = fmaxf(maxima[j], __shfl_xor_sync(0xffffffff, maxima[j], mask));
+                                const uint32_t token = (j / 2) * 8 + col_idx * 2 + j % 2;
+                                if (row_idx == 0) exchange[warp_idx_in_wg * N + token] = maxima[j];
+                            }
+                            sync();
+                            #pragma unroll
+                            for (uint32_t j = 0; j < N / 4; ++j) {
+                                const uint32_t token = (j / 2) * 8 + col_idx * 2 + j % 2;
+                                float ax = 0.0f;
+                                #pragma unroll
+                                for (uint32_t w = 0; w < 4; ++w) ax = fmaxf(ax, exchange[w * N + token]);
+                                float2 sf, inv;
+                                sm90_fp8_mega_moe_get_e4m3_sf_and_sf_inv(make_float2(ax, ax), sf, inv);
+                                if (token < valid_m) {
+                                    if (warp_idx_in_wg == 0 and row_idx == 0)
+                                        l2_sf_buffer.get_base_ptr<float>()[n_block_idx * kNumPaddedSFPoolTokens + pool_block_idx * SF_BLOCK_M + token] = sf.x;
+                                    #pragma unroll
+                                    for (uint32_t f = 0; f < 4; ++f) {
+                                        const __nv_fp8_e4m3 q(values[f][j] * inv.x);
+                                        stage[token * 144 + f * 32 + warp_idx_in_wg * 8 + row_idx] = q.__x;
+                                    }
+                                }
+                            }
+                            sync();
+                            #pragma unroll
+                            for (uint32_t i = 0; i < N / 4; ++i) {
+                                const uint32_t token = i * 4 + warp_idx_in_wg;
+                                if (token < valid_m and lane_idx < 8) {
+                                    const auto chunk = *reinterpret_cast<const uint4*>(stage + token * 144 + lane_idx * 16);
+                                    *reinterpret_cast<uint4*>(l2_token_buffer.get_base_ptr<uint8_t>() + uint64_t(m_idx + token) * kIntermediateHidden + n_block_idx * 128 + lane_idx * 16) = chunk;
+                                }
+                            }
+                            sync();
+                            l1_unpublished_block = pool_block_idx;
+                        } else {
+                            // Eight-token strip: 8 * 528 = 4224 bytes, independent of N.
+                            // BF16 conversion follows final scaling, before the same slot.
+                            #pragma unroll
+                            for (uint32_t i = 0; i < N / 8; ++i) {
+                                #pragma unroll
+                                for (uint32_t f = 0; f < 4; ++f) {
+                                    #pragma unroll
+                                    for (uint32_t t = 0; t < 2; ++t) {
+                                        const uint32_t token = col_idx * 2 + t;
+                                        auto* row = reinterpret_cast<nv_bfloat16*>(stage + token * 528);
+                                        row[f * 64 + r_0] = __float2bfloat16_rn(acc[f][i * 4 + t]);
+                                        row[f * 64 + r_1] = __float2bfloat16_rn(acc[f][i * 4 + t + 2]);
+                                    }
+                                }
+                                sync();
+                                #pragma unroll
+                                for (uint32_t t = 0; t < 2; ++t) {
+                                    const uint32_t row = warp_idx_in_wg * 2 + t;
+                                    const uint32_t token = i * 8 + row;
+                                    if (token < valid_m) {
+                                        const auto meta = *workspace.get_token_src_metadata_ptr(m_idx + token);
+                                        auto* dst = sym_buffer.map(math::advance_ptr<uint4>(combine_token_buffer.get_rank_buffer(meta.topk_idx).get_data_buffer(meta.token_idx).get_base_ptr(), n_idx * sizeof(nv_bfloat16) + lane_idx * sizeof(uint4)), meta.rank_idx);
+                                        *dst = *reinterpret_cast<const uint4*>(stage + row * 528 + lane_idx * 16);
+                                    }
+                                }
+                                sync();
+                            }
+                        }
+                    };
+                    if (valid_m <= 16) swap_tail(std::integral_constant<uint32_t, 16>{});
+                    else swap_tail(std::integral_constant<uint32_t, 32>{});
+                    return;
+                }
+            }
+#endif
+
             // ---------------- GEMM ----------------
             using WGMMA = L1WGMMA;
             constexpr uint32_t kAccumPerThread = WGMMA::kNumAccum;
