+// Cross-rank barrier without grid syncs: after a CTA-wide sync, every CTA adds one to a
+// 64-bit counter on every rank with release semantics (thread r signals rank rank_idx + r),
+// so a rank has seen all of a call's writes once its counter grew by kNumSMs * kNumRanks.
+// One call's barrier completes on every rank before any rank can reach the same barrier
+// of the next call (same workspace, stream-ordered calls on every rank), so the
+// target follows from the value this CTA's own local add
+// returned; the counter only grows and is never reset. Every geometry (Prefill and
+// Decode) must use the same barriers, because one EP collective can run different
+// geometries on different ranks (the host picks the geometry from each rank's token
+// count).
+template <uint32_t kNumRanks, uint32_t kNumSMs, typename sync_scope_t>
+__forceinline__ __device__ void sm90_fp8_mega_moe_flat_nvlink_barrier(
+    uint64_t* counter, const layout::SymBuffer<kNumRanks>& sym_buffer,
+    const uint32_t& thread_idx, const bool& wait, const sync_scope_t& sync_scope) {
+    constexpr uint64_t kNumSignals = static_cast<uint64_t>(kNumSMs) * kNumRanks;
+    // Compiler barriers bracket the participating threads' hardware CTA barrier.
+    asm volatile("" ::: "memory");
+    sync_scope();
+    asm volatile("" ::: "memory");
+    uint64_t old_value = 0;
+    if (thread_idx == 0) {
+        asm volatile("atom.release.sys.global.add.u64 %0, [%1], 1;" : "=l"(old_value) : "l"(counter) : "memory");
+    } else if (thread_idx < kNumRanks) {
+        const auto remote = sym_buffer.map(counter, (sym_buffer.rank_idx + thread_idx) % kNumRanks);
+        asm volatile("red.release.sys.global.add.u64 [%0], 1;" :: "l"(remote) : "memory");
+    }
+    if (wait) {
+        if (thread_idx == 0) {
+            const uint64_t target = (old_value / kNumSignals + 1) * kNumSignals;
+            uint64_t value;
+            do {
+                asm volatile("ld.acquire.sys.global.u64 %0, [%1];" : "=l"(value) : "l"(counter) : "memory");
+            } while (value < target);
+        }
+        asm volatile("" ::: "memory");
+        sync_scope();
+        asm volatile("" ::: "memory");
+    }
 }

