+"""Qwen TP1 Prefill: FP8 attention output and specialized dense projections."""
+
+import torch
+
+
+def linear_supported(attention, projection, layer):
+    from sglang.srt.layers import deep_gemm_wrapper
+    from sglang.srt.layers.quantization.fp8 import Fp8LinearMethod
+    from sglang.srt.layers.quantization.fp8_utils import deepgemm_w8a8_block_fp8_linear_with_fallback
+
+    method = layer.quant_method
+    shape = (9216, 4096) if projection == "QKV" else (4096, 8192)
+    return (
+        attention.num_heads == attention.total_num_heads == 64
+        and attention.num_kv_heads == attention.total_num_kv_heads == 4
+        and attention.hidden_size == 4096 and attention.head_dim == 128
+        and isinstance(method, Fp8LinearMethod) and method.block_quant
+        and not method.use_marlin and not getattr(method, "use_mxfp8", False)
+        and method.weight_block_size == [128, 128]
+        and method.w8a8_block_fp8_linear is deepgemm_w8a8_block_fp8_linear_with_fallback
+        and not deep_gemm_wrapper.DEEPGEMM_SCALE_UE8M0
+        and tuple(layer.weight.shape) == shape
+        and layer.weight.dtype == torch.float8_e4m3fn and layer.weight.is_contiguous()
+        and layer.weight_scale_inv.dtype == torch.float32 and layer.bias is None
+        and torch.cuda.get_device_capability(layer.weight.device) == (9, 0)
+    )
+
+
+def linear(attention, projection, layer, x):
+    tensor = x[0] if isinstance(x, tuple) else x
+    if tensor.ndim != 2 or tensor.shape[0] < 2048 or not linear_supported(attention, projection, layer):
+        return layer(x)
+    if isinstance(x, tuple):
+        a, sa = x
+    else:
+        if x.dtype != torch.bfloat16 or not x.is_contiguous():
+            return layer(x)
+        from sglang.kernels.ops.quantization.fp8_kernel import sglang_per_token_group_quant_fp8
+
+        a, sa = sglang_per_token_group_quant_fp8(x, 128, column_major_scales=True, scale_tma_aligned=True)
+    import deep_gemm
+
+    out = torch.empty((a.shape[0], layer.weight.shape[0]), device=a.device, dtype=torch.bfloat16)
+    deep_gemm.fp8_gemm_nt((a, sa), (layer.weight, layer.weight_scale_inv), out, compiled_dims="nk")
+    return out, None
+
+
+def attention(q, k, v, cu, maxlen, softmax_scale, padded_rows):
+    from sglang.srt.layers.attention.decode_fa3_verify import load
+
+    load()
+    rows = q.shape[0]
+    assert padded_rows >= rows > 0
+    out = torch.empty((padded_rows, 64, 128), device=q.device, dtype=torch.float8_e4m3fn)
+    scales = torch.empty((64, (padded_rows + 3) // 4 * 4), device=q.device, dtype=torch.float32).T[:padded_rows]
+    lse = torch.empty((64, rows), device=q.device, dtype=torch.float32)
+    metadata = torch.empty(17, device=q.device, dtype=torch.int32)
+    torch.ops.apac_fa3_verify.prefill_fwd_out(q, k, v, cu, out, scales, lse, metadata, maxlen, softmax_scale)
+    if padded_rows > rows:
+        out[rows:].zero_()
+        scales[rows:].fill_(1.0e-10 / 448.0)
+    return out.view(padded_rows, 8192), scales
