+"""Opt-in, bounded physical top-k capture after the normal benchmark.
+
+The active marker is created only for the diagnostic pass. No tensor operations
+or collectives run outside that window. These captures invalidate timing of
+their forward calls; they do not modify routing, weights, or model outputs.
+"""
+import json
+import os
+import time
+from pathlib import Path
+
+import torch
+
+DIRECTORY = os.environ.get("SGLANG_PREFILL_ROUTING_DIR", "")
+ENABLED = bool(DIRECTORY)
+_state = None
+
+
+class CaptureState:
+    def __init__(self):
+        from sglang.srt.distributed import get_moe_ep_group
+
+        self.rank = get_moe_ep_group().rank_in_group
+        self.directory = Path(DIRECTORY)
+        self.limit = int(os.environ.get("SGLANG_PREFILL_ROUTING_SAMPLES", "8"))
+        if not 1 <= self.limit <= 8:
+            raise ValueError("Prefill routing capture requires 1..8 samples")
+        self.layers = set()
+        self.rows = {}
+        self.samples = 0
+        self.selected = False
+        self.step = None
+
+    def begin(self, step):
+        self.rows.clear()
+        self.step = step
+        self.selected = self.samples < self.limit and (self.directory / "active").exists()
+
+    def record(self, layer, ids, live_rows):
+        if not self.selected:
+            return
+        if layer in self.rows:
+            raise ValueError(f"Duplicate Prefill routing layer {layer}")
+        if live_rows is None:
+            live_rows = ids.shape[0]
+        if isinstance(live_rows, torch.Tensor):
+            live_rows = int(live_rows.item())
+        if ids.ndim != 2 or ids.shape[1] != 8 or not 0 <= live_rows <= ids.shape[0] <= 4096:
+            raise ValueError("Expected at most 4096 live Prefill rows with top-8 IDs")
+        # Copy before the routing buffers can be reused by a subsequent layer.
+        self.rows[layer] = ids[:live_rows].detach().to(dtype=torch.int32, copy=True)
+
+    def end(self):
+        if not self.selected:
+            return
+        self.selected = False
+        if set(self.rows) != self.layers or self.layers != set(range(94)):
+            raise ValueError("Prefill capture must contain every target MoE layer")
+        import numpy as np
+
+        layers = sorted(self.rows)
+        ids = torch.stack([self.rows[layer] for layer in layers]).cpu().numpy()
+        metadata = {
+            "schema": "prefill-routing/v1", "phase": "diagnostic",
+            "worker": self.directory.name, "source_ep_rank": self.rank,
+            "sample": self.samples, "target_forward_step": self.step,
+            "time_ns": time.time_ns(), "physical_experts": 140,
+            "experts_per_destination_rank": 35, "hidden_size": 4096,
+            "topk": 8, "layers": layers, "live_rows": ids.shape[1],
+        }
+        self.directory.mkdir(parents=True, exist_ok=True)
+        path = self.directory / f"rank-{self.rank}-sample-{self.samples}.npz"
+        with path.open("xb") as stream:
+            np.savez_compressed(stream, ids=ids, metadata=json.dumps(metadata))
+        self.samples += 1
+        self.rows.clear()
+
+
+class LayerCapture:
+    def __init__(self, layer):
+        global _state
+        if _state is None:
+            _state = CaptureState()
+        if layer in _state.layers:
+            raise ValueError(f"Duplicate Prefill routing layer {layer}")
+        _state.layers.add(layer)
+        self.layer = layer
+
+    def record(self, topk_ids, live_rows):
+        _state.record(self.layer, topk_ids, live_rows)
+
+
+def begin_forward(step):
+    if _state is not None:
+        _state.begin(step)
+
+
+def end_forward():
+    if _state is not None:
+        _state.end()
