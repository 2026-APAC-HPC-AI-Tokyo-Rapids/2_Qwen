+#pragma once
+#include "decode_router_kernel.cuh"
+#include <sgl_kernel/tensor.h>
+#include <sgl_kernel/utils.cuh>
+
+struct DecodeRouterGate {
+    static void run(tvm::ffi::TensorView input, tvm::ffi::TensorView weight, tvm::ffi::TensorView output) {
+        using namespace host;
+        auto rows = SymbolicSize{"rows"};
+        auto device = SymbolicDevice{};
+        device.set_options<kDLCUDA>();
+        TensorMatcher({rows, 4096}).with_dtype<__nv_bfloat16>().with_device(device).verify(input);
+        TensorMatcher({128, 4096}).with_dtype<__nv_bfloat16>().with_device(device).verify(weight);
+        TensorMatcher({rows, 128}).with_dtype<__nv_bfloat16>().with_device(device).verify(output);
+        RuntimeCheck(rows.unwrap() >= 144 && rows.unwrap() <= 176, "Decode router requires 144..176 rows");
+        LaunchKernel(dim3(((rows.unwrap() + 31) / 32) * 16), 128, device.unwrap()).enable_cluster(dim3(4, 1, 1))(decode_router::gate, static_cast<const __nv_bfloat16*>(input.data_ptr()), static_cast<const __nv_bfloat16*>(weight.data_ptr()), static_cast<__nv_bfloat16*>(output.data_ptr()), static_cast<int>(rows.unwrap()));
+    }
+};
