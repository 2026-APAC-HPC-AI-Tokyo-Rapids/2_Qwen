+#pragma once
+#include <cooperative_groups.h>
+#include <cuda_bf16.h>
+#include <mma.h>
+
+namespace decode_router {
+
+__global__ __launch_bounds__(128) void gate(const __nv_bfloat16* x, const __nv_bfloat16* w, __nv_bfloat16* y, int rows) {
+    using namespace nvcuda;
+    auto cluster = cooperative_groups::this_cluster();
+    const int rank = cluster.block_rank();
+    const int tile = blockIdx.x / 4;
+    const int row = (tile / 4) * 32;
+    const int expert = (tile % 4) * 32;
+    const int tid = threadIdx.x;
+    const int warp = tid / 32;
+    __shared__ __align__(32) __nv_bfloat16 a[32 * 64];
+    __shared__ __align__(32) __nv_bfloat16 b[32 * 64];
+    __shared__ __align__(32) float partial[32 * 32];
+    wmma::fragment<wmma::accumulator, 16, 16, 16, float> acc;
+    wmma::fill_fragment(acc, 0.0f);
+    for (int k = rank * 1024; k < (rank + 1) * 1024; k += 64) {
+        for (int i = tid; i < 32 * 8; i += 128) {
+            const int r = i / 8;
+            const int c = (i % 8) * 8;
+            reinterpret_cast<uint4*>(a)[i] = row + r < rows ? *reinterpret_cast<const uint4*>(x + (row + r) * 4096 + k + c) : uint4{};
+            reinterpret_cast<uint4*>(b)[i] = *reinterpret_cast<const uint4*>(w + (expert + r) * 4096 + k + c);
+        }
+        __syncthreads();
+#pragma unroll
+        for (int kk = 0; kk < 64; kk += 16) {
+            wmma::fragment<wmma::matrix_a, 16, 16, 16, __nv_bfloat16, wmma::row_major> av;
+            wmma::fragment<wmma::matrix_b, 16, 16, 16, __nv_bfloat16, wmma::col_major> bv;
+            wmma::load_matrix_sync(av, a + (warp / 2) * 16 * 64 + kk, 64);
+            wmma::load_matrix_sync(bv, b + (warp % 2) * 16 * 64 + kk, 64);
+            wmma::mma_sync(acc, av, bv, acc);
+        }
+        __syncthreads();
+    }
+    wmma::store_matrix_sync(partial + (warp / 2) * 16 * 32 + (warp % 2) * 16, acc, 32, wmma::mem_row_major);
+    cluster.sync();
+    if (rank == 0) {
+        for (int i = tid; i < 32 * 32; i += 128) {
+            float value = partial[i];
+#pragma unroll
+            for (int peer = 1; peer < 4; ++peer)
+                value += cluster.map_shared_rank(partial, peer)[i];
+            if (row + i / 32 < rows)
+                y[(row + i / 32) * 128 + expert + i % 32] = __float2bfloat16_rn(value);
+        }
+    }
+    cluster.sync();
+}
+
+}  // namespace decode_router
