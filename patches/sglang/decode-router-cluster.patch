+"""Opt-in Qwen Decode router with cluster-local FP32 split-K reduction."""
+import os
+
+import torch
+
+from sglang.kernels.jit.utils import cache_once, load_jit
+from sglang.srt.utils.custom_op import register_custom_op
+
+
+@cache_once
+def decode_router_module():
+    return load_jit("decode_router", cuda_files=["gemm/decode_router.cuh"], cuda_wrappers=[("run", "DecodeRouterGate::run")])
+
+
+def can_use_decode_router(hidden_states, weight, forward_mode):
+    return (
+        os.environ.get("SGLANG_DECODE_ROUTER") == "cluster"
+        and (forward_mode.is_decode() or forward_mode.is_target_verify())
+        and hidden_states.ndim == 2 and 144 <= hidden_states.shape[0] <= 176
+        and hidden_states.shape[1] == 4096 and weight.shape == (128, 4096)
+        and hidden_states.dtype == weight.dtype == torch.bfloat16
+        and hidden_states.is_cuda and weight.device == hidden_states.device
+        and hidden_states.is_contiguous() and weight.is_contiguous()
+    )
+
+
+@register_custom_op(mutates_args=["output"])
+def _decode_router(input: torch.Tensor, weight: torch.Tensor, output: torch.Tensor) -> None:
+    decode_router_module().run(input, weight, output)
+
+
+def decode_router(hidden_states, weight):
+    output = torch.empty((hidden_states.shape[0], 128), dtype=torch.bfloat16, device=hidden_states.device)
+    _decode_router(hidden_states, weight, output)
+    return output
