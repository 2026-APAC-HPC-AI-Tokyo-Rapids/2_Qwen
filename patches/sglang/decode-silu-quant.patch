diff --git a/python/sglang/kernels/ops/moe/decode_silu_quant.py b/python/sglang/kernels/ops/moe/decode_silu_quant.py
new file mode 100644
index 0000000..e1eae25
--- /dev/null
+++ b/python/sglang/kernels/ops/moe/decode_silu_quant.py
@@ -0,0 +1,35 @@
+"""Qwen TP4 FC2 input: preserve the unfused BF16 rounding boundary."""
+from __future__ import annotations
+
+import torch
+
+from sglang.kernels.jit.utils import cache_once, is_arch_support_pdl, load_jit, make_cpp_args
+from sglang.srt.utils.custom_op import register_custom_op
+
+
+@cache_once
+def decode_silu_quant_module(use_pdl: bool):
+    args = make_cpp_args(torch.bfloat16, torch.float8_e4m3fn, 128, False, True, True, True, use_pdl, True)
+    return load_jit(
+        "decode_silu_quant",
+        *args,
+        cuda_files=["gemm/per_token_group_quant.cuh"],
+        cuda_wrappers=[("run", f"PerTokenGroupQuantFlatKernel<{args}>::run")],
+        extra_cuda_cflags=["--use_fast_math"],
+    )
+
+
+@register_custom_op(mutates_args=["output", "scales"])
+def _decode_silu_quant(input: torch.Tensor, output: torch.Tensor, scales: torch.Tensor) -> None:
+    decode_silu_quant_module(is_arch_support_pdl()).run(input, output, scales)
+
+
+def decode_silu_quant(input: torch.Tensor):
+    assert input.dtype == torch.bfloat16 and input.ndim == 2 and input.shape[1] == 768
+    assert input.is_contiguous()
+    rows = input.shape[0]
+    output = torch.empty((rows, 384), dtype=torch.float8_e4m3fn, device=input.device)
+    scales = torch.empty((rows, 3), dtype=torch.float32, device=input.device)
+    if rows:
+        _decode_silu_quant(input, output, scales)
+    return output, scales
