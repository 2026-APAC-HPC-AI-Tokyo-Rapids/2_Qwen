+    expected = f"qwen-profile-TP-{global_rank}.trace.json.gz"
+    if basename != expected:
+        raise ValueError(f"profiler trace name {basename!r} != {expected!r}")
+    capture = {
+        "schema_version": "profiler-capture/v1",
+        "run_id": run_id,
+        "global_rank": global_rank,
+        "invocation_id": "measured-generation",
+        "source_member": f"profile/raw/torch/{basename}",
+        "size_bytes": len(payload),
+        "sha256": hashlib.sha256(payload).hexdigest(),
+    }
+    destination = trace_path.removesuffix(".trace.json.gz") + ".capture.json"
+    temporary = destination + f".tmp-{os.getpid()}"
+    with open(temporary, "x", encoding="utf-8") as stream:
+        json.dump(
+            capture,
+            stream,
+            ensure_ascii=False,
+            allow_nan=False,
+            separators=(",", ":"),
+        )
+        stream.write("\n")
+        stream.flush()
+    os.replace(temporary, destination)
