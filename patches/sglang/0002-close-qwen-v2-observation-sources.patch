@@ -0,0 +1,95 @@
+"""Optional, local-only Qwen experiment-metrics hooks."""
+
+import dataclasses
+import json
+import logging
+import os
+import socket
+import struct
+
+_sequences = {}
+logger = logging.getLogger(__name__)
+
+
+def send_event(event_type, payload, *, producer_id, global_rank=None):
+    socket_path = os.getenv("QWEN_EXPERIMENT_METRICS_SOCKET")
+    run_id = os.getenv("QWEN_EXPERIMENT_METRICS_RUN_ID")
+    raw_node_rank = os.getenv("QWEN_EXPERIMENT_METRICS_NODE_RANK")
+    if not socket_path or not run_id or raw_node_rank is None:
+        return
+    try:
+        sequence = _sequences.get(producer_id, 0)
+        event = {
+            "schema_version": "qwen-domain-event/v1",
+            "run_id": run_id,
+            "producer_id": producer_id,
+            "node_rank": int(raw_node_rank),
+            "sequence": sequence,
+            "event_type": event_type,
+            "payload": payload,
+        }
+        if global_rank is not None:
+            event["global_rank"] = global_rank
+        encoded = json.dumps(
+            event, ensure_ascii=False, allow_nan=False, separators=(",", ":")
+        ).encode()
+        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as stream:
+            stream.settimeout(5)
+            stream.connect(socket_path)
+            stream.sendall(struct.pack(">I", len(encoded)) + encoded)
+        _sequences[producer_id] = sequence + 1
+    except (OSError, ValueError, TypeError, KeyError) as error:
+        logger.warning("Could not emit Qwen experiment metrics: %s", error)
+
+
+def emit_config_snapshot(config, config_type, event_type, source_path, oid_env):
+    if not os.getenv("QWEN_EXPERIMENT_METRICS_SOCKET"):
+        return
+    try:
+        node_rank = int(os.environ["QWEN_EXPERIMENT_METRICS_NODE_RANK"])
+        values = dataclasses.asdict(config)
+        definitions = {
+            field.name: str(field.type) for field in dataclasses.fields(config)
+        }
+        fields = [
+            {
+                "name": name,
+                "declared_type": definitions[name],
+                "value": values[name],
+            }
+            for name in sorted(values, key=lambda item: item.encode("utf-8"))
+        ]
+        send_event(
+            event_type,
+            {
+                "schema_version": "config-snapshot/v1",
+                "config_type": config_type,
+                "definition": {
+                    "source_path": source_path,
+                    "class_name": config_type,
+                    "source_blob_oid": os.environ[oid_env],
+                },
+                "fields": fields,
+            },
+            producer_id=f"sglang-{config_type.lower()}-node-{node_rank}",
+        )
+    except (OSError, ValueError, TypeError, KeyError) as error:
+        logger.warning("Could not emit Qwen configuration metrics: %s", error)
+
+
+def capture_worker_environment(global_rank):
+    source_dir = os.getenv("QWEN_EXPERIMENT_METRICS_SOURCE_DIR")
+    if not source_dir:
+        return
+    directory = os.path.join(source_dir, "environment")
+    os.makedirs(directory, exist_ok=True)
+    destination = os.path.join(directory, f"worker-{global_rank}.snapshot")
+    payload = b"".join(
+        name + b"\0" + value + b"\0"
+        for name, value in sorted(os.environb.items())
+    )
+    temporary = destination + f".tmp-{os.getpid()}"
+    with open(temporary, "xb") as stream:
+        stream.write(payload)
+        stream.flush()
+    os.replace(temporary, destination)
