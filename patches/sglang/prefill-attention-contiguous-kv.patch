--- /dev/null
+++ b/python/sglang/srt/layers/attention/prefill_contiguous.py
@@ -0,0 +1,19 @@
+"""Host-only eligibility shared by the Qwen prologue and FA3 consumer."""
+from sglang.srt.model_executor.forward_batch_info import ForwardMode
+
+
+def use_contiguous_prefill(forward_batch, *, full_graph=False):
+    # Full graphs replay both prefix/no-prefix with one capture: keep paged.
+    # Breakable graphs execute this host predicate for each forward; DP uses
+    # rank-local lengths, never global_num_tokens_cpu (which pads other ranks).
+    lengths = forward_batch.extend_seq_lens_cpu
+    prefixes = forward_batch.extend_prefix_lens_cpu
+    return (
+        not full_graph
+        and forward_batch.forward_mode == ForwardMode.EXTEND
+        and lengths is not None and len(lengths) > 0 and sum(lengths) > 0
+        and prefixes is not None and len(prefixes) == len(lengths)
+        and not any(prefixes)
+        and forward_batch.encoder_lens is None
+        and not forward_batch.mha_return_lse
+    )
