+def dense_gemm(a, sa, weight, weight_scale, out, *, tail_split=False):
+    """Split only QKV's exact measured shape on the current stream."""
+    import deep_gemm
+
+    if tail_split and a.shape == (7988, 4096) and weight.shape == (9216, 4096):
+        # 7936 aligns to BM256, group128 and TMA's 16-byte requirement.
+        # Preserve the original column-major scale stride in both descriptors.
+        deep_gemm.fp8_gemm_nt((a[:7936], sa[:7936]), (weight, weight_scale), out[:7936], compiled_dims="nk")
+        deep_gemm.fp8_gemm_nt((a[7936:], sa[7936:]), (weight, weight_scale), out[7936:], compiled_dims="nk")
+        _log_qkv_tail_dispatch()
+    else:
+        deep_gemm.fp8_gemm_nt((a, sa), (weight, weight_scale), out, compiled_dims="nk")
+
+
+_qkv_tail_dispatch_logged = False
+
+
+def _log_qkv_tail_dispatch():
+    global _qkv_tail_dispatch_logged
+    if not _qkv_tail_dispatch_logged:
+        import logging
+
+        logging.getLogger(__name__).warning("Prefill r29 qkv-tail using split 7936+52 rows projection=QKV M=7988 N=9216 K=4096 pid=%s", os.getpid())
+        _qkv_tail_dispatch_logged = True
+
+
