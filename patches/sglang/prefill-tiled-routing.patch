+"""Prebuilt CUDA integer routing helper; EP1 valid IDs only, no runtime compile."""
+import torch
+import apac_prefill_moe_routing
+
+
+def prepare_tiled_routing(ids, offsets, p1, p2, a_map, c_map):
+    # Fixed allocation sizes depend only on host shape, no GPU counts.item().
+    tiles = (ids.numel() + 511) // 512
+    counts = torch.empty((tiles, 128), dtype=torch.int32, device=ids.device)
+    tile_offsets = torch.empty_like(counts)
+    apac_prefill_moe_routing.prepare(ids, offsets, p1, p2, a_map, c_map, counts, tile_offsets)
