+++ b/python/sglang/srt/utils/hf_transformers/gigatoken_encoder.py
@@ -0,0 +1,17 @@
+"""Accelerate the text encode used after OpenAI chat-template rendering.
+
+Keep the original HF tokenizer object, special-token metadata and decoder.
+Calls requesting other HF features retain their existing implementation.
+"""
+from gigatoken import Tokenizer
+
+
+class GigatokenEncoder:
+    def __init__(self, tokenizer):
+        self._reference_encode = tokenizer.encode
+        self._fast_encode = Tokenizer(tokenizer).as_hf().encode
+
+    def __call__(self, text, *args, **kwargs):
+        if isinstance(text, str) and not args and kwargs.keys() <= {"add_special_tokens"}:
+            return self._fast_encode(text, **kwargs)
+        return self._reference_encode(text, *args, **kwargs)
