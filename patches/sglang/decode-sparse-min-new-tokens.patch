diff --git a/python/sglang/srt/sampling/penaltylib/sparse_min_new_tokens.py b/python/sglang/srt/sampling/penaltylib/sparse_min_new_tokens.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/srt/sampling/penaltylib/sparse_min_new_tokens.py
@@ -0,0 +1,60 @@
+"""Apply a min-new-token-only overlap snapshot without a vocabulary-wide tensor."""
+
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _apply_min_new_tokens_penalty(
+    logits,
+    stop_ids,
+    active,
+    logit_row_stride: tl.constexpr,
+    logit_col_stride: tl.constexpr,
+    stop_row_stride: tl.constexpr,
+    stop_col_stride: tl.constexpr,
+    active_row_stride: tl.constexpr,
+    vocab: tl.constexpr,
+    stop_count: tl.constexpr,
+    repeat: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    req = row // repeat
+    columns = tl.arange(0, BLOCK)
+    enabled = tl.load(active + req * active_row_stride)
+    token = tl.load(
+        stop_ids + req * stop_row_stride + columns * stop_col_stride,
+        mask=columns < stop_count,
+        other=vocab,
+    )
+    valid = enabled & (columns < stop_count) & (token >= 0) & (token < vocab)
+    ptr = logits + row * logit_row_stride + token * logit_col_stride
+    value = tl.load(ptr, mask=valid, other=0.0)
+    # Preserve dense addition semantics, including +inf + -inf -> NaN.
+    tl.store(ptr, value + float("-inf"), mask=valid)
+
+
+def apply_min_new_tokens_penalty(logits, stop_ids, active):
+    assert logits.ndim == 2 and stop_ids.ndim == 2
+    rows, vocab = logits.shape
+    batch, stop_count = stop_ids.shape
+    if rows == 0 or stop_count == 0:
+        return
+    assert batch > 0 and rows % batch == 0
+    assert active.shape == (batch, 1)
+    _apply_min_new_tokens_penalty[(rows,)](
+        logits,
+        stop_ids,
+        active,
+        logits.stride(0),
+        logits.stride(1),
+        stop_ids.stride(0),
+        stop_ids.stride(1),
+        active.stride(0),
+        vocab,
+        stop_count,
+        rows // batch,
+        triton.next_power_of_2(stop_count),
+        num_warps=4,
+    )
