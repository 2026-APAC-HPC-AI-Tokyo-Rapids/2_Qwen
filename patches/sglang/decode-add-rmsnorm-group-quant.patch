+    q = torch.empty(x.shape, dtype=torch.float8_e4m3fn, device=x.device)
+    scale = torch.empty((32, (rows + 3) // 4 * 4), dtype=torch.float32, device=x.device).T[:rows]
+    decode_add_rmsnorm_group_quant_fp8_out(x, residual, weight, eps, q, scale)
