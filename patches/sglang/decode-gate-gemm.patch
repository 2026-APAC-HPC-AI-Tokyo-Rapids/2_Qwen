--- /dev/null
+++ b/python/sglang/kernels/ops/moe/decode_gate.py
@@ -0,0 +1,51 @@
+"""BF16 Qwen Decode gate, with a single FP32 reduction per output tile."""
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _decode_gate_kernel(X, W, Y, M, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):
+    rows = tl.program_id(0) * BM + tl.arange(0, BM)
+    experts = tl.program_id(1) * BN + tl.arange(0, BN)
+    ks = tl.arange(0, BK)
+    acc = tl.full((BM, BN), 0, tl.float32)
+    for block in range(4096 // BK):
+        k = block * BK + ks
+        x = tl.load(X + rows[:, None] * 4096 + k[None, :], rows[:, None] < M, 0)
+        w = tl.load(W + experts[None, :] * 4096 + k[:, None])
+        acc = tl.dot(x, w, acc)
+    # The original ReplicatedLinear returns BF16 logits before softmax/top-k.
+    tl.store(Y + rows[:, None] * 128 + experts[None, :], acc.to(tl.bfloat16), rows[:, None] < M)
+
+
+def can_use_decode_gate(hidden_states, weight, forward_mode):
+    """Keep Prefill and small batches on the existing ReplicatedLinear path."""
+    return (
+        os.environ.get("SGLANG_DECODE_GATE_GEMM") == "triton"
+        and (forward_mode.is_decode() or forward_mode.is_target_verify())
+        and hidden_states.ndim == 2
+        and 64 <= hidden_states.shape[0] <= 144
+        and hidden_states.shape[1] == 4096
+        and weight.shape == (128, 4096)
+        and hidden_states.dtype == weight.dtype == torch.bfloat16
+        and hidden_states.is_contiguous()
+        and weight.is_contiguous()
+    )
+
+
+def decode_gate(hidden_states, weight):
+    """Graph-safe full GEMM; no split-K workspace, autotuning or host reads."""
+    assert hidden_states.ndim == 2 and hidden_states.shape[1] == 4096
+    assert weight.shape == (128, 4096)
+    assert hidden_states.dtype == weight.dtype == torch.bfloat16
+    assert hidden_states.is_cuda and weight.device == hidden_states.device
+    assert hidden_states.is_contiguous() and weight.is_contiguous()
+    rows = hidden_states.shape[0]
+    assert 64 <= rows <= 144
+    logits = torch.empty((rows, 128), dtype=torch.bfloat16, device=hidden_states.device)
+    _decode_gate_kernel[(triton.cdiv(rows, 16), 8)](hidden_states, weight, logits, rows, BM=16, BN=16, BK=256, num_warps=4, num_stages=3)
+    return logits
