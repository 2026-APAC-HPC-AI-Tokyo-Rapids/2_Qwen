+    # Proxy hidden states move with PyNccl on the forward stream, so a stage's
+    # stream is receive -> forward -> send. torch.distributed P2P runs NCCL on
+    # an internal stream: there the receive of the next microbatch sat on the
+    # SMs beside the current forward and stalled the grid-synchronized
+    # MegaMoE kernel (stage 3 of 40796263174: one 37-66 ms MegaMoE per
+    # microbatch), and with launches decoupled the waiting send would do the
+    # same on stages 0-2. In-stream, an NCCL kernel never runs beside compute
+    # on its GPU; it can only wait for a slower neighbour, when the GPU would
+    # idle anyway. Metadata goes first over the CPU group so the receiver can
+    # post the matching receive.
+    def _qpp_send_proxy(self: Scheduler, tensors: Dict[str, torch.Tensor]):
+        from sglang.srt.distributed.parallel_state import _split_tensor_dict
+
+        dst = self.pp_group.rank_in_group + 1
+        metadata_list, tensor_list = _split_tensor_dict(tensors)
+        works = self.pp_group.send_object(metadata_list, dst=dst, async_send=True)
+        comm = self.pp_group.pynccl_comm
+        with comm.change_state(enable=True):
+            for tensor in tensor_list:
+                assert tensor.is_contiguous()
+                if tensor.numel() > 0:
+                    comm.send(tensor, dst)
+        return works
+
+    def _qpp_recv_proxy(self: Scheduler, metadata_list) -> Dict[str, torch.Tensor]:
+        from sglang.srt.distributed.parallel_state import TensorMetadata
+
+        src = self.pp_group.rank_in_group - 1
+        comm = self.pp_group.pynccl_comm
+        tensors = {}
+        with comm.change_state(enable=True):
+            for key, value in metadata_list:
+                if isinstance(value, TensorMetadata):
+                    value = torch.empty(value.size, dtype=value.dtype, device=comm.device)
+                    if value.numel() > 0:
+                        comm.recv(value, src)
+                tensors[key] = value
+        return tensors
+
     def _qpp_publish_results(self: Scheduler, loop: _QwenPPLoop, keep: int) -> None:
         while len(loop.unpublished) > keep:
             launch = loop.unpublished.popleft()
