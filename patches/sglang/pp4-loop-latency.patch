+    # Admission. Upstream admits a request only once every stage has polled its
+    # own bootstrap as done: an intersection along the stages and a consensus
+    # back from the last stage, applied pp_size - 1 (here 2) iterations later
+    # and usable one iteration after that (~0.37 s at a 124 ms period; 15 of
+    # the 51 requests inside Prefill waited there in 40825417205). A stage
+    # needs its own bootstrap only to send its KV, which it does after its
+    # forward. So stage 0 admits on arrival (Bootstrapping or WaitingForInput)
+    # once it can reserve metadata, and every later stage admits exactly that
+    # list in the same iteration. Every stage finalizes its sender when its own
+    # bootstrap completes, keeping the request pending (pending_bootstrap)
+    # until then like an optimistic prefill. All stages still
+    # add the same requests to the waiting queue in the same order at the same
+    # iteration.
+    def _qpp_admit_bootstrapped(self: Scheduler, loop: _QwenPPLoop):
+        bootstrap_queue = self.disagg_prefill_bootstrap_queue
+        if self.pp_group.is_first_rank:
+            polls = poll_and_all_reduce_attn_cp_tp_group(
+                [req.disagg_kv_sender for req in bootstrap_queue.queue],
+                self.attn_cp_cpu_group,
+                self.attn_tp_cpu_group,
+            )
+            admitted, failed, remaining = [], [], []
+            for req, poll in zip(bootstrap_queue.queue, polls):
+                if poll == KVPoll.Failed or isinstance(req.finished_reason, FINISH_ABORT):
+                    self.handle_bootstrap_failure(req)
+                    failed.append(req)
+                    continue
+                if poll == KVPoll.WaitingForInput:
+                    ready = bootstrap_queue.finalize_bootstrap(req)
+                elif poll == KVPoll.Bootstrapping:
+                    ready = bootstrap_queue.ensure_metadata_buffer(req)
+                    if ready:
+                        loop.pending.append(req)
+                else:
+                    remaining.append(req)
+                    continue
+                if not ready:
+                    # Metadata exhaustion delays admission on every stage.
+                    remaining.append(req)
+                    continue
+                admitted.append(req)
+                req.time_stats.set_wait_queue_entry_time()
+            bootstrap_queue.queue = remaining
+            self.waiting_queue.extend(admitted)
+            return [[req.rid for req in admitted], [req.rid for req in failed]]
+        good_rids, bad_rids = self._pp_recv_pyobj_from_prev_stage()
+        good_rids, bad_rids = set(good_rids), set(bad_rids)
+        admitted, failed, remaining = [], [], []
+        for req in bootstrap_queue.queue:
+            if req.rid in bad_rids:
+                failed.append(req)
+            elif req.rid in good_rids:
+                admitted.append(req)
+            else:
+                remaining.append(req)
+        assert len(admitted) == len(good_rids) and len(failed) == len(bad_rids), (
+            "PP stages diverged in admission"
+        )
+        bootstrap_queue.queue = remaining
+        for req in failed:
+            self.handle_bootstrap_failure(req)
+        polls = poll_and_all_reduce_attn_cp_tp_group(
+            [req.disagg_kv_sender for req in admitted],
+            self.attn_cp_cpu_group,
+            self.attn_tp_cpu_group,
+        )
+        for req, poll in zip(admitted, polls):
+            if poll == KVPoll.WaitingForInput:
+                # Same metadata buffer allocations on every stage (same
+                # admissions and releases), so this cannot run out here.
+                assert bootstrap_queue.finalize_bootstrap(req)
+            else:
+                assert bootstrap_queue.ensure_metadata_buffer(req)
+                loop.pending.append(req)
+            req.time_stats.set_wait_queue_entry_time()
+        self.waiting_queue.extend(admitted)
+        return [[req.rid for req in admitted], [req.rid for req in failed]]
+
+    def _qpp_finalize_pending(self: Scheduler, loop: _QwenPPLoop):
+        """Every stage: finalize senders whose own bootstrap completed and send
+        the KV of requests that already finished their prefill (parked in the
+        inflight queue). A failed bootstrap stays pending; its sender reports
+        Failed to the release consensus, which aborts it on this stage."""
+        polls = poll_and_all_reduce_attn_cp_tp_group(
+            [req.disagg_kv_sender for req in loop.pending],
+            self.attn_cp_cpu_group,
+            self.attn_tp_cpu_group,
+        )
+        still_pending = []
+        for req, poll in zip(loop.pending, polls):
+            if poll == KVPoll.WaitingForInput:
+                assert self.disagg_prefill_bootstrap_queue.finalize_bootstrap(req)
+                if req in self.disagg_prefill_inflight_queue:
+                    self.send_kv_chunk(req, last_chunk=True)
+            elif poll == KVPoll.Bootstrapping:
+                still_pending.append(req)
+        loop.pending = still_pending
 
