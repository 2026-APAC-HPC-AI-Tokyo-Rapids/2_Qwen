+def run_sm90_mega_combine_norm(moe, residual, buf, weight, eps):
+    """fp8_mega_moe whose combine also runs the next layer's input add-RMSNorm and
+    FP8 group quant (EP1 lean Prefill, after the MoE input path filled buf): residual
+    += the MoE output in place, and the (q, scale) that add_rmsnorm_group_quant_fp8
+    would return for the QKV GEMM. The BF16 MoE output is never written."""
+    import deep_gemm
+
+    rows = residual.shape[0]
+    q = torch.empty(residual.shape, dtype=torch.float8_e4m3fn, device=residual.device)
+    # The layout of add_rmsnorm_group_quant_fp8: column-major FP32 scales, TMA-aligned rows.
+    scale = torch.empty((residual.shape[1] // 128, (rows + 3) // 4 * 4), dtype=torch.float32, device=residual.device).transpose(0, 1)[:rows]
+    (l1, l1_sf), (l2, l2_sf) = moe.experts.mega_l1_weights, moe.experts.mega_l2_weights
+    deep_gemm._C.fp8_mega_moe_norm(
+        residual, l1, l1_sf, l2, l2_sf, None,
+        buf.buffer, buf.handle.buffer_ptrs, buf.group.rank(),
+        buf.num_max_tokens_per_rank, buf.num_experts, buf.num_topk,
+        (128, 128, 128), "swiglu", getattr(moe.config, "swiglu_limit", None), True,
+        weight, eps, q, scale,
+    )
+    return q, scale
+
+
