+def start_measured_phase():
+    _phase_request(
+        {
+            "type": "phase_start",
+            "sequence": 0,
+            "invocation_id": "measured-generation",
+            "kind": "measured",
+        },
+        "phase_start_ack",
+    )
+
+
+def end_measured_phase(generation_start_ns, generation_end_ns):
+    _phase_request(
+        {
+            "type": "phase_end",
+            "sequence": 1,
+            "invocation_id": "measured-generation",
+            "kind": "measured",
+            "generation_start_ns": generation_start_ns,
+            "generation_end_ns": generation_end_ns,
+        },
+        "phase_end_ack",
+    )
+
+
+def _phase_request(payload, expected_type):
+    if int(os.getenv("QWEN_EXPERIMENT_METRICS_NODE_RANK", "-1")) != 0:
+        return
+    socket_path = os.environ["QWEN_EXPERIMENT_METRICS_PHASE_SOCKET"]
+    encoded = json.dumps(
+        payload, ensure_ascii=False, allow_nan=False, separators=(",", ":")
+    ).encode()
+    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as stream:
+        stream.settimeout(300)
+        stream.connect(socket_path)
+        stream.sendall(encoded + b"\n")
+        response = bytearray()
+        while not response.endswith(b"\n"):
+            block = stream.recv(4096)
+            if not block:
+                raise OSError("phase coordinator closed the request")
+            response.extend(block)
+            if len(response) > 64 * 1024:
+                raise ValueError("phase coordinator response is too large")
+    value = json.loads(response)
+    if value != {
+        "type": expected_type,
+        "invocation_id": "measured-generation",
+        "kind": "measured",
+    }:
+        raise ValueError("phase coordinator response differs")
