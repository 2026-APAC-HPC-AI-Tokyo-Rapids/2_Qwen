+"""PP4 Prefill QKV: unchanged 1D2D mainloop, direct FP32 norm/RoPE/FP8."""
+
+import functools
+from pathlib import Path
+
+
+@functools.cache
+def _module():
+    import deep_gemm
+    from sglang.kernels.jit.utils import load_jit, override_jit_cuda_arch
+
+    with override_jit_cuda_arch(9, 0, "a"):
+        return load_jit("qkv_fused_prefill", cuda_files=["gemm/qkv_fused_prefill.cuh"], cuda_wrappers=[("run", "sgl_qkv_fused::QKVFusedPrefill::run")], extra_include_paths=[str(Path(deep_gemm.__file__).parent / "include")], extra_cuda_cflags=["--ptxas-options=-v,-warn-spills,--register-usage-level=10"])
+
+
+def qkv_fused_prefill(a, sa, w, sw, qw, kw, trig, positions, cache_loc, eps, q, k, v, k_cache, v_cache):
+    _module().run(a, sa, w, sw, qw, kw, trig, positions, cache_loc, eps, q, k, v, k_cache, v_cache)
