+"""Eligible PP4 Prefill producer; called only for SGLANG_PREFILL_QKNORM=fused."""
+
+import torch
+
+
+def prepare(attention, positions, x, batch):
+    from sglang.srt.layers.attention.prefill_contiguous import use_contiguous_prefill, use_fixed_prefill
+    from sglang.srt.layers.attention.prefill_fp8 import linear_supported, prefill_candidate
+    from sglang.srt.mem_cache.memory_pool import MHATokenToKVPool
+    from sglang.srt.model_executor.forward_batch_info import ForwardMode
+    from sglang.srt.model_executor.forward_context import get_attn_backend, get_token_to_kv_pool
+    from sglang.srt.runtime_context import get_server_args
+    from sglang.srt.environ import envs
+
+    args = get_server_args()
+    tensor = x[0] if isinstance(x, tuple) else x
+    if not (
+        args.disaggregation_mode == "prefill" and not args.enable_lora
+        and batch.forward_mode == ForwardMode.EXTEND
+        and args.cuda_graph_config.prefill.backend == "disabled"
+        and args.cuda_graph_config.prefill.tc_compiler != "inductor"
+        and use_contiguous_prefill(batch)
+        and attention.use_fp8_q_rope and not attention.use_fused_qk_norm_rope
+        and not envs.SGLANG_ENABLE_DETERMINISTIC_INFERENCE.get()
+        and linear_supported(attention, "QKV", attention.qkv_proj)
+        and attention.q_norm.weight.dtype == attention.k_norm.weight.dtype == torch.bfloat16
+        and attention.q_norm.variance_epsilon == attention.k_norm.variance_epsilon
+        and attention.rotary_emb.is_neox_style
+        and tensor.ndim == 2 and tensor.shape[0] >= 2048
+        and args.speculative_eagle_topk in (None, 1) and not args.enable_prefill_cp
+        and attention.attn.k_scale is None and attention.attn.v_scale is None
+        and positions.dtype == batch.out_cache_loc.dtype
+        and not prefill_candidate()["byte_image"]
+    ):
+        return None
+    props = torch.cuda.get_device_properties(tensor.device)
+    if props.multi_processor_count != 132 or props.shared_memory_per_block_optin < 216448:
+        return None
+    pool = get_token_to_kv_pool()
+    if type(pool) is not MHATokenToKVPool:
+        return None
+    kc, vc = pool.get_kv_buffer(attention.attn.layer_id)
+    if not (kc.dtype == vc.dtype == torch.float8_e4m3fn and kc.ndim == vc.ndim == 3 and kc.shape[1:] == vc.shape[1:] == (4, 128) and kc.is_contiguous() and vc.is_contiguous()):
+        return None
+    if isinstance(x, tuple):
+        a, sa = x
+    else:
+        if x.dtype != torch.bfloat16 or not x.is_contiguous():
+            return None
+        from sglang.kernels.ops.quantization.fp8_kernel import sglang_per_token_group_quant_fp8
+        a, sa = sglang_per_token_group_quant_fp8(x, 128, column_major_scales=True, scale_tma_aligned=True)
+    from sglang.kernels.ops.attention.qkv_fused_prefill import qkv_fused_prefill
+
+    q = torch.empty((a.shape[0], 64, 128), device=a.device, dtype=torch.float8_e4m3fn)
+    k = torch.empty((a.shape[0], 4, 128), device=a.device, dtype=torch.float8_e4m3fn)
+    v = torch.empty_like(k)
+    attention.attn.fixed_prefill_output = use_fixed_prefill(batch, attention.attn, get_attn_backend(), q, k, v, output_supported=linear_supported(attention, "O", attention.o_proj))
+    attention.attn.prefill_v_image = None
+    qkv_fused_prefill(a, sa, attention.qkv_proj.weight, attention.qkv_proj.weight_scale_inv, attention.q_norm.weight, attention.k_norm.weight, attention.rotary_emb.cos_sin_cache, positions, batch.out_cache_loc, attention.q_norm.variance_epsilon, q, k, v, kc, vc)
+    attention._stored_fp8_kv_last_call = True
+    attention._used_fused_qk_norm_rope_last_call = False
+    return q.view(-1, 8192), k, v
