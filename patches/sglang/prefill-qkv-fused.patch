+inline CUtensorMap tensor_map(CUtensorMapDataType dtype, const void* ptr, uint64_t x, uint64_t y, uint64_t stride, uint32_t bx, uint32_t by, CUtensorMapSwizzle swizzle) {
+    static const auto encode=[] {
+        void* ptr=nullptr;
+        cudaDriverEntryPointQueryResult status;
+        host::RuntimeDeviceCheck(cudaGetDriverEntryPointByVersion("cuTensorMapEncodeTiled", &ptr, 12000, cudaEnableDefault, &status));
+        host::RuntimeCheck(status==cudaDriverEntryPointSuccess && ptr!=nullptr, "cuTensorMapEncodeTiled is unavailable");
+        return reinterpret_cast<PFN_cuTensorMapEncodeTiled_v12000>(ptr);
+    }();
+    CUtensorMap map;
+    const uint64_t dims[2]={x,y}, strides[1]={stride};
+    const uint32_t box[2]={bx,by}, elem[2]={1,1};
+    const auto result=encode(&map,dtype,2,const_cast<void*>(ptr),dims,strides,box,elem,CU_TENSOR_MAP_INTERLEAVE_NONE,swizzle,CU_TENSOR_MAP_L2_PROMOTION_L2_256B,CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+    host::RuntimeCheck(result==CUDA_SUCCESS,"QKV fused cuTensorMapEncodeTiled failed");
+    return map;
+}
+
+struct QKVFusedPrefill {
+    template<typename Id>
+    static void launch(const tvm::ffi::TensorView a, const tvm::ffi::TensorView sa, const tvm::ffi::TensorView w, const tvm::ffi::TensorView sw, const tvm::ffi::TensorView qw, const tvm::ffi::TensorView kw, const tvm::ffi::TensorView trig, const tvm::ffi::TensorView pos, const tvm::ffi::TensorView loc, double eps, const tvm::ffi::TensorView q, const tvm::ffi::TensorView k, const tvm::ffi::TensorView v, const tvm::ffi::TensorView kc, const tvm::ffi::TensorView vc) {
+        using namespace deep_gemm;
+        const auto rows=static_cast<uint32_t>(a.size(0));
+        const auto ta=tensor_map(CU_TENSOR_MAP_DATA_TYPE_UINT8,a.data_ptr(),4096,rows,4096,128,256,CU_TENSOR_MAP_SWIZZLE_128B);
+        const auto tb=tensor_map(CU_TENSOR_MAP_DATA_TYPE_UINT8,w.data_ptr(),4096,9216,4096,128,128,CU_TENSOR_MAP_SWIZZLE_128B);
+        const auto ts=tensor_map(CU_TENSOR_MAP_DATA_TYPE_FLOAT32,sa.data_ptr(),sa.stride(1),32,sa.stride(1)*4,256,1,CU_TENSOR_MAP_SWIZZLE_NONE);
+        const auto kernel=qkv_fused_prefill_impl<cute::UMMA::Major::K,0,9216,4096,1,256,128,128,128,128,128,3,128,256,2,true,132,GemmType::Normal,cutlass::bfloat16_t,epilogue::transform::EpilogueIdentity,Id>;
+        constexpr uint32_t smem=216448;
+        static const bool configured=[&] { host::RuntimeDeviceCheck(cudaFuncSetAttribute(kernel,cudaFuncAttributeMaxDynamicSharedMemorySize,smem)); return true; }();
+        (void)configured;
+        const auto p=Params{static_cast<const __nv_bfloat16*>(qw.data_ptr()),static_cast<const __nv_bfloat16*>(kw.data_ptr()),static_cast<const float*>(trig.data_ptr()),pos.data_ptr(),loc.data_ptr(),static_cast<uint8_t*>(q.data_ptr()),static_cast<uint8_t*>(k.data_ptr()),static_cast<uint8_t*>(v.data_ptr()),static_cast<uint8_t*>(kc.data_ptr()),static_cast<uint8_t*>(vc.data_ptr()),kc.size(0),static_cast<float>(eps)};
+        host::LaunchKernel(132,384,a.device(),smem).enable_cluster(dim3(2,1,1)).enable_pdl(true)(kernel,static_cast<float*>(sw.data_ptr()),static_cast<int*>(nullptr),rows,9216u,4096u,*reinterpret_cast<const cute::TmaDescriptor*>(&ta),*reinterpret_cast<const cute::TmaDescriptor*>(&tb),*reinterpret_cast<const cute::TmaDescriptor*>(&ts),p);
+    }
+
+    static void run(const tvm::ffi::TensorView a, const tvm::ffi::TensorView sa, const tvm::ffi::TensorView w, const tvm::ffi::TensorView sw, const tvm::ffi::TensorView qw, const tvm::ffi::TensorView kw, const tvm::ffi::TensorView trig, const tvm::ffi::TensorView pos, const tvm::ffi::TensorView loc, double eps, const tvm::ffi::TensorView q, const tvm::ffi::TensorView k, const tvm::ffi::TensorView v, const tvm::ffi::TensorView kc, const tvm::ffi::TensorView vc) {
+        using namespace host;
+        auto M=SymbolicSize{"rows"}; auto S=SymbolicSize{"slots"}; auto Sm=SymbolicSize{"scale_stride"};
+        auto device=SymbolicDevice{}; device.set_options<kDLCUDA>(); auto id=SymbolicDType{};
+        TensorMatcher({M,4096}).with_dtype<fp8_e4m3_t>().with_device(device).verify(a);
+        TensorMatcher({M,32}).with_strides({1,Sm}).with_dtype<float>().with_device(device).verify(sa);
+        TensorMatcher({9216,4096}).with_dtype<fp8_e4m3_t>().with_device(device).verify(w);
+        TensorMatcher({72,32}).with_dtype<float>().with_device(device).verify(sw);
+        TensorMatcher({128}).with_dtype<bf16_t>().with_device(device).verify(qw).verify(kw);
+        TensorMatcher({-1,128}).with_dtype<float>().with_device(device).verify(trig);
+        TensorMatcher({M}).with_dtype<int32_t,int64_t>(id).with_device(device).verify(pos).verify(loc);
+        TensorMatcher({M,64,128}).with_dtype<fp8_e4m3_t>().with_device(device).verify(q);
+        TensorMatcher({M,4,128}).with_dtype<fp8_e4m3_t>().with_device(device).verify(k).verify(v);
+        TensorMatcher({S,4,128}).with_dtype<fp8_e4m3_t>().with_device(device).verify(kc).verify(vc);
+        RuntimeCheck(M.unwrap()>0 && Sm.unwrap()>=M.unwrap() && Sm.unwrap()%4==0,"QKV fused requires TMA-aligned column-major activation scales");
+        if(id.is_type<int32_t>()) launch<int32_t>(a,sa,w,sw,qw,kw,trig,pos,loc,eps,q,k,v,kc,vc);
+        else launch<int64_t>(a,sa,w,sw,qw,kw,trig,pos,loc,eps,q,k,v,kc,vc);
+    }
+};
+} // namespace sgl_qkv_fused
