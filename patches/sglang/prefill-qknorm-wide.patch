+// Non-image Prefill: four rows in flight, trig shared across 32 heads.
+template<bool kUsePDL, typename IdType>
+__global__ __launch_bounds__(256) void qknorm_rope_prefill_wide_kernel(
+    const __grid_constant__ QKNormRopeFP8Params p, void* contiguous_k, void* contiguous_v) {
+    device::PDLWaitPrimary<kUsePDL>();
+    constexpr int BM=4;
+    const int head=blockIdx.y*32+threadIdx.x/8, first_row=blockIdx.x*BM, rows=p.num_tokens;
+    const int q_heads=p.num_qo_heads, kv_heads=p.num_kv_heads;
+    const int lane=threadIdx.x%8, col=lane*8;
+    const bool valid_head=head<q_heads+2*kv_heads;
+    const bool is_q=head<q_heads, is_k=head<q_heads+kv_heads;
+    const int h=is_k ? head : head-q_heads-kv_heads;
+    __shared__ int64_t positions[BM], slots[BM];
+    __shared__ __align__(16) float trig[BM][128];
+    if (threadIdx.x<BM) {
+        const int token=first_row+threadIdx.x;
+        positions[threadIdx.x]=token<rows ? static_cast<const IdType*>(p.positions)[token] : 0;
+        slots[threadIdx.x]=token<rows ? static_cast<const IdType*>(p.cache_loc)[token] : 0;
+    }
+    __syncthreads();
+    // Two independent 16-byte tiles for every row, all live before arithmetic.
+    uint4 vx_all[BM], vy_all[BM];
+    const auto src=static_cast<const char*>(is_q ? p.q : (is_k ? p.k : p.v));
+    const int64_t stride=is_q ? p.q_stride_bytes : (is_k ? p.k_stride_bytes : p.v_stride_bytes);
+    #pragma unroll
+    for (int row=0;row<BM;++row) {
+        const int token=first_row+row;
+        vx_all[row]=uint4{};
+        vy_all[row]=uint4{};
+        if (valid_head && token<rows) {
+            const auto tile=reinterpret_cast<const __nv_bfloat16*>(src+int64_t(token)*stride+int64_t(h)*256);
+            vx_all[row]=*reinterpret_cast<const uint4*>(tile+col);
+            vy_all[row]=*reinterpret_cast<const uint4*>(tile+64+col);
+        }
+    }
+    for (int i=threadIdx.x;i<BM*128;i+=256) {
+        trig[i/128][i%128]=static_cast<const float*>(p.cos_sin_cache)[positions[i/128]*128+i%128];
+    }
+    __syncthreads();
+    float wx[8], wy[8];
+    if (head < q_heads + kv_heads) {
+        const auto w = static_cast<const __nv_bfloat16*>(head < q_heads ? p.q_weight : p.k_weight);
+        const uint4 vx = *reinterpret_cast<const uint4*>(w + col);
+        const uint4 vy = *reinterpret_cast<const uint4*>(w + 64 + col);
+        #pragma unroll
+        for (int i=0;i<8;++i) {
+            wx[i] = __bfloat162float(reinterpret_cast<const __nv_bfloat16*>(&vx)[i]);
+            wy[i] = __bfloat162float(reinterpret_cast<const __nv_bfloat16*>(&vy)[i]);
+        }
+    }
+    // Keep every lane active through the exact control reduction, even tails.
+    #pragma unroll
+    for (int row=0;row<BM;++row) {
+        const int token=first_row+row;
+        float x[8], y[8], partial[4];
+        uint16_t ox[4], oy[4];
+        const uint4 vx=vx_all[row], vy=vy_all[row];
+        #pragma unroll
+        for (int i=0;i<8;++i) {
+            x[i] = __bfloat162float(reinterpret_cast<const __nv_bfloat16*>(&vx)[i]);
+            y[i] = __bfloat162float(reinterpret_cast<const __nv_bfloat16*>(&vy)[i]);
+        }
+        if (head < q_heads + kv_heads) {
+            #pragma unroll
+            for (int j=0;j<4;++j) {
+                float sum=0.f;
+                sum += x[j*2]*x[j*2]; sum += x[j*2+1]*x[j*2+1];
+                sum += y[j*2]*y[j*2]; sum += y[j*2+1]*y[j*2+1];
+                partial[j]=sum;
+            }
+            #pragma unroll
+            for (int mask=4;mask>=1;mask>>=1) {
+                #pragma unroll
+                for(int j=0;j<4;++j) partial[j] += __shfl_xor_sync(0xffffffff,partial[j],mask,8);
+            }
+            const float sum02=partial[0]+partial[2], sum13=partial[1]+partial[3];
+            const float scale=rsqrtf((sum02+sum13)/128.f+p.eps);
+            const float4 cos4[2] = {*reinterpret_cast<const float4*>(trig[row]+col), *reinterpret_cast<const float4*>(trig[row]+col+4)};
+            const float4 sin4[2] = {*reinterpret_cast<const float4*>(trig[row]+64+col), *reinterpret_cast<const float4*>(trig[row]+64+col+4)};
+            #pragma unroll
+            for(int j=0;j<4;++j) {
+                float a[2], b[2];
+                #pragma unroll
+                for(int h=0;h<2;++h) {
+                    const int d=j*2+h;
+                    const float u=__bfloat162float(__float2bfloat16_rn(x[d]*scale*wx[d]));
+                    const float v=__bfloat162float(__float2bfloat16_rn(y[d]*scale*wy[d]));
+                    const float c=reinterpret_cast<const float*>(cos4)[d], s=reinterpret_cast<const float*>(sin4)[d];
+                    a[h]=__bfloat162float(__float2bfloat16_rn(u*c-v*s));
+                    b[h]=__bfloat162float(__float2bfloat16_rn(u*s+v*c));
+                }
+                ox[j]=qkv_prefill_fp8(make_float2(a[0],a[1]));
+                oy[j]=qkv_prefill_fp8(make_float2(b[0],b[1]));
+            }
+        } else {
+            #pragma unroll
+            for(int j=0;j<4;++j) {
+                ox[j]=qkv_prefill_fp8(make_float2(x[j*2],x[j*2+1]));
+                oy[j]=qkv_prefill_fp8(make_float2(y[j*2],y[j*2+1]));
+            }
+        }
+        const uint2 lo=*reinterpret_cast<const uint2*>(ox), hi=*reinterpret_cast<const uint2*>(oy);
+        // Adjacent lanes own adjacent eight-byte segments. Even lanes combine
+        // them into aligned 16-byte stores without changing any output bits.
+        const uint4 lo_pair=make_uint4(lo.x,lo.y,__shfl_xor_sync(0xffffffff,lo.x,1,8),__shfl_xor_sync(0xffffffff,lo.y,1,8));
+        const uint4 hi_pair=make_uint4(hi.x,hi.y,__shfl_xor_sync(0xffffffff,hi.x,1,8),__shfl_xor_sync(0xffffffff,hi.y,1,8));
+        if(valid_head && token<rows && lane%2==0) {
+            const int kv_head=head<q_heads+kv_heads ? head-q_heads : head-q_heads-kv_heads;
+            uint8_t* dst=head<q_heads
+                ? static_cast<uint8_t*>(p.q_fp8)+(int64_t(token)*q_heads+head)*128
+                : static_cast<uint8_t*>(head<q_heads+kv_heads ? contiguous_k : contiguous_v)+(int64_t(token)*kv_heads+kv_head)*128;
+            *reinterpret_cast<uint4*>(dst+col)=lo_pair;
+            *reinterpret_cast<uint4*>(dst+64+col)=hi_pair;
+            if(head>=q_heads) {
+                const int64_t slot=slots[row];
+                assert(slot>=0 && slot<p.cache_slots);
+                if(slot!=0) {
+                    dst=static_cast<uint8_t*>(head<q_heads+kv_heads ? p.k_cache : p.v_cache)+(slot*kv_heads+kv_head)*128;
+                    *reinterpret_cast<uint4*>(dst+col)=lo_pair;
+                    *reinterpret_cast<uint4*>(dst+64+col)=hi_pair;
+                }
+            }
+        }
+    }
+    device::PDLTriggerSecondary<kUsePDL>();
+}
