+"""Readiness preparation and once-per-process dispatch for the dense N64 gate."""
+import logging
+import os
+
+import torch
+
+FLAG = "DG_SM90_PREFILL_DENSE_N64"
+_logged = set()
+_prewarmed = False
+
+
+def dispatch(rows):
+    if not _logged:
+        logging.getLogger(__name__).warning("Prefill r44 dense-n64 using candidate rows=%s pid=%s", rows, os.getpid())
+        _logged.add("dense-n64")
+
+
+def prewarm(model):
+    global _prewarmed
+    if _prewarmed or os.environ.get(FLAG) != "1":
+        return
+    from sglang.srt.layers.prefill_r37 import Dense
+    from sglang.srt.models.qwen3_moe import Qwen3MoeDecoderLayer
+
+    layer = next(m for m in model.modules() if isinstance(m, Qwen3MoeDecoderLayer))
+    a = layer.self_attn
+    with torch.inference_mode(), torch.random.fork_rng(devices=[torch.cuda.current_device()]):
+        for rows in (7988, 3994):
+            case = Dense(rows, [(a.qkv_proj.weight, a.qkv_proj.weight_scale_inv), (a.o_proj.weight, a.o_proj.weight_scale_inv)])
+            case.step("candidate", 0)
+            case.step("candidate", 1)
+            torch.cuda.synchronize()
+            logging.getLogger(__name__).warning("Prefill r44 dense-n64 prewarm done rows=%s shapes=qkv,o pid=%s", rows, os.getpid())
+            del case
+    _prewarmed = True
