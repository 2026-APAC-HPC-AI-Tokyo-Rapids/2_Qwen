+# Prefill only: an idle DP rank (0 local tokens) still enters the collective
+# kernel and processes the other ranks' tokens for its local experts. With a
+# 1-row output DeepGEMM's host heuristic picks the Decode SwapAB geometry for
+# that work; enough masked rows make it pick the Prefill geometry instead.
+_IDLE_PREFILL_GEOMETRY = os.environ.get("SGLANG_MEGAMOE_IDLE_PREFILL_GEOMETRY", "0") == "1"
+
+
+def idle_output_rows(num_experts: int, num_topk: int, num_ranks: int) -> int:
+    """Smallest local row count for which get_block_config_for_mega_moe_sm90
+    (DeepGEMM 0.1.5) chooses BLOCK_M 128 / 512 epilogue threads: expected
+    tokens per expert = rows * num_ranks * num_topk / num_experts >= 64."""
+    return -(-64 * num_experts // (num_ranks * num_topk))
+
+
+def _use_idle_prefill_geometry() -> bool:
+    if not _IDLE_PREFILL_GEOMETRY:
+        return False
+    from sglang.srt.runtime_context import get_server_args
+
+    return get_server_args().disaggregation_mode == "prefill"
+
+
 def is_sm90_fp8_mega_moe_available(experts) -> bool:
     if _device_sm != 90:
