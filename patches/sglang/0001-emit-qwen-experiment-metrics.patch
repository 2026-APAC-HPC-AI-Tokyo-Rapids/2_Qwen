@@ -34,0 +38,20 @@ from sglang.srt.server_args import ServerArgs
+def _send_metrics_event(event_type, payload):
+    """Emit optional metrics without making observability affect a benchmark."""
+    socket_path = os.getenv("QWEN_EXPERIMENT_METRICS_SOCKET")
+    if not socket_path:
+        return
+    try:
+        encoded = json.dumps(
+            {"type": event_type, "payload": payload},
+            ensure_ascii=False,
+            separators=(",", ":"),
+            default=str,
+        ).encode()
+        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as stream:
+            stream.settimeout(5)
+            stream.connect(socket_path)
+            stream.sendall(struct.pack(">I", len(encoded)) + encoded)
+    except Exception as error:
+        logging.warning("Could not emit Qwen experiment metrics: %s", error)
+
