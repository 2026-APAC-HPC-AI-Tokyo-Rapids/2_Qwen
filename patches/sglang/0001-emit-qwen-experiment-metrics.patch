+        ).encode()
+        measurement_results["output_hashes"] = {
+            "request_count": len(output_hashes),
+            "request": output_hashes,
+            "manifest_sha256": hashlib.sha256(manifest_bytes).hexdigest(),
+        }
+    except Exception as error:
+        logging.warning("Could not hash benchmark outputs for metrics: %s", error)
