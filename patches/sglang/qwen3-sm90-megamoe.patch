+    def forward_megamoe(self, hidden_states, forward_batch):
+        from sglang.srt.distributed import get_moe_ep_group
+        from sglang.srt.environ import envs
+        from sglang.srt.layers.moe.mega_moe import _get_mega_moe_symm_buffer
+        from sglang.srt.layers.moe.mega_moe_sm90 import (
+            is_sm90_fp8_mega_moe_available,
+            run_sm90_mega_routed,
+        )
+
+        num_tokens = hidden_states.shape[0]
+        cap = envs.SGLANG_OPT_DEEPGEMM_MEGA_MOE_NUM_MAX_TOKENS_PER_RANK.get()
+        if not is_sm90_fp8_mega_moe_available(self.experts):
+            raise RuntimeError("Qwen SM90 MegaMoE weights or native entry points unavailable")
+        if num_tokens > cap:
+            raise ValueError(f"Qwen SM90 MegaMoE has {num_tokens} tokens, exceeding cap {cap}")
+        if num_tokens:
+            router_logits, _ = self.gate(hidden_states)
+            topk = self.topk(
+                hidden_states,
+                router_logits,
+                num_token_non_padded=forward_batch.num_token_non_padded,
+            )
+        else:
+            # Idle DP ranks must still enter pre-dispatch and the fused collective.
+            topk = self.topk.empty_topk_output(hidden_states.device)
+        buf = _get_mega_moe_symm_buffer(
+            get_moe_ep_group().device_group,
+            num_experts=self.config.num_experts,
+            num_max_tokens_per_rank=cap,
+            num_topk=self.config.num_experts_per_tok,
+            hidden=self.config.hidden_size,
+            intermediate_hidden=self.config.moe_intermediate_size,
+        )
+        # Global expert IDs enter the native dispatcher unchanged. The kernel
+        # returns the combined local-DP output; no post-expert all-reduce applies.
+        return run_sm90_mega_routed(
+            self, hidden_states, topk.topk_ids.to(torch.int32),
+            topk.topk_weights.to(torch.float32), buf, num_tokens,
+        )
