@@ -0,0 +1,64 @@
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Tuple
+
+import torch
+
+from sglang.kernels.jit.utils import (
+    cache_once,
+    is_arch_support_pdl,
+    load_jit,
+    make_cpp_args,
+)
+from sglang.srt.utils.custom_op import register_custom_op
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+# Reduction variant of add_rmsnorm_group_quant.cuh that is bitwise equal to
+# flashinfer's CuTe DSL fused_add_rmsnorm on SM90 (selected by the kernel bench).
+FLASHINFER_EXACT_VARIANT = 0
+
+
+@cache_once
+def _jit_add_rmsnorm_group_quant_module(variant: int) -> Module:
+    args = make_cpp_args(is_arch_support_pdl(), variant)
+    return load_jit(
+        "add_rmsnorm_group_quant",
+        *args,
+        cuda_files=["elementwise/add_rmsnorm_group_quant.cuh"],
+        cuda_wrappers=[("run", f"AddRMSNormGroupQuantKernel<{args}>::run")],
+    )
+
+
+@register_custom_op(mutates_args=["residual", "q", "scale"])
+def add_rmsnorm_group_quant_fp8_out(
+    x: torch.Tensor,
+    residual: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    q: torch.Tensor,
+    scale: torch.Tensor,
+    variant: int = FLASHINFER_EXACT_VARIANT,
+) -> None:
+    _jit_add_rmsnorm_group_quant_module(variant).run(x, residual, weight, eps, q, scale)
+
+
+def add_rmsnorm_group_quant_fp8(
+    x: torch.Tensor,
+    residual: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    variant: int = FLASHINFER_EXACT_VARIANT,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """residual += x, then the FP8 (q, scale) that
+    sglang_per_token_group_quant_fp8(fused_add_rmsnorm output, 128,
+    column_major_scales=True, scale_tma_aligned=True) would return, for BF16
+    hidden size 4096. x itself is left unchanged (no BF16 normed output)."""
+    rows = x.shape[0]
+    q = torch.empty(x.shape, dtype=torch.float8_e4m3fn, device=x.device)
+    # Same layout as create_per_token_group_quant_fp8_output_scale with
+    # column-major TMA-aligned FP32 scales.
+    scale = torch.empty((x.shape[1] // 128, (rows + 3) // 4 * 4), dtype=torch.float32, device=x.device).transpose(0, 1)[:rows]
+    add_rmsnorm_group_quant_fp8_out(x, residual, weight, eps, q, scale, variant)
+    return q, scale
