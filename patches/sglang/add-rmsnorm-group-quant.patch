@@ -0,0 +1,190 @@
+#include <sgl_kernel/tensor.h>
+#include <sgl_kernel/utils.h>
+
+#include <sgl_kernel/math.cuh>
+#include <sgl_kernel/type.cuh>
+#include <sgl_kernel/utils.cuh>
+#include <sgl_kernel/vec.cuh>
+#include <sgl_kernel/warp.cuh>
+
+#include <dlpack/dlpack.h>
+
+#include <cstdint>
+#include <cuda_fp8.h>
+
+// residual += x; y = RMSNorm(residual) * w; (q, s) = per-token-group-128 FP8
+// quant of BF16 y, without materializing y. Bit-identical to the pair
+//   flashinfer fused_add_rmsnorm (CuTe DSL FusedAddRMSNormKernel, BF16, H=4096)
+//   + sglang per_token_group_quant (FP32 scales, column-major, TMA-aligned)
+// that feeds the Qwen3 QKV GEMM: the thread/value layout, the sum-of-squares
+// order and every rounding step follow FusedAddRMSNormKernel for H=4096
+// (128 threads, 2 rows per CTA, 64 threads per row, 16-byte vectors at
+// columns 512*b + 8*t), and the quant follows QuantTrait<bf16, fp8, 128>.
+//
+// kVariant selects the reduction details that the DSL leaves to its compiler
+// (bit 0: element order of the per-thread sum, bit 1: FMA contraction of the
+// squares, bit 2: FMA contraction of mean + eps); the bench picks the variant
+// that is bitwise equal to flashinfer.
+
+namespace {
+
+struct AddRMSNormGroupQuantParams {
+  const void* __restrict__ x;
+  void* __restrict__ residual;
+  const void* __restrict__ weight;
+  void* __restrict__ q;
+  float* __restrict__ scale;
+  int64_t scale_group_stride;
+  uint32_t num_tokens;
+  float eps;
+};
+
+constexpr uint32_t kNormHidden = 4096;
+constexpr uint32_t kNormThreadsPerRow = 64;
+constexpr uint32_t kNormRowsPerBlock = 2;
+constexpr uint32_t kNormChunks = kNormHidden / (8 * kNormThreadsPerRow);  // 8 vectors of 8 BF16
+
+SGL_DEVICE float rsqrt_approx_ftz(const float x) {
+  float y;
+  asm("rsqrt.approx.ftz.f32 %0, %1;" : "=f"(y) : "f"(x));
+  return y;
+}
+
+template <bool kUsePDL, uint32_t kVariant>
+__global__ void __launch_bounds__(kNormThreadsPerRow* kNormRowsPerBlock)
+    add_rmsnorm_group_quant_kernel(const __grid_constant__ AddRMSNormGroupQuantParams params) {
+  using namespace device;
+  using Vec = AlignedVector<bf16x2_t, 4>;
+  using FP8Vec = AlignedVector<fp8x2_e4m3_t, 4>;
+  constexpr bool kBlockMajorSum = (kVariant & 1) != 0;
+  constexpr bool kSeparateSquares = (kVariant & 2) != 0;
+  constexpr bool kSeparateMean = (kVariant & 4) != 0;
+  constexpr float kFP8Max = 448.0f;
+  constexpr float kFP8MaxInv = 1.f / kFP8Max;
+
+  __shared__ float partial[kNormRowsPerBlock][kNormThreadsPerRow / kWarpThreads];
+  const uint32_t t = threadIdx.x % kNormThreadsPerRow;
+  const uint32_t r = threadIdx.x / kNormThreadsPerRow;
+  const uint32_t row = blockIdx.x * kNormRowsPerBlock + r;
+  const bool valid = row < params.num_tokens;
+  const int64_t row_offset = static_cast<int64_t>(row) * kNormHidden;
+
+  PDLWaitPrimary<kUsePDL>();
+
+  float h[kNormChunks][8];
+#pragma unroll
+  for (uint32_t b = 0; b < kNormChunks; ++b) {
+    const int64_t col = 512 * b + 8 * t;
+    Vec xv, rv;
+    if (valid) {
+      xv = load_as<Vec>(params.x, (row_offset + col) / 8);
+      rv = load_as<Vec>(params.residual, (row_offset + col) / 8);
+    } else {
+#pragma unroll
+      for (uint32_t j = 0; j < 4; ++j) xv[j] = rv[j] = bf16x2_t{};
+    }
+    Vec out;
+#pragma unroll
+    for (uint32_t j = 0; j < 4; ++j) {
+      const auto xf = cast<fp32x2_t>(xv[j]);
+      const auto rf = cast<fp32x2_t>(rv[j]);
+      h[b][2 * j] = __fadd_rn(xf.x, rf.x);
+      h[b][2 * j + 1] = __fadd_rn(xf.y, rf.y);
+      out[j] = cast<bf16x2_t, fp32x2_t>({h[b][2 * j], h[b][2 * j + 1]});
+    }
+    if (valid) store_as<Vec>(params.residual, out, (row_offset + col) / 8);
+  }
+
+  float sum = 0.0f;
+#pragma unroll
+  for (uint32_t i = 0; i < kNormChunks * 8; ++i) {
+    const float v = kBlockMajorSum ? h[i % kNormChunks][i / kNormChunks] : h[i / 8][i % 8];
+    sum = kSeparateSquares ? __fadd_rn(sum, __fmul_rn(v, v)) : __fmaf_rn(v, v, sum);
+  }
+#pragma unroll
+  for (uint32_t offset = 1; offset < kWarpThreads; offset <<= 1) {
+    sum = __fadd_rn(sum, __shfl_xor_sync(0xffffffffu, sum, offset));
+  }
+  if (threadIdx.x % kWarpThreads == 0) partial[r][t / kWarpThreads] = sum;
+  __syncthreads();
+  sum = __fadd_rn(partial[r][0], partial[r][1]);
+  constexpr float kInvHidden = 1.0f / kNormHidden;
+  const float mean = kSeparateMean ? __fadd_rn(__fmul_rn(sum, kInvHidden), params.eps) : __fmaf_rn(sum, kInvHidden, params.eps);
+  const float rstd = rsqrt_approx_ftz(mean);
+
+#pragma unroll
+  for (uint32_t b = 0; b < kNormChunks; ++b) {
+    const int64_t col = 512 * b + 8 * t;
+    const auto wv = load_as<Vec>(params.weight, col / 8);
+    Vec y;
+#pragma unroll
+    for (uint32_t j = 0; j < 4; ++j) {
+      const auto wf = cast<fp32x2_t>(wv[j]);
+      y[j] = cast<bf16x2_t, fp32x2_t>({
+          __fmul_rn(__fmul_rn(h[b][2 * j], rstd), __fadd_rn(wf.x, 0.0f)),
+          __fmul_rn(__fmul_rn(h[b][2 * j + 1], rstd), __fadd_rn(wf.y, 0.0f)),
+      });
+    }
+    // QuantTrait<bf16, fp8, 128>: a 128-column group is 16 consecutive lanes.
+    auto amax2 = math::abs(y[0]);
+#pragma unroll
+    for (uint32_t j = 1; j < 4; ++j) amax2 = math::max(amax2, math::abs(y[j]));
+    const auto amax_pair = cast<fp32x2_t>(warp::reduce_max<16>(amax2));
+    const float amax = math::max(math::max(amax_pair.x, amax_pair.y), 1e-10f);
+    const float quant_scale = kFP8Max / amax;
+    FP8Vec qv;
+#pragma unroll
+    for (uint32_t j = 0; j < 4; ++j) {
+      const auto yf = cast<fp32x2_t>(y[j]);
+      qv[j] = fp8x2_e4m3_t{float2{fminf(yf.x * quant_scale, kFP8Max), fminf(yf.y * quant_scale, kFP8Max)}};
+    }
+    if (valid) {
+      store_as<FP8Vec>(params.q, qv, (row_offset + col) / 8);
+      if (t % 16 == 0) params.scale[(col / 128) * params.scale_group_stride + row] = amax * kFP8MaxInv;
+    }
+  }
+
+  PDLTriggerSecondary<kUsePDL>();
+}
+
+template <bool kUsePDL, uint32_t kVariant>
+struct AddRMSNormGroupQuantKernel {
+  static void
+  run(const tvm::ffi::TensorView x,
+      const tvm::ffi::TensorView residual,
+      const tvm::ffi::TensorView weight,
+      double eps,
+      const tvm::ffi::TensorView q,
+      const tvm::ffi::TensorView scale) {
+    using namespace host;
+    auto N = SymbolicSize{"num_tokens"};
+    auto H = SymbolicSize{"hidden_size"};
+    auto G = SymbolicSize{"num_groups"};
+    auto Sg = SymbolicSize{"scale_group_stride"};
+    auto device = SymbolicDevice{};
+    H.set_value(kNormHidden);
+    G.set_value(kNormHidden / 128);
+    device.set_options<kDLCUDA>();
+    TensorMatcher({N, H}).with_dtype<bf16_t>().with_device(device).verify(x).verify(residual);
+    TensorMatcher({H}).with_dtype<bf16_t>().with_device(device).verify(weight);
+    TensorMatcher({N, H}).with_dtype<fp8_e4m3_t>().with_device(device).verify(q);
+    TensorMatcher({N, G}).with_strides({1, Sg}).with_dtype<float>().with_device(device).verify(scale);
+    const auto num_tokens = static_cast<uint32_t>(N.unwrap());
+    if (num_tokens == 0) return;
+    RuntimeCheck(Sg.unwrap() >= N.unwrap(), "scale group stride must cover every token");
+    const auto params = AddRMSNormGroupQuantParams{
+        .x = x.data_ptr(),
+        .residual = residual.data_ptr(),
+        .weight = weight.data_ptr(),
+        .q = q.data_ptr(),
+        .scale = static_cast<float*>(scale.data_ptr()),
+        .scale_group_stride = static_cast<int64_t>(Sg.unwrap()),
+        .num_tokens = num_tokens,
+        .eps = static_cast<float>(eps),
+    };
+    LaunchKernel(div_ceil(num_tokens, kNormRowsPerBlock), kNormThreadsPerRow * kNormRowsPerBlock, device.unwrap())  //
+        .enable_pdl(kUsePDL)(add_rmsnorm_group_quant_kernel<kUsePDL, kVariant>, params);
+  }
+};
+
+}  // namespace
