+"""Prefill MegaMoE input without the pre-dispatch kernel (Qwen3, H4096, 128 experts, top-8).
+
+control:    fused_add_rmsnorm -> gate GEMM -> zeros(bias) -> router -> mega_moe_pre_dispatch_sm90
+fused:      post_norm_moe_input (residual, BF16 y, FP8 x, FP32 scales, pad slots)
+            -> gate GEMM -> router writing the MegaMoE buffer's top-k directly
+fused-gate: post_norm_moe_input -> gate_route_into_buffer (gate GEMM + router in one kernel)
+
+The FP8 values and scales are those mega_moe_pre_dispatch_sm90 computes from the
+same BF16 y (IEEE division absmax / 448 and 1 / scale, product, cvt.rn.satfinite
+to E4M3, row-major FP32 scales); the residual is rounded as in flashinfer's
+fused_add_rmsnorm; y follows the deployed input norm_quant (FP32 sum order of a
+4096-wide reduction may differ from flashinfer by rounding).
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.kernels.jit.utils import is_arch_support_pdl
+from sglang.kernels.ops.moe.moe_fused_gate import _SCORING_FUNC_MAP, _router_triton_kernel
+
+
+@triton.jit
+def _post_norm_moe_input(X, R, W, Q, S, IDS, TW, num_tokens, eps: tl.constexpr, TOPK: tl.constexpr):
+    row = tl.program_id(0)
+    if row < num_tokens:
+        col = tl.arange(0, 4096)
+        # Same arithmetic as the input norm_quant: unrounded FP32 sum, BF16 residual.
+        h = tl.load(X + row * 4096 + col).to(tl.float32) + tl.load(R + row * 4096 + col).to(tl.float32)
+        tl.store(R + row * 4096 + col, h)
+        rstd = tl.rsqrt(tl.sum(h * h, 0) / 4096.0 + eps)
+        y = ((h * rstd) * tl.load(W + col).to(tl.float32)).to(tl.bfloat16)
+        # In place, as fused_add_rmsnorm leaves y in X for the router gate.
+        tl.store(X + row * 4096 + col, y)
+        groups = tl.reshape(y.to(tl.float32), (32, 128))
+        scale = tl.div_rn(tl.maximum(tl.max(tl.abs(groups), 1), 1.0e-10), 448.0)
+        inverse = tl.div_rn(tl.full((32,), 1.0, tl.float32), scale)
+        q = (groups * inverse[:, None]).to(tl.float8e4nv)
+        tl.store(Q + row * 4096 + col, tl.reshape(q, (4096,)))
+        tl.store(S + row * 32 + tl.arange(0, 32), scale)
+    else:
+        # Slots past num_tokens: the masking pre-dispatch writes.
+        slot = row * TOPK + tl.arange(0, TOPK)
+        tl.store(IDS + slot, tl.full((TOPK,), -1, tl.int64))
+        tl.store(TW + slot, tl.zeros((TOPK,), tl.float32))
+
+
+def post_norm_moe_input(x, residual, weight, eps, buf_x, buf_x_sf, buf_topk_idx, buf_topk_weights):
+    """residual += x; x = RMSNorm(residual) * weight (BF16, in place); FP8 x,
+    scales and pad slots into the MegaMoE buffer, as pre-dispatch writes them."""
+    rows = x.shape[0]
+    assert x.shape[1] == 4096 and x.dtype == residual.dtype == weight.dtype == torch.bfloat16
+    assert x.is_contiguous() and residual.is_contiguous() and weight.is_contiguous()
+    assert buf_x.dtype == torch.float8_e4m3fn and buf_x.shape[1] == 4096 and buf_x.is_contiguous()
+    assert buf_x_sf.dtype == torch.float32 and buf_x_sf.shape == (buf_x.shape[0], 32) and buf_x_sf.is_contiguous()
+    assert buf_topk_idx.dtype == torch.int64 and buf_topk_weights.dtype == torch.float32
+    assert buf_topk_idx.shape == buf_topk_weights.shape == (buf_x.shape[0], buf_topk_idx.shape[1])
+    assert buf_topk_idx.is_contiguous() and buf_topk_weights.is_contiguous() and 0 < rows <= buf_x.shape[0]
+    _post_norm_moe_input[(buf_x.shape[0],)](x, residual, weight, buf_x, buf_x_sf, buf_topk_idx, buf_topk_weights, rows, eps, buf_topk_idx.shape[1], num_warps=8, enable_fp_fusion=False)
+
+
+def route_into_buffer(router_logits, zero_bias, buf_topk_idx, buf_topk_weights):
+    """moe_fused_gate(router_logits, zero_bias, 8, "softmax", renormalize=True)
+    with its int32 ids widened and its weights stored into the buffer rows."""
+    rows, experts = router_logits.shape
+    assert experts == 128 and buf_topk_idx.shape[1] == 8 and zero_bias.shape == (128,) and zero_bias.dtype == torch.float32
+    use_pdl = is_arch_support_pdl()
+    extra = {"launch_pdl": True} if use_pdl else {}
+    _router_triton_kernel[(triton.cdiv(rows, 2),)](
+        router_logits,
+        zero_bias,
+        buf_topk_weights,
+        buf_topk_idx,
+        rows,
+        1.0,
+        0.0,
+        N=128,
+        K=8,
+        K_ROUTED=8,
+        BLOCK_M=2,
+        BLOCK_N=128,
+        BLOCK_K=8,
+        N_GROUP=1,
+        TOPK_GROUP=1,
+        EXPERTS_PER_GROUP=128,
+        BLOCK_G=1,
+        SCORING_FUNC=_SCORING_FUNC_MAP["softmax"],
+        HAS_SOFTCAP=False,
+        RENORMALIZE=True,
+        APPLY_SCALE=False,
+        USE_PDL=use_pdl,
+        stride_sm=router_logits.stride(0),
+        stride_sn=router_logits.stride(1),
+        stride_wm=buf_topk_weights.stride(0),
+        stride_wk=buf_topk_weights.stride(1),
+        stride_im=buf_topk_idx.stride(0),
+        stride_ik=buf_topk_idx.stride(1),
+        num_token_non_padded=None,
+        FUSE_DECODE_PADDING=False,
+        num_warps=1,
+        **extra,
+    )
+
+
+@triton.jit
+def _gate_route(Y, G, IDS, TW, M, BLOCK_M: tl.constexpr, BLOCK_K: tl.constexpr):
+    offs_m = tl.program_id(0) * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_n = tl.arange(0, 128)
+    offs_k = tl.arange(0, BLOCK_K)
+    mask_m = offs_m < M
+    acc = tl.zeros((BLOCK_M, 128), dtype=tl.float32)
+    for k in range(0, 4096, BLOCK_K):
+        a = tl.load(Y + offs_m[:, None] * 4096 + (k + offs_k)[None, :], mask=mask_m[:, None], other=0.0)
+        b = tl.load(G + offs_n[None, :] * 4096 + (k + offs_k)[:, None])
+        acc = tl.dot(a, b, acc)
+    # BF16 logits, as the gate GEMM returns them; then the router's softmax path
+    # with a zero bias, top-8 by lowest expert id on ties, renormalized.
+    biased = acc.to(tl.bfloat16).to(tl.float32) + 0.0
+    row_max = tl.max(biased, axis=1)[:, None]
+    exp_row = tl.exp(biased - row_max)
+    activated = exp_row / tl.sum(exp_row, axis=1)[:, None]
+    biased = tl.where(biased == biased, biased, -1e30)
+    offs_s = tl.arange(0, 8)
+    selected_vals = tl.zeros((BLOCK_M, 8), dtype=tl.float32)
+    selected_idx = tl.zeros((BLOCK_M, 8), dtype=tl.int32)
+    cur = biased
+    for k in tl.static_range(8):
+        max_val = tl.max(cur, axis=1)[:, None]
+        lane_id = tl.where(cur == max_val, offs_n[None, :], 129)
+        win_lane = tl.min(lane_id, axis=1)[:, None].to(tl.int32)
+        win_activated = tl.sum(tl.where(offs_n[None, :] == win_lane, activated, 0.0), axis=1)[:, None]
+        slot = offs_s[None, :] == k
+        selected_vals = tl.where(slot, win_activated, selected_vals)
+        selected_idx = tl.where(slot, win_lane, selected_idx)
+        cur = tl.where(offs_n[None, :] == win_lane, -float("inf"), cur)
+    routed_sum = tl.sum(selected_vals, axis=1)[:, None]
+    selected_vals = selected_vals / tl.where(routed_sum > 0.0, routed_sum, 1.0)
+    out = offs_m[:, None] * 8 + offs_s[None, :]
+    tl.store(TW + out, selected_vals, mask=mask_m[:, None])
+    tl.store(IDS + out, selected_idx, mask=mask_m[:, None])
+
+
+def gate_route_into_buffer(y, gate_weight, buf_topk_idx, buf_topk_weights):
+    """route_into_buffer(y @ gate_weight.T) in one kernel; BF16 logits may differ
+    from the separate GEMM by accumulation order."""
+    rows = y.shape[0]
+    assert y.shape[1] == 4096 and y.dtype == gate_weight.dtype == torch.bfloat16 and y.is_contiguous()
+    assert gate_weight.shape == (128, 4096) and gate_weight.is_contiguous()
+    assert buf_topk_idx.shape[1] == 8 and buf_topk_idx.is_contiguous() and buf_topk_weights.is_contiguous()
+    _gate_route[(triton.cdiv(rows, 64),)](y, gate_weight, buf_topk_idx, buf_topk_weights, rows, BLOCK_M=64, BLOCK_K=128, num_warps=4, num_stages=4)
