+def prewarm_qkv_tail(model):
+    """Load both kernels once in this Prefill process, before pools/graphs/ready."""
+    from sglang.srt.runtime_context import get_server_args
+
+    global _qkv_tail_prewarmed
+    if _qkv_tail_prewarmed or os.environ.get("SGLANG_PREFILL_QKV_TAIL_SPLIT") != "1" or get_server_args().disaggregation_mode != "prefill":
+        return
+    import logging
+    import time
+
+    from sglang.srt.models.qwen3_moe import Qwen3MoeAttention
+
+    started = time.perf_counter()
+    for attention in model.modules():
+        if not isinstance(attention, Qwen3MoeAttention) or not linear_supported(attention, "QKV", attention.qkv_proj):
+            continue
+        layer = attention.qkv_proj
+        # Match both group-quant and fused input-norm allocations: E4M3 A,
+        # FP32 column-major scales (stride 1,7988), BF16 out. No RNG/forward.
+        with torch.inference_mode():
+            a = torch.zeros((7988, 4096), device=layer.weight.device, dtype=torch.float8_e4m3fn)
+            sa = torch.ones((32, 7988), device=a.device, dtype=torch.float32).T
+            out = torch.empty((7988, 9216), device=a.device, dtype=torch.bfloat16)
+            _qkv_tail_gemm(a, sa, layer.weight, layer.weight_scale_inv, out)
+            torch.cuda.synchronize(a.device)
+        # Same kernel geometry for every local layer: keep no scratch tensors
+        # or per-layer state, and leave the real serving dispatch log untouched.
+        _qkv_tail_prewarmed = True
+        logging.getLogger(__name__).warning("Prefill r30 qkv-tail prewarm done ms=%.3f pid=%s", (time.perf_counter() - started) * 1000, os.getpid())
+        return
+    raise RuntimeError("Prefill r30 qkv-tail prewarm found no supported QKV layer")
+
