+def _qkv_tail_gemm(a, sa, weight, weight_scale, out):
+    """Shared eager calls: preserve parent scale stride in body and tail views."""
+    import deep_gemm
+
+    deep_gemm.fp8_gemm_nt((a[:7936], sa[:7936]), (weight, weight_scale), out[:7936], compiled_dims="nk")
+    deep_gemm.fp8_gemm_nt((a[7936:], sa[7936:]), (weight, weight_scale), out[7936:], compiled_dims="nk")
+
+
+def dense_gemm(a, sa, weight, weight_scale, out, *, tail_split=False):
+    """Split only QKV's exact measured shape on the current stream."""
+    import deep_gemm
+
+    if tail_split and a.shape == (7988, 4096) and weight.shape == (9216, 4096):
+        _qkv_tail_gemm(a, sa, weight, weight_scale, out)
+        _log_qkv_tail_dispatch()
+    else:
+        deep_gemm.fp8_gemm_nt((a, sa), (weight, weight_scale), out, compiled_dims="nk")
+
+
+_qkv_tail_dispatch_logged = False
+_qkv_tail_prewarmed = False
