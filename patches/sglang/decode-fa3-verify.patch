+"""Bounded opt-in EAGLE3 verify kernels; fixed image companion ABI."""
+
+import json
+from pathlib import Path
+
+import torch
+
+LIBRARY = Path("/opt/apac/fa3-verify/libapac_fa3_verify.so")
+CANDIDATES = json.loads(LIBRARY.with_name("candidates.json").read_text())
+NAMES = tuple(c["name"] for c in CANDIDATES)
+_loaded = False
+
+
+def load():
+    global _loaded
+    if not _loaded:
+        torch.ops.load_library(str(LIBRARY))
+
+        @torch.library.register_fake("apac_fa3_verify::prepare")
+        def prepare_fake(lengths, cu_q, metadata, candidate):
+            return None
+
+        @torch.library.register_fake("apac_fa3_verify::fwd_out")
+        def fwd_fake(q, k, v, pages, lengths, cu_q, out, lse, partial, partial_lse, metadata, candidate, scale):
+            return None
+
+        @torch.library.register_fake("apac_fa3_verify::fwd_fp8_out")
+        def fwd_fp8_fake(q, k, v, pages, lengths, cu_q, out, lse, partial, partial_lse, metadata, candidate, scale, scales):
+            return None
+
+        @torch.library.register_fake("apac_fa3_verify::prefill_fwd_out")
+        def prefill_fake(q, k, v, cu, out, scales, lse, metadata, maxlen, scale):
+            return None
+
+        @torch.library.register_fake("apac_fa3_verify::prefill_fixed_fwd_out")
+        def prefill_fixed_fake(q, k, v, cu, out, scales, lse, metadata, maxlen, scale):
+            return None
+
+        _loaded = True
+
+
+def output_fp8(name):
+    return CANDIDATES[NAMES.index(name)]["output"] == "fp8"
+
+
+def allocate(lengths, name):
+    load()
+    candidate = NAMES.index(name)
+    batch = lengths.numel()
+    assert 32 <= batch <= 48
+    spec = CANDIDATES[candidate]
+    splits = spec["splits"]
+    options = {"device": lengths.device, "dtype": torch.float32}
+    return {
+        "candidate": candidate,
+        "spec": spec,
+        "metadata": torch.empty(4 * ((batch + 3) // 4 * 4) + 1 + (batch * 4 if spec.get("merge") else 0), device=lengths.device, dtype=torch.int32),
+        "lse": torch.empty((64, 4 * batch), **options),
+        "partial": torch.empty((splits, 64, 4 * batch, 128) if splits > 1 else (0,), **options),
+        "partial_lse": torch.empty((splits, 64, 4 * batch) if splits > 1 else (0,), **options),
+    }
+
+
+def prepare(state, lengths, cu_q):
+    torch.ops.apac_fa3_verify.prepare(lengths, cu_q, state["metadata"], state["candidate"])
+
+
+def forward(state, q, k, v, pages, lengths, cu_q, scale, out=None):
+    if state["spec"]["output"] == "fp8":
+        rows = q.shape[0]
+        if isinstance(out, tuple):
+            out, scales = out
+        else:
+            out = torch.empty_like(q)
+            scales = torch.empty((64, (rows + 3) // 4 * 4), device=q.device, dtype=torch.float32).T[:rows]
+        torch.ops.apac_fa3_verify.fwd_fp8_out(q, k, v, pages, lengths, cu_q, out, state["lse"], state["partial"], state["partial_lse"], state["metadata"], state["candidate"], scale, scales)
+        return out.view(rows, 8192), scales
+    if out is None:
+        out = torch.empty_like(q, dtype=torch.bfloat16)
+    torch.ops.apac_fa3_verify.fwd_out(q, k, v, pages, lengths, cu_q, out, state["lse"], state["partial"], state["partial_lse"], state["metadata"], state["candidate"], scale)
+    return out
