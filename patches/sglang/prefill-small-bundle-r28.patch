+def dense_gemm(a, sa, weight, weight_scale, out, *, tail_split=False):
+    """Two ordinary kernels on the current stream; no mainloop modification."""
+    import deep_gemm
+
+    if tail_split and a.shape[0] == 7988 and (weight.shape[0], a.shape[1]) in ((9216, 4096), (4096, 8192)):
+        # 7936 is aligned to BM256, group128 and TMA's 16-byte requirement.
+        # Keep the original column-major scale stride in both descriptors.
+        deep_gemm.fp8_gemm_nt((a[:7936], sa[:7936]), (weight, weight_scale), out[:7936], compiled_dims="nk")
+        deep_gemm.fp8_gemm_nt((a[7936:], sa[7936:]), (weight, weight_scale), out[7936:], compiled_dims="nk")
+    else:
+        deep_gemm.fp8_gemm_nt((a, sa), (weight, weight_scale), out, compiled_dims="nk")
+
+
