@@ -0,0 +1,27 @@
+"""Decode admission without host waits on the WAR-fenced schedule stream.
+
+SGLANG_DECODE_ASYNC_ADMISSION=1 replaces the blocking host-to-device copies of
+the disaggregated Decode admission path (prealloc and prebuilt batch setup)
+with copies from a fresh pinned snapshot, enqueued on the same current stream.
+GPU-side ordering is unchanged; only the host cudaStreamSynchronize, which
+waits for the in-flight forward's WAR fence, is skipped.
+"""
+
+import os
+
+import torch
+
+ENABLED = os.environ.get("SGLANG_DECODE_ASYNC_ADMISSION", "0") == "1"
+
+
+def to_device(data, dtype, device) -> torch.Tensor:
+    """Same values as torch.tensor(data, dtype=dtype, device=device), no host wait."""
+    if isinstance(data, torch.Tensor):
+        source = data if dtype is None else data.to(dtype=dtype)
+        # Always copy: the source may be a reusable (e.g. metadata) buffer.
+        host = torch.empty(source.shape, dtype=source.dtype, pin_memory=True)
+        host.copy_(source)
+    else:
+        host = torch.tensor(data, dtype=dtype, pin_memory=True)
+    # The caching host allocator keeps the pinned block until this copy is done.
+    return host.to(device, non_blocking=True)
