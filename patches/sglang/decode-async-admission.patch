+    def _defer_send_metadata(
+        self,
+        decode_req: DecodeRequest,
+        kv_indices: torch.Tensor,
+        kv_transfer_page_size: int,
+        state_indices: Optional[List],
+        total_prefix_len: int,
+    ) -> bool:
+        """Read the page indices back without a host wait; send them later.
+
+        The readback and its completion event are enqueued on the current
+        (schedule) stream where kv_to_page_indices would have synchronised, so
+        the Prefill still receives the indices only after the stream has passed
+        the WAR fence, the allocation and the req_to_token write.
+        """
+        if (
+            not async_admission.ENABLED
+            or not kv_indices.is_cuda
+            or decode_req.is_rebootstrap
+            or self.scheduler.enable_hisparse
+            or self.transfer_queue.enable_staging
+        ):
+            return False
+        pages = kv_indices[::kv_transfer_page_size] // kv_transfer_page_size
+        host = torch.empty(pages.shape, dtype=pages.dtype, pin_memory=True)
+        host.copy_(pages, non_blocking=True)
+        done = torch.cuda.Event()
+        done.record()
+        self._deferred_metadata.append(
+            (decode_req, host, done, state_indices, total_prefix_len)
+        )
+        return True
+
+    def flush_deferred_metadata(self) -> None:
+        """Send page indices whose readback finished, in allocation order."""
+        while self._deferred_metadata and self._deferred_metadata[0][2].query():
+            decode_req, host, _, state_indices, total_prefix_len = (
+                self._deferred_metadata.pop(0)
+            )
+            receiver = decode_req.kv_receiver
+            # Aborted or failed meanwhile: the transfer queue releases its pages
+            # and metadata slot; the Prefill never learns these indices.
+            if receiver is None or receiver.poll() == KVPoll.Failed:
+                continue
+            receiver.send_metadata(
+                host.numpy().astype(np.int32),
+                decode_req.metadata_buffer_index,
+                state_indices,
+                decode_prefix_len=total_prefix_len,
+            )
