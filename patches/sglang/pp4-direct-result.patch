+# Tag of the direct last-stage -> stage result messages on the PP CPU group.
+# Proxy metadata uses tag 0 on that group, so the two message streams never mix.
+_QWEN_PP_RESULT_TAG = 4
+
+
+@dataclass
+class _QwenPPLaunch:
+    """What a stage keeps from one launched microbatch until its result step."""
+
+    rids: List[str]
+    copy_done: torch.Event
+    page_indices_cpu: list
+    can_run_cuda_graph: bool
+    # Last stage only: host copies of the next tokens and EAGLE draft outputs.
+    next_token_ids: Optional[torch.Tensor] = None
+    draft_output_cpu: Optional[tuple] = None
+
+
+@dataclass
+class _QwenPPLoop:
+    bmbs: list
+    tmbs: list
+    launches: list
+    # Asynchronous CPU sends, kept alive until gloo completes them.
+    works: list
+    # Last stage only.
+    publisher: Optional["_QwenPPResultPublisher"]
+
+
+class _QwenPPResultPublisher:
+    """Last stage: send each microbatch's result to the other stages when ready.
+
+    A daemon thread takes launched microbatches in launch order, waits for the
+    copy-stream event that follows the forward (Event.synchronize releases the
+    GIL) and sends the host copies to stages 0..pp_size-2 with
+    send_object(tag=_QWEN_PP_RESULT_TAG). The scheduler thread never waits for
+    a forward here: if it did, its own result step (and with it the last
+    stage's KV and aux send) would trail its newer forwards by several stage
+    periods, and stage 0, which waits for the last stage's consensus, would
+    lose its launch lead.
+    """
+
+    def __init__(self, pp_group, num_receivers: int):
+        self.pp_group = pp_group
+        self.num_receivers = num_receivers
+        self.launches = queue.SimpleQueue()
+        threading.Thread(
+            target=self._run, name="qwen-pp-result-publisher", daemon=True
+        ).start()
+
+    def put(self, launch: _QwenPPLaunch) -> None:
+        self.launches.put(launch)
+
+    def _run(self) -> None:
+        try:
+            device = self.pp_group.device
+            torch.get_device_module(device).set_device(device)
+            works = []
+            while True:
+                launch = self.launches.get()
+                launch.copy_done.synchronize()
+                payload = (
+                    launch.rids,
+                    launch.next_token_ids.tolist(),
+                    *launch.draft_output_cpu,
+                )
+                for rank in range(self.num_receivers):
+                    works += self.pp_group.send_object(
+                        payload, dst=rank, async_send=True, tag=_QWEN_PP_RESULT_TAG
+                    )
+                works = [w for w in works if not w.work.is_completed()]
+        except BaseException:
+            # Same crash path as run_scheduler_process: never leave the other
+            # stages waiting for a result that will not come.
+            import psutil
+
+            from sglang.utils import get_exception_traceback
+
+            logger.error(f"PP result publisher failed: {get_exception_traceback()}")
+            psutil.Process().parent().send_signal(signal.SIGQUIT)
+            raise
+
+
