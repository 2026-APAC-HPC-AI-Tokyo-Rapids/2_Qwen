+    # Copy-engine setup and the device operations of the transport.
+    def _qpp_ce_setup(self: Scheduler) -> _QwenPPCopyEngine:
+        """Allocate receive buffers, create send events and exchange their IPC
+        handles with the neighbours. Any failure only marks this stage not ok;
+        the exchange still completes, and validation then keeps PyNccl."""
+        from torch.multiprocessing.reductions import reduce_tensor
+
+        cfg = self.model_config
+        ce = _QwenPPCopyEngine(
+            slots=self.pp_loop_size,
+            width=4,
+            rows=self.server_args.chunked_prefill_size,
+            hidden=cfg.hidden_size,
+            dtype=cfg.dtype,
+        )
+        group = self.world_group.cpu_group
+        ranks = self.pp_group.ranks
+        stage = self.pp_group.rank_in_group
+        rank = ranks[stage]
+        device = self.pp_group.device
+        first, last = self.pp_group.is_first_rank, self.pp_group.is_last_rank
+        buffers_handle = events_handle = None
+        try:
+            if not first:
+                ce.buffers = torch.empty(
+                    (ce.slots, ce.width, ce.rows, ce.hidden), dtype=ce.dtype, device=device
+                )
+                ce.mismatches = torch.zeros((), dtype=torch.int64, device=device)
+                ce.checked = torch.cuda.Event()
+                buffers_handle = reduce_tensor(ce.buffers)
+            if not last:
+                ce.stream = torch.cuda.Stream(device=device)
+                ce.events = [torch.cuda.Event(interprocess=True) for _ in range(ce.slots)]
+                events_handle = (device.index, [event.ipc_handle() for event in ce.events])
+        except Exception:
+            logger.exception("PP4 copy-engine setup failed on this stage")
+            ce.ok = False
+        works = []
+        if not first:
+            works += point_to_point_pyobj([buffers_handle], rank, group, rank, ranks[stage - 1], async_send=True)
+        if not last:
+            works += point_to_point_pyobj([events_handle], rank, group, rank, ranks[stage + 1], async_send=True)
+        if not last:
+            (handle,) = point_to_point_pyobj([], rank, group, ranks[stage + 1], rank)
+            try:
+                rebuild, args = handle
+                ce.peer_buffers = rebuild(*args)
+            except Exception:
+                logger.exception("PP4 copy-engine peer buffers unavailable")
+                ce.ok = False
+        if not first:
+            (handle,) = point_to_point_pyobj([], rank, group, ranks[stage - 1], rank)
+            try:
+                peer_device, handles = handle
+                ce.peer_events = [
+                    torch.cuda.Event.from_ipc_handle(peer_device, h) for h in handles
+                ]
+            except Exception:
+                logger.exception("PP4 copy-engine peer events unavailable")
+                ce.ok = False
+        for work in works:
+            work.work.wait()
+        return ce
+
+    def _qpp_ce_copy(self: Scheduler, ce: _QwenPPCopyEngine, slot: int, tensors):
+        ce.stream.wait_stream(self.forward_stream)
+        with torch.cuda.stream(ce.stream):
+            for index, tensor in enumerate(tensors):
+                assert tensor.is_contiguous()
+                ce.peer_buffers[slot, index, : tensor.shape[0]].copy_(tensor, non_blocking=True)
+                tensor.record_stream(ce.stream)
+            ce.events[slot].record(ce.stream)
+
+    def _qpp_ce_decide(self: Scheduler, ce: _QwenPPCopyEngine):
+        """After _QWEN_PP_CE_VALIDATE launches every stage votes once; the copy
+        engine is used only if every stage set up and every receiver saw
+        bit-identical slots for all validated transfers."""
+        ok = ce.ok
+        if ok and ce.buffers is not None:
+            ce.checked.synchronize()
+            ok = ce.validated > 0 and int(ce.mismatches.cpu()) == 0
+        vote = torch.tensor([int(ok)], dtype=torch.int64)
+        torch.distributed.all_reduce(
+            vote, op=torch.distributed.ReduceOp.MIN, group=self.world_group.cpu_group
+        )
+        ce.mode = "copy" if int(vote) else "nccl"
+        logger.info(
+            f"PP4 proxy transport: {ce.mode} (this stage {'ok' if ok else 'failed'} "
+            f"after {_QWEN_PP_CE_VALIDATE} validated launches)"
+        )
