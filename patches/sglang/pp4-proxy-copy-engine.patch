+# Proxy transfers that run on both paths (copy engine and in-stream PyNccl)
+# and are compared before every stage switches to the copy engine.
+_QWEN_PP_CE_VALIDATE = 16
+
+
+@dataclass
+class _QwenPPCopyEngine:
+    """Proxy hidden states over copy-engine peer copies between neighbouring
+    stages (all four stages of a pipeline are GPUs of one NVLink node).
+
+    The receiver owns `slots` buffers of [width, rows, hidden]; the sender
+    copies a microbatch's proxy tensors into the receiver's buffer with
+    cudaMemcpyAsync on a side stream and records an interprocess event there,
+    then sends the metadata over the CPU group as before; the receiver's
+    forward stream waits on that event. No SM runs the transfer, and the
+    sender never waits for the receiver. Slot n % slots is safe to overwrite:
+    a stage launches microbatch n + pp_loop_size only after it applied the
+    result of microbatch n, so the receiver (and every later stage) has
+    finished with that slot and has issued its wait on the slot's event.
+    """
+
+    slots: int
+    width: int
+    rows: int
+    hidden: int
+    dtype: torch.dtype
+    # "validate" (both paths, compared), "copy" or "nccl" (in-stream PyNccl).
+    mode: str = "validate"
+    ok: bool = True
+    launches: int = 0
+    sent: int = 0
+    received: int = 0
+    validated: int = 0
+    # Sender: the next stage's buffers mapped here, a side stream, own events.
+    peer_buffers: Optional[torch.Tensor] = None
+    stream: Optional[torch.cuda.Stream] = None
+    events: Optional[list] = None
+    # Receiver: own buffers, the previous stage's events, mismatch count.
+    buffers: Optional[torch.Tensor] = None
+    peer_events: Optional[list] = None
+    mismatches: Optional[torch.Tensor] = None
+    checked: Optional[torch.Event] = None
+
+    def fits(self, shapes) -> bool:
+        return len(shapes) <= self.width and all(
+            dtype == self.dtype and len(size) == 2 and size[0] <= self.rows and size[1] == self.hidden
+            for dtype, size in shapes
+        )
+
