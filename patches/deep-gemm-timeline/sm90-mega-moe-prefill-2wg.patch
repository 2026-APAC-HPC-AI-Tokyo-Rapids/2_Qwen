+#pragma once
+
+// Bench-only phase timeline for sm90_fp8_mega_moe_impl.
+//
+// The compiled host code fixes the kernel signature, so the records live in
+// extra bytes that the benchmark appends to the symmetric buffer: the first
+// 4096-byte boundary after the last layout region the kernel knows (the
+// combine buffer). Each CTA writes its own rows; nothing reads them on device.
+// Layout (uint64 words): header[kHeaderWords],
+// events[gridDim.x][kNumEvents][2] = {%globaltimer ns, clock64},
+// counters[gridDim.x][kNumCounters].
+// Counters accumulate in the unused tail of the 1024-byte expert-count SMEM
+// block (one writer lane per counter) to keep them out of the tight
+// producer-warp register budgets; each role flushes its own at its end.
+
+#include <cstdint>
+#include <cutlass/cutlass.h>
+
+namespace deep_gemm::sm90_timeline {
+
+constexpr uint64_t kMagic = 0x314c544d4f45474dull;
+constexpr uint64_t kVersion = 3;
+constexpr uint32_t kHeaderWords = 16;
+constexpr uint32_t kNumEvents = 48;
+constexpr uint32_t kNumCounters = 32;
+constexpr uint64_t kAlignment = 4096;
+
+enum Event : uint32_t {
+    kEntry = 0,
+    // Dispatch warp 0 (thread 0)
+    kDispCount = 1,
+    kDispSendCount = 2,
+    kDispGridSync = 3,
+    kDispRecvCount = 4,
+    kDispPrePullBarrier = 5,
+    kDispEpilogueSync = 6,
+    kDispFirstPull = 7,
+    kDispLastPull = 8,
+    kDispLoopExit = 9,
+    kDispCombineSync = 10,
+    kDispClean = 11,
+    kDispFinalGridSync = 12,
+    kDispExit = 13,
+    // TMA A + SFA warp
+    kAStart = 14,
+    kAFirstBlock = 15,
+    kAFirstL1Ready = 16,
+    kALastL1Issued = 17,
+    kAFirstL2Ready = 18,
+    kAExit = 19,
+    // TMA B warp
+    kBStart = 20,
+    kBFirstBlock = 21,
+    kBExit = 22,
+    // Math WG0: events 23..29; Prefill WG1 duplicates them at 40..46.
+    kMStart = 23,
+    kMDispatchSync = 24,
+    kMFirstL1Full = 25,
+    kMLastL1End = 26,
+    kMFirstL2Full = 27,
+    kMLastL2End = 28,
+    kMLoopExit = 29,
+    kMCombineGridSync = 30,
+    kMCombineBarrier = 31,
+    kMDispatchSync2 = 32,
+    kMCombineEnd = 33,  // max over all combine warps of the CTA (same SM clock)
+};
+
+enum Counter : uint32_t {
+    kDispTokensW0 = 0,
+    kDispTokensW1 = 1,
+    kDispPullWaitW0 = 2,
+    kDispPullWaitW1 = 3,
+    kAL1Blocks = 4,
+    kAL2Blocks = 5,
+    kAL1ArrivalWait = 6,
+    kAL2ArrivalWait = 7,
+    kAEmptyWait = 8,
+    kBEmptyWait = 9,
+    kML1Blocks = 10,
+    kML2Blocks = 11,
+    kML1FullWait = 12,
+    kML2FullWait = 13,
+    kML1Busy = 14,
+    kML2Busy = 15,
+    kMCombineTokensW0 = 16,
+    kMCombineWaitW0 = 17,
+    kBBlocks = 18,
+    // WG1 copies math counters 10..15 at 24..29, loops 19..20 at 30..31.
+    // Math warpgroup 0: block start -> end of the K loop (before the epilogue)
+    kML1Loop = 19,
+    kML2Loop = 20,
+    // Dispatch warp 0, per pulled token (cycles): loop top -> token TMA issue (expert/rank
+    // selection and source-index load), TMA issue -> remote SF/weight copied (Decode path),
+    // TMA wait done -> local TMA store complete + arrival issued.
+    kDispIndexW0 = 21,
+    kDispRemoteW0 = 22,
+    kDispStoreW0 = 23,
+};
+
+CUTLASS_DEVICE uint64_t global_ns() {
+    uint64_t t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t) :: "memory");
+    return t;
+}
+
+CUTLASS_DEVICE uint64_t cycles64() {
+    uint64_t c;
+    asm volatile("mov.u64 %0, %%clock64;" : "=l"(c) :: "memory");
+    return c;
+}
+
+// 32-bit SM cycles for accumulated waits; no memory clobber in hot loops.
+CUTLASS_DEVICE uint32_t cycles() {
+    uint32_t c;
+    asm volatile("mov.u32 %0, %%clock;" : "=r"(c));
+    return c;
+}
+
+struct Timeline {
+    uint64_t* base;
+
+    CUTLASS_DEVICE explicit Timeline(const void* layout_end) {
+        base = reinterpret_cast<uint64_t*>(
+            (reinterpret_cast<uint64_t>(layout_end) + kAlignment - 1) / kAlignment * kAlignment);
+    }
+
+    CUTLASS_DEVICE uint64_t* event_ptr(const uint32_t& event) const {
+        return base + kHeaderWords + (static_cast<uint64_t>(blockIdx.x) * kNumEvents + event) * 2;
+    }
+
+    CUTLASS_DEVICE void record(const uint32_t& event, const uint64_t& ns, const uint64_t& clk) const {
+        const auto ptr = event_ptr(event);
+        ptr[0] = ns;
+        ptr[1] = clk;
+    }
+
+    CUTLASS_DEVICE void record(const uint32_t& event) const {
+        const auto ns = global_ns();
+        record(event, ns, cycles64());
+    }
+
+    // Region is zeroed by the host before each call.
+    CUTLASS_DEVICE void record_max(const uint32_t& event) const {
+        const auto ns = global_ns();
+        const auto clk = cycles64();
+        const auto ptr = reinterpret_cast<unsigned long long*>(event_ptr(event));
+        atomicMax(ptr, static_cast<unsigned long long>(ns));
+        atomicMax(ptr + 1, static_cast<unsigned long long>(clk));
+    }
+
+    CUTLASS_DEVICE void counter(const uint32_t& index, const uint64_t& value) const {
+        base[kHeaderWords + static_cast<uint64_t>(gridDim.x) * kNumEvents * 2 +
+             static_cast<uint64_t>(blockIdx.x) * kNumCounters + index] = value;
+    }
+
+    CUTLASS_DEVICE void header(const uint32_t& num_tokens, const uint32_t& rank_idx,
+                               const uint32_t& block_m, const uint32_t& block_n,
+                               const uint32_t& num_epilogue_threads, const uint32_t& num_stages,
+                               const uint32_t& num_dispatch_threads, const uint32_t& num_experts_per_rank) const {
+        base[1] = kVersion;
+        base[2] = gridDim.x;
+        base[3] = kNumEvents;
+        base[4] = kNumCounters;
+        base[5] = num_tokens;
+        base[6] = rank_idx;
+        base[7] = block_m;
+        base[8] = block_n;
+        base[9] = num_epilogue_threads;
+        base[10] = num_stages;
+        base[11] = num_dispatch_threads;
+        base[12] = num_experts_per_rank;
+        base[0] = kMagic;
+    }
+};
+
+} // namespace deep_gemm::sm90_timeline
