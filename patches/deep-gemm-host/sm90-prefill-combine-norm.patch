+// fp8_mega_moe plus the next layer's input add-RMSNorm in the combine (EP1 lean Prefill only):
+// residual (BF16 [num_tokens, hidden], in place) takes the place of y and becomes residual + y;
+// q (FP8 [num_tokens, hidden]) and scale (FP32 [num_tokens, hidden / 128], column-major with a
+// row stride that is a multiple of 4) receive the per-128-column-group quant of
+// RMSNorm(residual + y) * norm_weight, as add_rmsnorm_group_quant_fp8 writes them.
+void dg_fp8_mega_moe_norm(TensorView residual, TensorView l1_weights, TensorView l1_weights_sf, TensorView l2_weights, TensorView l2_weights_sf,
+                          Optional<TensorView> cumulative_local_expert_recv_stats, TensorView sym_buffer, Array<int64_t> sym_buffer_ptrs,
+                          int64_t rank_idx, int64_t num_max_tokens_per_rank, int64_t num_experts, int64_t num_topk,
+                          Tuple<int64_t, int64_t, int64_t> recipe, std::string activation, Optional<double> activation_clamp_opt, bool fast_math,
+                          TensorView norm_weight, double eps, TensorView q, TensorView scale) {
+    const auto residual_t = convert_to_torch_tensor(residual);
+    const auto weight_t = convert_to_torch_tensor(norm_weight);
+    const auto q_t = convert_to_torch_tensor(q);
+    const auto scale_t = convert_to_torch_tensor(scale);
+    const auto num_tokens = residual_t.size(0), hidden = residual_t.size(1);
+    DG_HOST_ASSERT(residual_t.scalar_type() == torch::kBFloat16 and residual_t.dim() == 2 and residual_t.is_contiguous());
+    DG_HOST_ASSERT(weight_t.scalar_type() == torch::kBFloat16 and weight_t.dim() == 1 and weight_t.size(0) == hidden and weight_t.is_contiguous());
+    DG_HOST_ASSERT(q_t.scalar_type() == torch::kFloat8_e4m3fn and q_t.sizes() == residual_t.sizes() and q_t.is_contiguous());
+    DG_HOST_ASSERT(scale_t.scalar_type() == torch::kFloat and scale_t.dim() == 2 and scale_t.size(0) == num_tokens and scale_t.size(1) == hidden / 128);
+    DG_HOST_ASSERT(scale_t.stride(0) == 1 and scale_t.stride(1) >= num_tokens and scale_t.stride(1) % 4 == 0);
+    auto c_val = cumulative_local_expert_recv_stats.has_value()? std::optional<torch::Tensor>(convert_to_torch_tensor(cumulative_local_expert_recv_stats.value())) : std::nullopt;
+    auto act_clamp_opt_val = activation_clamp_opt.has_value()? std::optional<float>(static_cast<float>(activation_clamp_opt.value())) : std::nullopt;
+    std::vector<int64_t> sym_buffer_ptrs_val;
+    for (Array<int64_t>::iterator it = sym_buffer_ptrs.begin(); it != sym_buffer_ptrs.end(); ++it)
+        sym_buffer_ptrs_val.push_back(*it);
+    auto [recipe_a, recipe_b, recipe_c] = recipe;
+    const auto norm = SM90PrefillCombineNorm{weight_t.data_ptr(), q_t.data_ptr(), scale_t.data_ptr<float>(), scale_t.stride(1), static_cast<float>(eps)};
+    mega::fp8_mega_moe(
+        residual_t,
+        std::make_pair(convert_to_torch_tensor(l1_weights), convert_to_torch_tensor(l1_weights_sf)),
+        std::make_pair(convert_to_torch_tensor(l2_weights), convert_to_torch_tensor(l2_weights_sf)),
+        c_val, convert_to_torch_tensor(sym_buffer), sym_buffer_ptrs_val, static_cast<int>(rank_idx),
+        static_cast<int>(num_max_tokens_per_rank), static_cast<int>(num_experts),
+        static_cast<int>(num_topk), std::make_tuple(static_cast<int>(recipe_a), static_cast<int>(recipe_b), static_cast<int>(recipe_c)),
+        activation, act_clamp_opt_val, fast_math, norm
+    );
+}
