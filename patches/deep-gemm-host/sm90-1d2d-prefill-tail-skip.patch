+// Per-call selection, so stock and candidate coexist in one process/cache.
+static bool get_sm90_1d2d_prefill_tail_skip(const GemmDesc& desc, const GemmConfig& config) {
+    const bool enabled = get_env<int>("DG_SM90_1D2D_PREFILL_TAIL_SKIP", 0) != 0;
+    const bool selected = enabled and desc.gemm_type == GemmType::Normal and
+        desc.m > 192 and config.layout.block_m == 256 and desc.m % 256 != 0 and
+        ((desc.n == 9216 and desc.k == 4096) or (desc.n == 4096 and desc.k == 8192));
+    if (enabled and (get_env<int>("DG_PRINT_CONFIGS") or get_env<int>("DG_JIT_DEBUG"))) {
+        static std::unordered_set<std::string> printed;
+        const auto key = std::to_string(desc.m) + "/" + std::to_string(desc.n) + "/" + std::to_string(selected);
+        if (printed.insert(key).second)
+            std::cout << "DG_SM90_1D2D_PREFILL_TAIL_SKIP=" << selected << ": " << desc << ": " << config << std::endl;
+    }
+    return selected;
+}
