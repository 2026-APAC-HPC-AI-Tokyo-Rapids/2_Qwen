#!/usr/bin/env bash
#PJM -L rscgrp=b-batch
#PJM -L elapse=00:10:00
#PJM -L node=2
#PJM --mpi proc=2

# Run the Qwen 3.5 benchmark across two Genkai compute nodes.
set -euo pipefail

: "${RUNTIME_DIR:?RUNTIME_DIR is required}"
: "${MODEL_PATH:?MODEL_PATH is required}"
: "${DATASET_PATH:?DATASET_PATH is required}"
: "${PJM_JOBID:?PJM_JOBID is required}"
: "${EXPERIMENT_METRICS_GOOGLE_CREDENTIALS_BASE64:?}"

METRICS_CREDENTIALS_BASE64="${EXPERIMENT_METRICS_GOOGLE_CREDENTIALS_BASE64}"
unset EXPERIMENT_METRICS_GOOGLE_CREDENTIALS_BASE64
EXPERIMENT_METRICS_CLI="${RUNTIME_DIR}/qwen-experiment-metrics/.venv/bin/qwen-experiment-metrics"
PIPELINE_STARTED_SECONDS=${SECONDS}

metrics_cli() {
  EXPERIMENT_METRICS_GOOGLE_CREDENTIALS_BASE64="${METRICS_CREDENTIALS_BASE64}" \
    "${EXPERIMENT_METRICS_CLI}" "$@"
}

metrics_collect() {
  local collector=$1
  shift
  metrics_cli collect "${collector}" --runtime-dir "${RUNTIME_DIR}" "$@" || true
}

workflow_run_id="${GITHUB_RUN_ID:-manual}"
git_sha="${GITHUB_SHA:-unknown}"

cleanup() {
  local status=$?
  trap - EXIT INT TERM
  metrics_collect run-end --exit-code "${status}" --elapsed-sec "$((SECONDS - PIPELINE_STARTED_SECONDS))"
  exit "${status}"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

cd "${RUNTIME_DIR}"
mkdir -p results "${HOME}/.cache/sglang-jit"
sif_source_run_number="$(cat sif-source-run.txt 2>/dev/null || printf 'unknown')"

module purge
module load nvidia/25.11
module load nvhpcx/2.25.1-cuda13.0
module load cuda/13.2.0
module load singularity-ce/4.1.3
sglang_commit="$(singularity exec sglang.sif cat /opt/sglang/sglang-commit.txt 2>/dev/null || printf 'unknown')"

{
  echo "job_id=${PJM_JOBID:-unknown}"
  echo "workflow_run_id=${workflow_run_id}"
  echo "git_sha=${git_sha}"
  echo "sif_source_run_number=${sif_source_run_number}"
  echo "started_at=$(date -u +%FT%TZ)"
  echo "model_path=${MODEL_PATH}"
  echo "dataset_path=${DATASET_PATH}"
  echo "sglang_commit=${sglang_commit}"
  echo "runtime_dir=${RUNTIME_DIR}"
  singularity inspect sglang.sif
  singularity sif list sglang.sif
  module list 2>&1
  nvidia-smi --query-gpu=index,name,uuid,memory.total,driver_version --format=csv
  singularity --version
} >results/environment.log 2>&1

command=(mpirun -n 2 --map-by ppr:1:node "${RUNTIME_DIR}/scripts/run-qwen35-node.sh")

metrics_collect run-start --command "${command[@]}"
metrics_collect platform
metrics_collect source
PIPELINE_STARTED_SECONDS=${SECONDS}

{
  printf 'command='
  printf '%q ' "${command[@]}"
  printf '\n'
} >results/throughput.log

set +e
metrics_cli stage \
  --socket-dir "${RUNTIME_DIR}/metrics-socket" \
  --node-gpu-dir "${RUNTIME_DIR}/results" \
  benchmark -- \
  scripts/exec-profiler.sh "${command[@]}" 2>&1 | tee -a results/throughput.log
status=${PIPESTATUS[0]}
set -e
printf 'exit_code=%d\n' "${status}" | tee -a results/throughput.log
echo "finished_at=$(date -u +%FT%TZ)" >>results/environment.log
metrics_collect artifact

if [[ "${status}" -eq 0 ]]; then
  test -s results/results.jsonl
  touch run-success
fi
exit "${status}"
