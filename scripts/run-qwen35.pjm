#!/usr/bin/env bash
#PJM -L rscgrp=b-batch
#PJM -L elapse=00:45:00
#PJM -L node=2
#PJM -L jobenv=singularity
#PJM --mpi proc=2

# Compute-side execution is local-only: no credentials, HTTP clients, upload,
# merge, or BigQuery publication are permitted in this script.
set -euo pipefail

: "${RUNTIME_DIR:?RUNTIME_DIR is required}"
: "${MODEL_PATH:?MODEL_PATH is required}"
: "${DATASET_PATH:?DATASET_PATH is required}"
: "${PJM_JOBID:?PJM_JOBID is required}"

cd "${RUNTIME_DIR}"
metrics_cli="${RUNTIME_DIR}/qwen-experiment-metrics/.venv/bin/qwen-experiment-metrics"
manifest="${RUNTIME_DIR}/control/run-manifest.json"
execution_settings="${RUNTIME_DIR}/control/execution-settings.json"
test -s "${manifest}"
test -s "${execution_settings}"
[[ "$(jq -er '.run_purpose' "${execution_settings}")" == "$(jq -er '.run_purpose' "${manifest}")" ]]
mkdir -p logs results source/network/imb-mpi1 source/network/nccl-tests
mpi_processes="$(jq -er '.mpi_processes' "${execution_settings}")"
gpus_per_node="$(jq -er '.gpus_per_node' "${execution_settings}")"
[[ "$(jq -er '.nodes' "${execution_settings}")" -eq 2 ]]
[[ "${mpi_processes}" -eq 2 ]]
[[ "$(jq -er '.resource_group' "${execution_settings}")" == b-batch ]]

# Capture the scheduler-side identity at the first PJM boundary, before module
# operations mutate the job-entry environment.  This source is immutable for the
# run; submission/accounting equality remains a runner-side validation.
job_entry="${RUNTIME_DIR}/control/job-entry.json"
job_entry_tmp="${job_entry}.tmp-${BASHPID}"
test ! -e "${job_entry}"
jq -n \
  --arg run_id "$(jq -er '.run_id' "${manifest}")" \
  --arg pj_job_id "${PJM_JOBID}" \
  --arg entered_at "$(date -u +%FT%TZ)" \
  '{schema_version:"job-entry/v1",run_id:$run_id,pj_job_id:$pj_job_id,entered_at:$entered_at}' \
  >"${job_entry_tmp}"
mv -- "${job_entry_tmp}" "${job_entry}"
"${metrics_cli}" record-job-entry \
  --manifest "${manifest}" \
  --runtime-dir "${RUNTIME_DIR}"
"${metrics_cli}" record-environment \
  --manifest "${manifest}" \
  --runtime-dir "${RUNTIME_DIR}" \
  --scope job-entry
"${metrics_cli}" start-run-lifecycle \
  --manifest "${manifest}" \
  --runtime-dir "${RUNTIME_DIR}"

finish_run_lifecycle() {
  local status=$?
  trap - EXIT
  set +e
  "${metrics_cli}" finish-run-lifecycle \
    --manifest "${manifest}" \
    --runtime-dir "${RUNTIME_DIR}" \
    --exit-code "${status}"
  local lifecycle_status=$?
  set -e
  if [[ "${lifecycle_status}" -ne 0 ]]; then
    exit "${lifecycle_status}"
  fi
  exit "${status}"
}
trap finish_run_lifecycle EXIT

module purge
module load nvidia/25.11
module load nvhpcx/2.25.1-cuda13.0
module load cuda/13.2.0
module load singularity-ce/4.1.3
"${metrics_cli}" capture-runtime-launchers --runtime-dir "${RUNTIME_DIR}"
mpirun_launcher="$(jq -er '.executables[] | select(.role == "mpirun") | .requested_path' source/runtime-launchers.json)"
export SINGULARITY_LAUNCHER
SINGULARITY_LAUNCHER="$(jq -er '.executables[] | select(.role == "singularity") | .requested_path' source/runtime-launchers.json)"

{
  echo "job_id=${PJM_JOBID}"
  echo "started_at=$(date -u +%FT%TZ)"
  module list 2>&1
  nvidia-smi --query-gpu=index,name,uuid,memory.total,driver_version --format=csv
  "${SINGULARITY_LAUNCHER}" --version
  "${SINGULARITY_LAUNCHER}" inspect sglang.sif
  "${SINGULARITY_LAUNCHER}" sif list sglang.sif
} >logs/environment.log 2>&1

benchmark_command=("${mpirun_launcher}" -n "${mpi_processes}" --map-by ppr:1:node --bind-to none "${RUNTIME_DIR}/scripts/run-qwen35-node.sh")
set +e
"${metrics_cli}" run-stage \
  --manifest "${manifest}" \
  --runtime-dir "${RUNTIME_DIR}" \
  --name benchmark \
  --cwd "${RUNTIME_DIR}" \
  --stderr-mode stdout \
  --stdout-path "${RUNTIME_DIR}/logs/benchmark.log" \
  -- "${benchmark_command[@]}"
benchmark_status=$?
set -e
printf 'exit_code=%d\n' "${benchmark_status}" >>logs/benchmark.log

run_capture_stage() {
  local stage_name=$1
  local artifact_dir=$2
  shift 2
  local argv=("$@")
  mkdir -p "${artifact_dir}"
  jq -n --args '$ARGS.positional' -- "${argv[@]}" >"${artifact_dir}/argv.json"
  : >"${artifact_dir}/stderr.txt"
  set +e
  "${metrics_cli}" run-stage \
    --manifest "${manifest}" \
    --runtime-dir "${RUNTIME_DIR}" \
    --name "${stage_name}" \
    --cwd "${RUNTIME_DIR}" \
    --stderr-mode stdout \
    --stdout-path "${artifact_dir}/stdout.txt" \
    -- "${argv[@]}"
  local status=$?
  set -e
  return "${status}"
}

if [[ "${benchmark_status}" -eq 0 && -s source/primary-result.json ]]; then
  nccl_tests_commit="$("${SINGULARITY_LAUNCHER}" exec sglang.sif cat /opt/sglang/nccl-tests-commit.txt 2>/dev/null | tr -d '[:space:]')"
  jq -n \
    --arg commit "${nccl_tests_commit}" \
    '{schema_version:"nccl-tests-sidecar/v1",commit:$commit}' \
    >source/network/nccl-tests/sidecar.json
  imb_dir="${RUNTIME_DIR}/source/network/imb-mpi1"
  imb_command=("${mpirun_launcher}" -n "${mpi_processes}" --map-by ppr:1:node --bind-to none IMB-MPI1
    -npmin "${mpi_processes}" -msglog 0:22 -iter 1000 -time 1 -iter_policy dynamic
    PingPong Sendrecv Allreduce)
  run_capture_stage network_imb_mpi1 "${imb_dir}" "${imb_command[@]}" || true

  for collective in all_reduce all_gather reduce_scatter; do
    nccl_dir="${RUNTIME_DIR}/source/network/nccl-tests/${collective}"
    mkdir -p "${nccl_dir}"
    nccl_command=("${mpirun_launcher}" -n "${mpi_processes}" --map-by ppr:1:node --bind-to none
      "${SINGULARITY_LAUNCHER}" exec --userns --nv --cleanenv --containall
      --bind "${nccl_dir}:/network"
      "${RUNTIME_DIR}/sglang.sif" "/opt/nccl-tests/bin/${collective}_perf"
      -b 8 -e 1G -f 2 -w 5 -n 20 -m 1 -N 1 -d float -c 1 -a 1 -T 300
      -g "${gpus_per_node}" -J /network/result.json)
    run_capture_stage "network_nccl_${collective}" "${nccl_dir}" "${nccl_command[@]}" || true
  done

  imb_version="$(sed -n '1{s/^[#[:space:]]*//;p;q;}' "${imb_dir}/stdout.txt")"
  "${metrics_cli}" record-network \
    --manifest "${manifest}" \
    --runtime-dir "${RUNTIME_DIR}" \
    --imb-stdout "${imb_dir}/stdout.txt" \
    --imb-version "${imb_version:-unknown}" \
    --nccl-all-reduce "${RUNTIME_DIR}/source/network/nccl-tests/all_reduce/result.json" \
    --nccl-all-gather "${RUNTIME_DIR}/source/network/nccl-tests/all_gather/result.json" \
    --nccl-reduce-scatter "${RUNTIME_DIR}/source/network/nccl-tests/reduce_scatter/result.json" \
    --nccl-tests-commit "${nccl_tests_commit:-unknown}" \
    --expected-mpi-processes "${mpi_processes}" \
    --expected-gpus-per-process "${gpus_per_node}" || true
fi

echo "finished_at=$(date -u +%FT%TZ)" >>logs/environment.log
if [[ "${benchmark_status}" -eq 0 ]]; then
  test -s source/primary-result.json
  touch run-success
fi
exit "${benchmark_status}"
