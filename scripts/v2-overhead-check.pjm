#!/usr/bin/env bash
#PJM -L rscgrp=b-batch
#PJM -L elapse=02:30:00
#PJM -L node=2
#PJM -L jobenv=singularity
#PJM --mpi proc=2

set -euo pipefail

: "${CHECK_DIR:?}"
: "${MODEL_PATH:?}"
: "${DATASET_PATH:?}"
: "${PJM_JOBID:?}"

cd "${CHECK_DIR}"
module purge
module load nvidia/25.11
module load nvhpcx/2.25.1-cuda13.0
module load cuda/13.2.0
module load singularity-ce/4.1.3

DATASET_SHA256="$(sha256sum "${DATASET_PATH}" | awk '{ print $1 }')"
export DATASET_SHA256

metrics_cli="${CHECK_DIR}/qwen-experiment-metrics/.venv/bin/qwen-experiment-metrics"
test -x "${metrics_cli}"
printf -v smoke_run_id 'r-%032x' "${PJM_JOBID}"
"${metrics_cli}" smoke-send --run "${smoke_run_id}" --source compute

run_arm() {
  local trial=$1
  local arm=$2
  local trial_dir="${CHECK_DIR}/trial-${trial}-${arm}"
  local started ended
  install -d "${trial_dir}/source" "${trial_dir}/control"
  started="$(date +%s%N)"
  mpirun -n 2 --map-by ppr:1:node --bind-to none \
    "${CHECK_DIR}/scripts/v2-overhead-node.sh" "${arm}" "${trial}" \
    >"${CHECK_DIR}/logs/trial-${trial}-${arm}.benchmark.log" 2>&1
  ended="$(date +%s%N)"
  awk -v delta="$((ended - started))" \
    'BEGIN { printf "%.9f\n", delta / 1000000000 }' \
    >"${trial_dir}/stage-wall-sec"
  test -s "${trial_dir}/source/primary-result.json"
  test -s "${trial_dir}/source/workload-warmup.json"
  test -s "${trial_dir}/source/workload-measured.json"
}

arms=(off on off on)
printf '%s\n' "${arms[@]}" >"${CHECK_DIR}/comparison-order.txt"
for trial in "${!arms[@]}"; do
  run_arm "${trial}" "${arms[trial]}"
done

reference_identity=""
reference_counts=""
reference_workload_identity=""
: >"${CHECK_DIR}/observations.tsv"
for trial in "${!arms[@]}"; do
  arm="${arms[trial]}"
  trial_dir="${CHECK_DIR}/trial-${trial}-${arm}"
  result="${trial_dir}/source/primary-result.json"
  jq -e \
    '.schema_version == "primary-result/v1" and
     .invocation_id == "measured-generation" and
     (.generation_wall_sec | tostring | test("^[0-9]+([.][0-9]+)?$")) and
     .returned_count == 32 and .error_count == 0 and
     .observed_input_tokens > 0 and .observed_output_tokens > 0 and
     (.ordered_output_token_ids_sha256 | strings | test("^[0-9a-f]{64}$"))' \
    "${result}" >/dev/null
  identity="$(jq -er '.ordered_output_token_ids_sha256' "${result}")"
  counts="$(jq -c '[.returned_count,.error_count,.observed_input_tokens,.observed_output_tokens]' "${result}")"
  workload_identity="$({
    sha256sum "${trial_dir}/source/workload-warmup.json" | awk '{ print $1 }'
    sha256sum "${trial_dir}/source/workload-measured.json" | awk '{ print $1 }'
  } | sha256sum | awk '{ print $1 }')"
  if [[ -z "${reference_identity}" ]]; then
    reference_identity="${identity}"
    reference_counts="${counts}"
    reference_workload_identity="${workload_identity}"
  else
    test "${identity}" = "${reference_identity}"
    test "${counts}" = "${reference_counts}"
    test "${workload_identity}" = "${reference_workload_identity}"
  fi
  if [[ "${arm}" == on ]]; then
    printf -v run_id 'r-%032x' "$((trial + 2))"
    jq -e --arg run_id "${run_id}" \
      '.schema_version == "overhead-event-summary/v2" and
       .run_id == $run_id and .node_rank == 0 and .total_events == 7 and
       .event_type_counts == {
         "bench_args_effective":1,"primary_result":1,
         "server_args_effective":1,"worker_ready":4
       } and .total_payload_bytes > 0' \
      "${trial_dir}/event-summary-node-0.json" >/dev/null
    jq -e --arg run_id "${run_id}" \
      '.schema_version == "overhead-event-summary/v2" and
       .run_id == $run_id and .node_rank == 1 and .total_events == 6 and
       .event_type_counts == {
         "bench_args_effective":1,"server_args_effective":1,"worker_ready":4
       } and .total_payload_bytes > 0' \
      "${trial_dir}/event-summary-node-1.json" >/dev/null
    test "$(find "${trial_dir}/domain/fragments" -maxdepth 1 -type f -name 'producer--*.jsonl' | wc -l)" -eq 11
    producer_finalize_wall="$(awk '
      NR == 1 || $1 > maximum { maximum = $1 }
      END { printf "%.9f", maximum }
    ' "${trial_dir}"/producer-finalize-wall-sec-node-*)"
  else
    test ! -e "${trial_dir}/event-summary-node-0.json"
    test ! -e "${trial_dir}/event-summary-node-1.json"
    test ! -e "${trial_dir}/domain/fragments"
    producer_finalize_wall="0.000000000"
  fi
  generation_wall="$(jq -er '.generation_wall_sec' "${result}")"
  output_tokens="$(jq -er '.observed_output_tokens' "${result}")"
  throughput="$(awk -v tokens="${output_tokens}" -v wall="${generation_wall}" \
    'BEGIN { printf "%.9f", tokens / wall }')"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "${trial}" "${arm}" \
    "${generation_wall}" \
    "$(<"${trial_dir}/stage-wall-sec")" \
    "${throughput}" \
    "${producer_finalize_wall}" \
    >>"${CHECK_DIR}/observations.tsv"
done

read -r off_generation_mean on_generation_mean generation_ratio \
  off_stage_mean on_stage_mean stage_ratio \
  off_throughput_mean on_throughput_mean throughput_ratio \
  on_producer_finalize_mean < <(
    awk -F '\t' '
      $2 == "off" { off_generation += $3; off_stage += $4; off_throughput += $5; off_count += 1 }
      $2 == "on" { on_generation += $3; on_stage += $4; on_throughput += $5; on_finalize += $6; on_count += 1 }
      END {
        if (off_count != 2 || on_count != 2) exit 1
        off_generation /= off_count
        on_generation /= on_count
        off_stage /= off_count
        on_stage /= on_count
        off_throughput /= off_count
        on_throughput /= on_count
        on_finalize /= on_count
        printf "%.9f %.9f %.9f %.9f %.9f %.9f %.9f %.9f %.9f %.9f\n",
          off_generation, on_generation, on_generation / off_generation,
          off_stage, on_stage, on_stage / off_stage,
          off_throughput, on_throughput, on_throughput / off_throughput,
          on_finalize
      }' "${CHECK_DIR}/observations.tsv"
  )

jq -n \
  --arg off_generation_wall_sec_mean "${off_generation_mean}" \
  --arg on_generation_wall_sec_mean "${on_generation_mean}" \
  --arg on_over_off_generation_ratio "${generation_ratio}" \
  --arg off_stage_wall_sec_mean "${off_stage_mean}" \
  --arg on_stage_wall_sec_mean "${on_stage_mean}" \
  --arg on_over_off_stage_ratio "${stage_ratio}" \
  --arg off_throughput_tokens_per_sec_mean "${off_throughput_mean}" \
  --arg on_throughput_tokens_per_sec_mean "${on_throughput_mean}" \
  --arg on_over_off_throughput_ratio "${throughput_ratio}" \
  --arg on_producer_finalize_wall_sec_mean "${on_producer_finalize_mean}" \
  --arg ordered_output_token_ids_sha256 "${reference_identity}" \
  --arg workload_identity_sha256 "${reference_workload_identity}" \
  '{
    schema_version:"qwen-v2-overhead-summary/v1",
    order:["off","on","off","on"],
    repeats_per_arm:2,
    differential_under_test:"v2 event collection, atomic fragments, and direct BigQuery send",
    common_source_writers_enabled:true,
    primary_measure:"generation_wall_sec",
    max_overhead_ratio:"1.05",
    off_generation_wall_sec_mean:$off_generation_wall_sec_mean,
    on_generation_wall_sec_mean:$on_generation_wall_sec_mean,
    on_over_off_generation_ratio:$on_over_off_generation_ratio,
    off_stage_wall_sec_mean:$off_stage_wall_sec_mean,
    on_stage_wall_sec_mean:$on_stage_wall_sec_mean,
    on_over_off_stage_ratio:$on_over_off_stage_ratio,
    off_throughput_tokens_per_sec_mean:$off_throughput_tokens_per_sec_mean,
    on_throughput_tokens_per_sec_mean:$on_throughput_tokens_per_sec_mean,
    on_over_off_throughput_ratio:$on_over_off_throughput_ratio,
    on_producer_finalize_wall_sec_mean:$on_producer_finalize_wall_sec_mean,
    ordered_output_identity_equal:true,
    ordered_output_token_ids_sha256:$ordered_output_token_ids_sha256,
    workload_identity_equal:true,
    workload_identity_sha256:$workload_identity_sha256,
    gate_passed:(($on_over_off_generation_ratio | tonumber) <= 1.05)
  }' >"${CHECK_DIR}/summary.json"
jq -r 'to_entries[] | "\(.key)=\(.value | if type == "array" then join(",") else tostring end)"' \
  "${CHECK_DIR}/summary.json" >"${CHECK_DIR}/summary.txt"
jq -e '.gate_passed == true' "${CHECK_DIR}/summary.json" >/dev/null
