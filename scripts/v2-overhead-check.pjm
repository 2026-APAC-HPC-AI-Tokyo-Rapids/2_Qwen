#!/usr/bin/env bash
#PJM -L rscgrp=b-batch
#PJM -L elapse=01:15:00
#PJM -L node=2
#PJM --mpi proc=2

set -euo pipefail

: "${CHECK_DIR:?}"
: "${MODEL_PATH:?}"
: "${DATASET_PATH:?}"
: "${PJM_JOBID:?}"

cd "${CHECK_DIR}"
module purge
module load nvidia/25.11
module load nvhpcx/2.25.1-cuda13.0
module load cuda/13.2.0
module load singularity-ce/4.1.3

run_arm() {
  local arm=$1
  local started ended
  install -d "${CHECK_DIR}/${arm}/source" "${CHECK_DIR}/${arm}/control"
  started="$(date +%s%N)"
  mpirun -n 2 --map-by ppr:1:node --bind-to none \
    "${CHECK_DIR}/scripts/v2-overhead-node.sh" "${arm}" \
    >"${CHECK_DIR}/logs/${arm}.benchmark.log" 2>&1
  ended="$(date +%s%N)"
  awk -v delta="$((ended - started))" 'BEGIN { printf "%.9f\n", delta / 1000000000 }' \
    >"${CHECK_DIR}/${arm}/stage-wall-sec"
  test -s "${CHECK_DIR}/${arm}/source/primary-result.json"
}

run_arm off
run_arm on

off_result="${CHECK_DIR}/off/source/primary-result.json"
on_result="${CHECK_DIR}/on/source/primary-result.json"
jq -e '.schema_version == "primary-result/v1" and .ordered_output_token_ids_sha256 != null' \
  "${off_result}" "${on_result}" >/dev/null

off_hash="$(jq -er '.ordered_output_token_ids_sha256' "${off_result}")"
on_hash="$(jq -er '.ordered_output_token_ids_sha256' "${on_result}")"
test "${off_hash}" = "${on_hash}"
for key in returned_count error_count observed_input_tokens observed_output_tokens; do
  test "$(jq -er ".${key}" "${off_result}")" = "$(jq -er ".${key}" "${on_result}")"
done

off_generation="$(jq -er '.generation_wall_sec' "${off_result}")"
on_generation="$(jq -er '.generation_wall_sec' "${on_result}")"
output_tokens="$(jq -er '.observed_output_tokens' "${off_result}")"
off_throughput="$(awk -v tokens="${output_tokens}" -v wall="${off_generation}" 'BEGIN { printf "%.9f", tokens / wall }')"
on_throughput="$(awk -v tokens="${output_tokens}" -v wall="${on_generation}" 'BEGIN { printf "%.9f", tokens / wall }')"
generation_ratio="$(awk -v off="${off_generation}" -v on="${on_generation}" 'BEGIN { printf "%.9f", on / off }')"
off_stage="$(<"${CHECK_DIR}/off/stage-wall-sec")"
on_stage="$(<"${CHECK_DIR}/on/stage-wall-sec")"
stage_ratio="$(awk -v off="${off_stage}" -v on="${on_stage}" 'BEGIN { printf "%.9f", on / off }')"

{
  printf 'off_generation_wall_sec=%s\n' "${off_generation}"
  printf 'on_generation_wall_sec=%s\n' "${on_generation}"
  printf 'on_over_off_generation_ratio=%s\n' "${generation_ratio}"
  printf 'off_output_tokens_per_sec=%s\n' "${off_throughput}"
  printf 'on_output_tokens_per_sec=%s\n' "${on_throughput}"
  printf 'off_stage_wall_sec=%s\n' "${off_stage}"
  printf 'on_stage_wall_sec=%s\n' "${on_stage}"
  printf 'on_over_off_stage_ratio=%s\n' "${stage_ratio}"
  printf 'ordered_output_identity_equal=true\n'
  printf 'ordered_output_token_ids_sha256=%s\n' "${off_hash}"
} >"${CHECK_DIR}/summary.txt"

awk -v ratio="${generation_ratio}" 'BEGIN { exit !(ratio <= 1.05) }'
